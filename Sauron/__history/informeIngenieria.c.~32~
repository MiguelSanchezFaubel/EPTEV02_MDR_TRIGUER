void muestraRegCont(){

    int8 i8ContIndiceTexto=0; 
    int16 i16ContEEPROM=0;
    
    funcionSaltoLinea();
    representarTextoUART(sINFORME_INGENIERIA);
    funcionSaltoLinea();
    representarTextoUART(sASTERISCOS);
    funcionSaltoLinea();
    funcionSaltoLinea();
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
    representarTextoUART(sLEYENDA_INFORME_INGENIERIA);
    funcionSaltoLinea();
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
    
    representarTextoUART(sINF_ING_CICLOS_BAT);
    fprintf(DEBUG_UART,"%lu\r\n",getCycleCount());
    
    for(i8ContIndiceTexto=sINF_ING_VECES_ON, i16ContEEPROM=REG_VECES_ENCENDIDO; i16ContEEPROM<REG_TRAT_SMP; i8ContIndiceTexto++, i16ContEEPROM+=2){
        representarTextoUART(i8ContIndiceTexto);   
        fprintf(DEBUG_UART,"%lu         %lu\r\n",make16(read_eeprom(i16ContEEPROM),read_eeprom(i16ContEEPROM+1))
                                                                        ,make16(read_eeprom(i16ContEEPROM+i8OffsetContParcial),read_eeprom(i16ContEEPROM+i8OffsetContParcial+1)));     
    }
    
    for(i8ContIndiceTexto=sINF_ING_TIEMPO_CANAL_A, i16ContEEPROM=REG_TIEMPO_CHA; i16ContEEPROM<REG_TIEMPO_CHC; i8ContIndiceTexto++, i16ContEEPROM+=4){
        representarTextoUART(i8ContIndiceTexto);                                                                   
        fprintf(DEBUG_UART,"%5.1f     %5.1f     min\r\n"  ,make32(read_eeprom(i16ContEEPROM),read_eeprom(i16ContEEPROM+1),read_eeprom(i16ContEEPROM+2),read_eeprom(i16ContEEPROM+3))/60.0
                                                                        ,make32(read_eeprom(i16ContEEPROM+i8OffsetContParcial),read_eeprom(i16ContEEPROM+i8OffsetContParcial+1),read_eeprom(i16ContEEPROM+i8OffsetContParcial+2),read_eeprom(i16ContEEPROM+i8OffsetContParcial+3))/60.0);
    }
                                                                
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
}

void refreshRegError(){
    for(int8 i8Registro=0; i8Registro<REG_ERROR_MAX; i8Registro++){
        write_eeprom(i8Registro,read_eeprom(i8Registro));    // Lee el valor del registro y incrementa el valor, luego lo vuelve a guardar
        pausa_ms(DELAY_ESCRITURA_EEPROM);
        write_eeprom(i8Registro+i8OffsetErrorParcial,read_eeprom(i8Registro+i8OffsetErrorParcial));
        pausa_ms(DELAY_ESCRITURA_EEPROM);
    }
}

void refreshRegCont(){
    for(int8 i8Registro=REG_TRAT_CHA; i8Registro<REG_CONT_MAX; i8Registro++){
        write_eeprom(i8Registro,read_eeprom(i8Registro));    // Lee el valor del registro y incrementa el valor, luego lo vuelve a guardar
        pausa_ms(DELAY_ESCRITURA_EEPROM);
        write_eeprom(i8Registro+i8OffsetContParcial,read_eeprom(i8Registro+i8OffsetContParcial));
        pausa_ms(DELAY_ESCRITURA_EEPROM);
    }
}

void informeIngenieria(){
    muestraRegCont();
    muestraRegError();
}
