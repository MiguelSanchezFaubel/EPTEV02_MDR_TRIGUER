#include "informeIngenieria.h"

/*
*   Función: initRegError(int1 bSeleccion)
*   Descripción: Inicializa el estado de los registros de error,
*                   ya sea el registro parcial o general
*
*   Input:
*         - int1 bSeleccion - 0 - General
*                           - 1 - Parcial
*   Output:
*         - 
*/
void initRegError(int1 bSeleccion){
    for(int8 i8Registro=i8OffsetErrorParcial*bSeleccion; i8Registro<(REG_ERROR_MAX+i8OffsetErrorParcial*bSeleccion); i8Registro++){     // Recorre todas las posiciones de los errores definicdos
        write_eeprom(i8Registro,0x00);                                      // Inicializa elcontador de errores de los registros
        pausa_I(DELAY_ESCRITURA_EEPROM);                                    // Pequeño delay de espea para ecritura
    }
}

/*
*   Función: initRegCont(int1 bSeleccion)
*   Descripción: Inicializa el estado de los registros de contadores,
*                   ya sea el registro parcial o general
*
*   Input:
*         - int1 bSeleccion - 0 - General
*                           - 1 - Parcial
*   Output:
*         - 
*/
void initRegCont(int1 bSeleccion){
    for(int8 i8Registro=REG_TRAT_CHA+i8OffsetContParcial*bSeleccion; i8Registro<(REG_CONT_MAX+i8OffsetContParcial*bSeleccion); i8Registro++){   // Recorre todas las posiciones de los errores definicdos
        write_eeprom(i8Registro,0x00);                                      // Inicializa elcontador de errores de los registros
        pausa_I(DELAY_ESCRITURA_EEPROM);                                    // Pequeño delay de espea para ecritura
    }
}

/*
*   Función: initRegistros()
*   Descripción: Inicializa el estado de los registros de contadores y errores
*
*   Input:
*         - 
*   Output:
*         - 
*/
void initRegistros(){
    // Registros generales 
    initRegError(GENERAL);
    initRegCont(GENERAL);
    
    // Registros parciales
    initRegError(PARCIAL);
    initRegCont(PARCIAL);
}

/*
*   Función: incRegError(int8 i8Registro)
*   Descripción: Incrementa el registor de error correspondiente al registro seleccionado para incrementar
*
*   Input: 
*         - int8 i8Registro - Indica el registro en el que se quiere incrementar el registor de error
*   Output:
*         - 
*/
void incRegError(int8 i8Registro){
    write_eeprom(i8Registro,read_eeprom(i8Registro)+1);    // Lee el valor del registro y incrementa el valor, luego lo vuelve a guardar
    pausa_I(DELAY_ESCRITURA_EEPROM);
    write_eeprom(i8Registro+i8OffsetErrorParcial,read_eeprom(i8Registro+i8OffsetErrorParcial)+1);
    pausa_I(DELAY_ESCRITURA_EEPROM);
}

/*
*   Función: incRegCont(int8 i8Registro)
*   Descripción: Incrementa el registor de contadores correspondiente al registro seleccionado para incrementar
*
*   Input: 
*         - int8 i8Registro - Indica el registro en el que se quiere incrementar el registor de contadores
*   Output:
*         - 
*/
void incRegCont(int8 i8Registro){
    
    int16 i16Raw;                                                       // Variable auxiliar para los contadores (16 bits)

    // General
    i16Raw=make16(read_eeprom(i8Registro),read_eeprom(i8Registro+1));   // Obtengo el valor del registro general
    i16Raw++;                                                           // Lo incremento
    
    write_eeprom(i8Registro,make8(i16Raw,1));                           // Escribo MSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    write_eeprom(i8Registro+1,make8(i16Raw,0));                         // Escribo LSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    
    // Parcial
    i16Raw=make16(read_eeprom(i8Registro+i8OffsetContParcial),read_eeprom(i8Registro+i8OffsetContParcial+1));       // Obtengo el valor del registro parcial
    i16Raw++;                                                           // Lo incremento
    
    write_eeprom(i8Registro+i8OffsetContParcial,make8(i16Raw,1));       // Escribo MSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    write_eeprom(i8Registro+i8OffsetContParcial+1,make8(i16Raw,0));     // Escribo LSB
    pausa_I(DELAY_ESCRITURA_EEPROM); 
}

/*
*   Función: incRegTiempo(int8 i8Registro)
*   Descripción: Incrementa el registor de tiempo correspondiente al registro seleccionado para incrementar
*
*   Input: 
*         - int8 i8Registro - Indica el registro en el que se quiere incrementar el registor de tiempo
*   Output:
*         - 
*/
void incRegTiempo(int8 i8Registro){

    int32 i32Raw;                                                       // Variable auxiliar para los contadores (32 bits)

    // General
    i32Raw=make32(read_eeprom(i8Registro),read_eeprom(i8Registro+1),read_eeprom(i8Registro+2),read_eeprom(i8Registro+3));   // Obtengo el valor de tiempo del 
    i32Raw++;                                                           // Lo incremento
    
    write_eeprom(i8Registro,make8(i32Raw,3));                           // Escribo MSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    write_eeprom(i8Registro+1,make8(i32Raw,2));                         // Escribo MidMSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    write_eeprom(i8Registro+2,make8(i32Raw,1));                         // Escribo MidLSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    write_eeprom(i8Registro+3,make8(i32Raw,0));                         // Escribo LSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    
    // Parcial
    i32Raw=make32(read_eeprom(i8Registro+i8OffsetContParcial),read_eeprom(i8Registro+i8OffsetContParcial+1),read_eeprom(i8Registro+i8OffsetContParcial+2),read_eeprom(i8Registro+i8OffsetContParcial+3));        // Obtengo el valor
    i32Raw++;                                                           // Lo incremento
    
    write_eeprom(i8Registro+i8OffsetContParcial,make8(i32Raw,3));       // Escribo MSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    write_eeprom(i8Registro+i8OffsetContParcial+1,make8(i32Raw,2));     // Escribo MidHSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    write_eeprom(i8Registro+i8OffsetContParcial+2,make8(i32Raw,1));     // Escribo MidLSB
    pausa_I(DELAY_ESCRITURA_EEPROM);
    write_eeprom(i8Registro+i8OffsetContParcial+3,make8(i32Raw,0));     // Escribo LSB
    pausa_I(DELAY_ESCRITURA_EEPROM); 
}

/*
*   Función: muestraRegError()
*   Descripción: Representa por UART el registro de errores
*
*   Input:
*         - 
*   Output:
*         - 
*/
void muestraRegError(){
    funcionSaltoLinea();                                // Representación de la cabecera informativa
    representarTextoUART(sREGISTRO_ERRORES);            // Se representa de esta forma porque hemos gastado memoria por encima de nuestras posibilidades
    funcionSaltoLinea();
    representarTextoUART(sASTERISCOS);
    funcionSaltoLinea();
    funcionSaltoLinea();
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
    representarTextoUART(sLEYEMDA_REGISTRO_ERRORES);
    funcionSaltoLinea();
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
    for(int8 i8Registro=1; i8Registro<REG_ERROR_MAX; i8Registro++){         // Recorre todos los errores
        fprintf(DEBUG_UART,"%03u\t\t%u\t\t%u\r\n",i8Registro,read_eeprom(i8Registro),read_eeprom(i8Registro+i8OffsetErrorParcial));     // Representa el valor de los registros
    }   
}

/*
*   Función: muestraRegCont()
*   Descripción: Representa por UART el registro de contadores
*
*   Input:
*         - 
*   Output:
*         - 
*/
void muestraRegCont(){

    int8 i8ContIndiceTexto=0;                           // Contador del índice del texto en los bucles de representación
    int16 i16ContEEPROM=0;                              // Contador de posición en EEPROM
    
    funcionSaltoLinea();                                // Representación de la cabecera informativa
    representarTextoUART(sINFORME_INGENIERIA);
    funcionSaltoLinea();
    representarTextoUART(sASTERISCOS);
    funcionSaltoLinea();
    funcionSaltoLinea();
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
    representarTextoUART(sLEYENDA_INFORME_INGENIERIA);
    funcionSaltoLinea();
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
    
    representarTextoUART(sINF_ING_CICLOS_BAT);          // Lectura y muestra del número de ciclos de la batería
    fprintf(DEBUG_UART,"%lu\r\n",getCycleCount());
    
    for(i8ContIndiceTexto=sINF_ING_VECES_ON, i16ContEEPROM=REG_VECES_ENCENDIDO; i16ContEEPROM<REG_TRAT_SMP; i8ContIndiceTexto++, i16ContEEPROM+=2){     // Recorre los registos de contadores
        representarTextoUART(i8ContIndiceTexto);                                                                                                        // Representación por UART de la lectura
        fprintf(DEBUG_UART,"%lu         %lu\r\n",make16(read_eeprom(i16ContEEPROM),read_eeprom(i16ContEEPROM+1))
                                                                        ,make16(read_eeprom(i16ContEEPROM+i8OffsetContParcial),read_eeprom(i16ContEEPROM+i8OffsetContParcial+1)));     
    }
    
    for(i8ContIndiceTexto=sINF_ING_TIEMPO_CANAL_A, i16ContEEPROM=REG_TIEMPO_CHA; i16ContEEPROM<REG_TIEMPO_CHC; i8ContIndiceTexto++, i16ContEEPROM+=4){  // Recorre los registros de tiempos
        representarTextoUART(i8ContIndiceTexto);                                                                                                        // Representación por UART de la lectura   
        fprintf(DEBUG_UART,"%5.1f     %5.1f     min\r\n"  ,make32(read_eeprom(i16ContEEPROM),read_eeprom(i16ContEEPROM+1),read_eeprom(i16ContEEPROM+2),read_eeprom(i16ContEEPROM+3))/60.0
                                                                        ,make32(read_eeprom(i16ContEEPROM+i8OffsetContParcial),read_eeprom(i16ContEEPROM+i8OffsetContParcial+1),read_eeprom(i16ContEEPROM+i8OffsetContParcial+2),read_eeprom(i16ContEEPROM+i8OffsetContParcial+3))/60.0);
    }
                                                                
    representarTextoUART(sGUIONES);
    funcionSaltoLinea();
}

/*
*   Función: refreshRegError()
*   Descripción: Refresca los registros de error de la memoria. 
*                   Se recomienda en el datasheet que cada cierto tiempo 
*                   se refresquen los datos para evitar que se borren
*
*   Input:
*         - 
*   Output:
*         - 
*/
void refreshRegError(){
    for(int8 i8Registro=0; i8Registro<REG_ERROR_MAX; i8Registro++){                                 // Recorre el registro de errores
        write_eeprom(i8Registro,read_eeprom(i8Registro));                                           // Lee el valor del registro general y luego lo vuelve a guardar
        pausa_I(DELAY_ESCRITURA_EEPROM);
        write_eeprom(i8Registro+i8OffsetErrorParcial,read_eeprom(i8Registro+i8OffsetErrorParcial)); // Lee el valor del registro parcial y luego lo vuelve a guardar
        pausa_I(DELAY_ESCRITURA_EEPROM);
    }
}

/*
*   Función: refreshRegCont()
*   Descripción: Refresca los registros de contadores de la memoria. 
*                   Se recomienda en el datasheet que cada cierto tiempo 
*                   se refresquen los datos para evitar que se borren
*
*   Input:
*         - 
*   Output:
*         - 
*/
void refreshRegCont(){
    for(int8 i8Registro=REG_TRAT_CHA; i8Registro<REG_CONT_MAX; i8Registro++){                       // Recorre el registro de contadores
        write_eeprom(i8Registro,read_eeprom(i8Registro));                                           // Lee el valor del registro general y luego lo vuelve a guardar
        pausa_I(DELAY_ESCRITURA_EEPROM);
        write_eeprom(i8Registro+i8OffsetContParcial,read_eeprom(i8Registro+i8OffsetContParcial));   // Lee el valor del registro parcial y luego lo vuelve a guardar
        pausa_I(DELAY_ESCRITURA_EEPROM);
    }
}

/*
*   Función: informeIngenieria()
*   Descripción: Muestra por UART el registro completo de ingeniería
*
*   Input:
*         - 
*   Output:
*         - 
*/
void informeIngenieria(){
    muestraRegCont();       // Muestra registro de contadores
    muestraRegError();      // Muestra registro de errores
    
    int16 i16ValueRef=M25AA1024_read(POSICION_MEM_VREF);
    i16ValueRef<<=8;
    i16ValueRef|=M25AA1024_read(POSICION_MEM_VREF+1);
        
    fprintf(DEBUG_UART,"\r\nValor Calib: %lu mV\r\n");
}
