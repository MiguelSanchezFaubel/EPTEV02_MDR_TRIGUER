    if(giPosRulancha>100){                  // Si el número de repeticiones es superior a 100
        giPosRulancha=100;                  // Asigna 100
    }
    if (giPosRulancha<1){                   // Si el número de repeticiones es inferior a 1
        giPosRulancha=1;                    // Asigna 1
