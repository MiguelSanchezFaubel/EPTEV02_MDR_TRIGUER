/*
*   Función: menu_0
*   Descripción: Menú principal
*
*   Input:
*         - 
*   Output:
*         - 
*/
int8 menu_0(){                          

    if(bRefrescoPantalla){                              // Si debo refrescar la pantalla
        
        if(iMenuAnterior!=0 || bAlMenuPrincipal || bDeboVolverMenuPrincipal){       // Si el menú anterior no es el menú principal o me indica que tengo que ir al menú principal
        	bDeboVolverMenuPrincipal=0;
            bAlMenuPrincipal=0;                         // Inicializo flag menú principal
            ST7529_clear();                             // Limpio pantalla
            ST7529_printf(sMENU_PRINCIPAL,0,0,L_,NORMAL);   // Muestra texto menú principal
            i8CanalesConfigurados=0;                    // Inicializa variable de canales configurados
            i8ConfigCanal=0;                            // Inicializa variable del canal a configurar
            bPointerSeleccionado=0;                     // Inicializa selección de pointer
            if(iMenuAnterior==180){                     // Si el menú anterior era el de SMP
                i16ISMP=MINIMA_CORRIENTE_SMP;           // Inicializo corriente al mínimo 2*100 = 200u
                i8PulsosSMP=1;                          // Inicializo pulsos al mínimo
            }
            i8VariablesPreset=0;                        // Inicializo la variable que indica que debo de guardar en preset
            i8BufferIndex=0;                            // Inicializa buffer de entrada de datos
            bEvitaRebotePausa=0;                        // Inicializa flag evita rebotes tecla pausa
        }

        pantalla_seleccion();                           // Muestra iconos de selección
        
        if(giPos<=1){                                   // Si el valor de selección es menor o igual a 0
            giPos=1;                                    // Inicializo giPos
        }
        
        if(giPos>5){                                    // Si el valor de selección es mayor que 5
            giPos=5;                                    // Inicializo giPos al máximo
        }
        
        //ST7529_printf(/*sMENU_PRESETS*/"           Presets           ",COLUMNA_1_MENU,FILA_INIT_MENU,S_,giPos==0);            // Muestro menú Presets (se pone en texto porque queda mejor que la antigua en memoria)
        ST7529_printf("           Terapia 1          ",COLUMNA_1_MENU,FILA_1_MENU,S_,giPos==1);               // Muestro menú Galvánica
        ST7529_printf("           Terapia 2          ",COLUMNA_1_MENU,FILA_2_MENU,S_,giPos==2);          // Muestro menú Galvánica + Micro
        ST7529_printf("           Terapia 3          ",COLUMNA_1_MENU,FILA_3_MENU,S_,giPos==3);       // Muestro menú Transcraneal
        ST7529_printf("           Terapia 4          ",COLUMNA_1_MENU,FILA_4_MENU,S_,giPos==4);            // Muestro menú Electroestimulación
        //ST7529_printf("          Terapia 5           ",COLUMNA_1_MENU,FILA_5_MENU,S_,giPos==5);                // Muestro menú SMP
        ST7529_printf(/*sMENU_CONFIG*/"         Configuracion       ",COLUMNA_1_MENU,FILA_5_MENU,S_,giPos==5);          // Muestro menú Configuración
    
        iMenuAnterior=iMenuActual;                      // Inicializo menú anterior
        
    }
    
    bRefrescoPantalla=0;                                // Inicializo el refresco de pantalla
    
    return 0;                                           // Retorna 0
}

/*
*   Función: menu_10
*   Descripción: Menú configuración del dispositivo
*
*   Input:
*         - 
*   Output:
*         - 
*/
int8 menu_10(){   

    if(iMenuAnterior!=10){                              // Si venimos de un menú distinto de este
        ST7529_clear();                                 // Limpiamos pantalla
        ST7529_printf(sCONFIG,0,0,L_,NORMAL);           // Ponemos el texto de Configuracion
    } 
    
    if(bRefrescoPantalla){                              // Si debo de refrescar los valores
        pantalla_seleccion();                           // Muestro iconos de seleccion
           
        if(giPos>=5){                                   // Si la selección es mayor o igual a 5 
            giPos=4;                                    // Inicializo a 4
        }
           
        ST7529_printf(sCONFIG_ILUM,6,FILA_INIT,S_,giPos==0);    // Muestra texto configuración iluminación
        ST7529_printf(sCONFIG_CONT,6,FILA_1,S_,giPos==1);       // Muestra texto configuración contraste       
        ST7529_printf(sCONFIG_PITO,6,FILA_2,S_,giPos==2);       // Muestra texto configuración pito
        ST7529_printf(sCONFIG_IDIO,6,FILA_3,S_,giPos==3);       // Muestra texto configuración idioma
        ST7529_printf(sCONFIG_VERS,6,FILA_4,S_,giPos==4);       // Muestra texto configuración versión HW/FW

        iMenuAnterior=iMenuActual;                      // Inicializo el valor del menu anterior
    }
            
    bRefrescoPantalla=0;                                // Limpio flag refresco de pantalla

    return 0;                                           // Return 0
}

