        case 30:                                                            // Menú transcraneal
            if(giPos==2){                                                   // Si estamos ajustando el tiempo de tratamiento
                if(giPosRulancha>MAXIMO_TIEMPO_TRANSCRANEAL){               // Si el tiempo elegido es superior a MAXIMO_TIEMPO_TRANSCRANEAL
                    giPosRulancha=MAXIMO_TIEMPO_TRANSCRANEAL;               // Asigna MAXIMO_TIEMPO_TRANSCRANEAL
                }

                if (giPosRulancha<=MINIMO_TIEMPO_TRANSCRANEAL){             // Si el tiempo elegido es inferior o igual a MINIMO_TIEMPO_TRANSCRANEAL
                    giPosRulancha=MINIMO_TIEMPO_TRANSCRANEAL;               // Asigna MINIMO_TIEMPO_TRANSCRANEAL
                }

                i16Ttrans=giPosRulancha*SALTOS_TIEMPO_TRANSCRANEAL;         // Asigna tiempo a variable de tiempo transcraneal

                if(i16Ttrans!=0){                                           // Si el tiempo de tratamiento no es infinito
                    if((float)i8Trampatrans>=((i16Ttrans)/3.0)){            // Si el tiempo de rampa es superior a 1/3 del tiempo de tratamiento
                        i8Trampatrans=((i16Ttrans)/3);                      // Asigna como máximo 1/3 del tiempo de tratamiento
                    }
                }
                if(i8Trampatrans>=10){                                      // Si el tiempo de rampa es superior al máximo 
                    i8Trampatrans=10;                                       // Asigna valor máximo
                }
                i32Ctrans=calc_CargaTrans(i16Itrans);                       // Calculo el valor de carga electrica del tratamiento
            }
            break;
        case 40:                                                            // Menú electroestimulación
            if(giPos==2){                                                   // Si estamos configurando el tiempo activo
                if(giPosRulancha>MAXIMO_TIEMPO_ELECTROESTIMULACION){        // Si el valor es superior a MAXIMO_TIEMPO_ELECTROESTIMULACION
                    giPosRulancha=MAXIMO_TIEMPO_ELECTROESTIMULACION;        // Asignamos MAXIMO_TIEMPO_ELECTROESTIMULACION
                }
                if (giPosRulancha<=MINIMO_TIEMPO_ELECTROESTIMULACION){      // Si el valor es inferior o igual a MINIMO_TIEMPO_ELECTROESTIMULACION
                    giPosRulancha=MINIMO_TIEMPO_ELECTROESTIMULACION;        // Asignamos MINIMO_TIEMPO_ELECTROESTIMULACION 
                }
                i16TacElec[i8ConfigCanal]=giPosRulancha*SALTOS_TIEMPO_ELECTROESTIMULACION;  // Asignamos tiempo de tratamiento   

                if((float)i8TrElec[i8ConfigCanal]>=(i16TacElec[i8ConfigCanal]/3.0)){    // Si el valor es superior a MAXIMO_TIEMPO_ELECTROESTIMULACION
                    i8TrElec[i8ConfigCanal]=(i16TacElec[i8ConfigCanal]/3);              // Asignamos MAXIMO_TIEMPO_ELECTROESTIMULACION
                }

                if(i8TrElec[i8ConfigCanal]>=10){                                        // Si el tiempo de rampa es superior al máximo 
                    i8TrElec[i8ConfigCanal]=10;                                         // Asigna valor máximo
                }
            }else if(giPos==3){                                                         // Si estamos configurando el tiempo de descanso
                if(giPosRulancha>MAXIMO_TIEMPO_DESCANSO_ELECTROESTIMULACION){           // Si el valor es superior a MAXIMO_TIEMPO_DESCANSO_ELECTROESTIMULACION
                    giPosRulancha=MAXIMO_TIEMPO_DESCANSO_ELECTROESTIMULACION;           // Asignamos MAXIMO_TIEMPO_DESCANSO_ELECTROESTIMULACION 
                } 
                if (giPosRulancha<=MINIMO_TIEMPO_DESCANSO_ELECTROESTIMULACION){         // Si el valor es inferior o igual a MINIMO_TIEMPO_DESCANSO_ELECTROESTIMULACION
                    giPosRulancha=MINIMO_TIEMPO_DESCANSO_ELECTROESTIMULACION;           // Asignamos MINIMO_TIEMPO_DESCANSO_ELECTROESTIMULACION
                }
                i16TdElec[i8ConfigCanal]=giPosRulancha*SALTOS_TIEMPO_DESCANSO_ELECTROESTIMULACION;  // Asignamos tiempo de descanso 
            }
            break;
        case 80:                                                        // Menú SMP
            if(giPos==0){                                               // Si estamos configurando el tiempo de tratamiento
                if(giPosRulancha>MAXIMO_TIEMPO_SMP){                    // Si el tiempo de tratamiento es superior a MAXIMO_TIEMPO_SMP
                    giPosRulancha=MAXIMO_TIEMPO_SMP;                    // Asigna MAXIMO_TIEMPO_SMP
                }
                if (giPosRulancha<=MINIMO_TIEMPO_SMP){                  // Si el tiempo de tratamiento es inferior o igual a MINIMO_TIEMPO_SMP
                    giPosRulancha=MINIMO_TIEMPO_SMP;                    // Asigna MINIMO_TIEMPO_SMP
                }
                i16TacSMP=giPosRulancha*SALTOS_TIEMPO_SMP;              // Asigna valor de tiempo de tratamiento
            }else if(giPos==1){                                         // Si estamos configurando el tiempo de desfase entre pulsos
                i32CalculoSMP=((1000000/(int32)i16FrecSMP)-100)/100;    // Calcula el máximo tiempo de desfase entre pulsos permitido
                
                if(giPosRulancha>=i32CalculoSMP){                       // Si el valor del desfase entre pulsos elegido es superior a i32CalculoSMP
                    giPosRulancha=i32CalculoSMP;                        // Asignamos valor i32CalculoSMP
                }else{                                                  // Si es inferior
                    if(giPosRulancha>MAXIMO_TIEMPO_DESFASE_SMP){        // Si el valor del desfase entre pulsos elegido es superior a MAXIMO_TIEMPO_DESFASE_SMP
                        giPosRulancha=MAXIMO_TIEMPO_DESFASE_SMP;        // Asigna MAXIMO_TIEMPO_DESFASE_SMP
                    }
                }
  
                if (giPosRulancha<=MINIMO_TIEMPO_DESFASE_SMP){          // Si el valor de desfase entre pulsos es inferior o igual a MINIMO_TIEMPO_DESFASE_SMP
                    giPosRulancha=MINIMO_TIEMPO_DESFASE_SMP;            // Asigna MINIMO_TIEMPO_DESFASE_SMP
                }
                i32TDesfaseSMP=giPosRulancha*SALTOS_TIEMPO_DESFASE_SMP; // Asignamos tiempo de desfase entre pulsos
                if((i16PWSMP*2+BANDA_GUARDA*2) >= i32TDesfaseSMP){      // Si el tiempo de desfase definido es mayor o igual que el máximo tiempo de desfase entre pulsos permitido
                    giPosRulancha=(i32TDesfaseSMP-BANDA_GUARDA*2)/2;    // Asigna el máximo valor
                    giPosRulancha/=25;                                  // Calculamos y asignamos el valor de máximo ancho de pulso a partir de la frecuencia
                    i16PWSMP=giPosRulancha*25;                          // Comprobamos si el PW máximo es inferior a los valores del PW+, si es así, fijamos el máximo
                }
            }
            break;
    }
}

/*
