/*
*   Función: update_button
*   Descripción: Actualiza el estado de la pulsación de la rulancha
*        
*   Input:
*       - button_history    - Registro de los estados del codificador
*   Output:
*       -
*/
void update_button(long *button_history){
    *button_history = *button_history << 1;                  // Desplazamiento de un bit para recoger el siguiete dato
    *button_history= *button_history |read_button();         // Capturamos el nuevo dato y lo guardamos
}

/*
*   Función: read_button
*   Descripción: Lectura de la rulancha
*        
*   Input:
*       - 
*   Output:
*       - int1  - Estado del pin A del codificador
*/
int1 read_button(){
    return input_state(COD_A); ;                             // Devuelve el valor del estado del codificador
}

/*
*   Función: is_button_pressed
*   Descripción: Detecta si se ha detectado un girp en la rulancha o solo ruido
*        
*   Input:
*       - button_history    - Registro de los estados del codificador
*   Output:
*       - int1              - 1 si ha detectado giro, 0 si no
*/
int1 is_button_pressed(long *button_history){

    int8 pressed = 0;                                       // Variable utilizada para indicar si se ha detectado giro o no
   
    if ((*button_history | MASK) == 0b11111111111000000){   // Si se ha podido detectar mediante la máscara que se ha girado el codificador
        pressed = 1;                                        // Indico que se ha presionado el botón
        *button_history = 0xFFFF;                           // Inicializo de nuevo la variable
    }
   
    return (pressed);                                       // Devuelvo si se ha detectado giro (1) o no (0)
}

/*
*   Función: pausa_I
*   Descripción: 
*        
*   Input:
*       - delay     - Tiempo de delay en microsegundos(us)
*   Output:
*       -
*/
void pausa_I(int16 delay){
    restart_wdt_hw();                                       // Inicializo WDT HW
    for(int16 m=0;m<=delay;m++){                            // Dependiedo del valor de entrada...
        delay_us(1);                                        // Genera un delay multiplo de 1uS ( Delay total= 1uS*X )
    }
}

void pausa_ms(int16 delay){
    for(int16 i16Bucle=0; i16Bucle<delay; i16Bucle++){          // Bucle de espera
        for(int16 m=0;m<950;m++){                               // Bucle de espera ajusta para 1 ms aprox.
            delay_us(1);                                        // Genera un delay multiplo de 1uS ( Delay total= 1uS*X aprox)
        }
        restart_wdt();                                          // Inicializa WDT SW
        restart_wdt_hw();                                       // Inicializa WDT SW
    }
}

