    return(fAux);                                           // Devuelve el valor de carga
}
      
/* ELIMINAR
*   Función: calc_Tmicro
*   Descripción: Calcula el tiempo de microcorrientes
*        
*   Input:
*       - 
*   Output:
*       - int16     - Devuelve el tiempo de tratamiento en microcorrinetes
*/
int16 calc_Tmicro(){

    float aux;                                                                          // Variables auxiliares para el cálculo
    float aux1;
    float aux2;
    
    aux=(i16Cmicro*100.0);                                                              // Escalo el valor de la carga eléctrica 
    aux1=(10.0*(i16Imicro)*(i16PWmicro/1000000.0)*i16frecmicro*(1.0+bpolaridadmicro));  // Cálculo del valor de la corriente
    aux2=aux/aux1;                                                                      // Obtención del tiempo de tratamiento
    
    return(aux2);                                                                       // Devuelve el valor
}   

/*
*   Función: Calc_BWmax
*   Descripción: Cálcuo del máximo ancho de pulso permitido
*        
*   Input:
*       - frecuencia    - Frecuencia del canal
*       - polaridad     - Polaridad del canal
*   Output:
*       - int16         -
*/
int16 Calc_BWmax(int16 frecuencia,int1 polaridad){

    float aux;                                          // Variables auxiliares para el cálculo
    int32 aux1;
    
    aux=((0.9*1000000)/(frecuencia));                   // Eliminamos el ajuste de polaridad para los ajustes asimetricos de bipolaridad mayores a la mitad del PWmax
    aux1=aux;                                           // Cast data
     
    if (aux1>=1000){                                    // Si el valor obtenido es mayor a 1000
        aux1=1000;                                      // Fijo el alor de 1000
    }
    
    aux1/=25;                                           // Dividimos por factor de 25 (factor del PW)
    
    if(i8ConfigCanal==POINTER_C){                       // Si estamos en el pointer
        if(aux1>=40){                                   // Si el ancho de pulso es mayor a (20*25 = 500us)
            aux1=40;                                    // Asigno 500us
        }
    }
    
    return(aux1);                                       // Devuelve el valor obtenido
}

/*
*   Función: Calc_BW
*   Descripción: Cálculo del ancho de pulso
*        
*   Input:
*       - max       - Máximo ancho de pulso permitido para el canal
*       - BW        - Ancho de pulso seleccionado
*   Output:
*       - int16     - Devuelve el ancho de pulso
*/
int16 Calc_BW(int16 max,int16 BW){

    if (BW>max*25){         // Si el PW es mayor que esa expresión
        BW=max*25;          // Asigno el valor
    }
    
    return(BW);             // Devuelve el valor de lancho de pulso
}

/*
*   Función: Calc_representacion_t
*   Descripción: Calcula el timepo de representación
*        
*   Input:
*       - iTiempoActivo - Tiempo de tratamiento 
*       - iTiempoReposo - Tiempo de reposo
*   Output:
*       -
*/
void  Calc_representacion_t(int16 iTiempoActivo, int16 iTiempoReposo){

    float fAuxAct, fAuxRep;             // Variables auxiliares para el cálculo
    
    fAuxAct=iTiempoActivo/60.0;         // Divido el tiempo activo para obtener los minutos
    fAuxRep=iTiempoReposo/60.0;         // Divido el tiempo en resposo para obtener los minutos

    i8Tmin=fAuxAct;                     // Asigno los minutos
    i8Tseg=iTiempoActivo%60;            // Hago el módulo de 60 para obtener los segundos
    i8T1min=fAuxRep;                    // Asigno los minutos                             
    i8T1seg=iTiempoReposo%60;           // Hago el módulo de 60 para obtener los segundos 
}

