/*
*   Función: calc_Tgalv
*   Descripción: Cálculo del tiempo de tratamiento a partir de la carga y la corriente
*        
*   Input:
*       - carga     - Carga galvánica seleccionada
*       - corriente - Corriente galvánica seleccionada
*   Output:
*       - int16     - Devuelve el tiempo correspondiente de tratamiento
*/
int16 calc_Tgalv(int32 carga,int16 corriente){

    float aux2=((float)carga)/(corriente*50);           // Obtengo el tiempo de tratamiento a partir de la carga eléctrica dividida por la corriente
    
    if(aux2<=0){                                        // Si fuera un valor negativo...(puede pasar??? yo diria que no)
        aux2=0;                                         // Inicializa valor
    }
    
    return(aux2);                                       // Devuelve el valor de tiempo
}

/*
*   Función: calc_CargaGalv
*   Descripción: Cálculo de la carga total a partir de la corriente
*        
*   Input:
*       - corriente - Corriente galvánica seleccionada
*   Output:
*       - int32     - Valor de carga total
*/
int32 calc_CargaGalv(int16 corriente){

    float fAux=0;                                                               // Variable auxiliar para la carga
    
    if(i8TrampaGalv[bSeleccionGalvanica]>0){                                    // Si hay tiempo de rampa configurado
        i16CRampaGalv=(float)corriente*50*i8TrampaGalv[bSeleccionGalvanica]/2;  // Obtengo la carga de la rampa
        i16CRampaGalvInc=i16CRampaGalv/i8TrampaGalv[bSeleccionGalvanica];       // Obtengo los incrementos de rampa
    }else{                                                                      // Si no hay tiempo de rampa configurado...
        i16CRampaGalv=0;                                                        // Pongo carga de rampa a 0
    }
    
    fAux=(float)corriente*50*i16TGalv[bSeleccionGalvanica];                     // Obtengo la carga del tratamiento, si hay rampa, la sumo
    
    return(fAux);                                                               // Devuelve el valor de carga
}
     
int32 calc_CargaTrans(int16 corriente){

    float fAux=0;                                           // Variable auxiliar para la carga
    
    if(i8TrampaTrans>0){                                    // Si hay tiempo de rampa configurado
        i16CRampaTrans=(float)corriente*50*i8TrampaTrans/2; // Obtengo la carga de la rampa
