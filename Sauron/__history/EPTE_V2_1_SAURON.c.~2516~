// Interrupción recepción datos puerto serie
#INT_RDA2 
void serial_isr(){
    
    bRecibiendoDatos=1;                                         // Indico que se están recibiendo datos

    i8DatoRecibido=fgetc(COM_PIC_UART);                         // Leo datos del buffer de entrada
    
    if(i8BufferIndex==0){                                       // Si es el primer dato que se recibe
        if(i8DatoRecibido<=MAX_PAQUETES){                       // Si es un paquete válido
            i8BufferEntrada[i8BufferIndex++]=i8DatoRecibido;    // Capturo el dato recibido por el otro PIC   
        }
    }else{                                                      // Si ya se están recibiendo más datos
        i8BufferEntrada[i8BufferIndex++]=i8DatoRecibido;        // Capturo el dato recibido por el otro PIC   

        if(i8BufferIndex>1){                                    // Si ya tenemos mínimo dos datos en el buffer de entrada 
            if(i8DatoRecibido=='\r' || bCasiRecibido){          // Si se ha recibido el inicio de fin de trama o se habia recibido en el dato anterior
                bCasiRecibido=1;                                // Pongo el flag casi recibido activado
                if(i8DatoRecibido=='\n'){                       // Si se recibe el fin de fin de trama
                    if(checkSize(i8BufferEntrada[0])){          // Si es el paquete correcto
                        bDatoRecibido=1;                        // Indica que ya se ha recibido la trama de datos
                        i8BufferIndex=0;                        // Inicializa el valor de índice del buffer
                    }else{                                      // Si no es el correcto
                        if(!bNoEsFinDeTrama){                   // Es posible que haya ocurrido que recibimos un \r\n como datosy no como fin de trama? Si es asi, continua sin entrar en estan condición
                            i8BufferIndex=0;                    // Inicializa el valor de índice del buffer
                            bRecibiendoDatos=0;                 // Dejo de recbiir datos
                        }
                        bNoEsFinDeTrama=0;                      // Inicializo flag
                        bDatoRecibido=0;                        // Indica que NO se ha recibido la trama de datos
                    }
                    bCasiRecibido=0;                            // Reinicio flag casi recibido

                }else if(i8DatoRecibido!='\r'){                 // Si el dato que se ha recibido no es ni \r ni \n
                    bCasiRecibido=0;                            // Reinicio flag casi recibido
                }
            }
        }
    }
}

// Timer 10 - Base de tiempos
#INT_TIMER10
void TIMER10_isr(void){

    if(bDeboPitar){                                                 // Si debo pitar
        i32ContadorPitido++;                                        // Incremento el contador de pitido
        if(i32ContadorPitido>i32BaseContadorPitido || i32ContadorPitido>MAX_PITIDO_ERROR){  // Si ha llegado al tiempo que tiene que estar pitando o ha desbordado en tiempo
            i32ContadorPitido=0;                                    // Inicializa contador de pitido
            controlSonido(0);                                       // Apaga el pitido 
        }
    }
    
    if(!bInicializandoEquipo){                                      // Si no está durantela inicialización del equipo
        i32ParpadeoBateria++;                                       // Incremento el contador del parpadeo de batería          
        var_tiempo++;                                               // Incremento la variable contador de tiempo 
        var_tiempo2++;                                              // Incremento la variable contador de tiempo 2
        i32ContadorSincronia++;                                     // Incremento la variable contador de sincronía
        
        if(i32ContadorSincronia>=i32BaseContadorSimetria){          // Si ha transcurrido el tiempo base del contador de sincronía
            i32ContadorSincronia=0;                                 // Inicializa el contador de sincronía
            if(!bEsperandoACK && !input_state(ORCO_ENVIANDO)){      // Si no estamos esperando ningún ACK y Orco no está enviando datos
                i32BaseContadorSimetria=TIEMPO_SINCRONIA;           // Inicializo la base del contador
                output_toggle(SINC_COMMS);                          // Cambio el pin de sincronia
            }else{                                                  // Si estamos esperando ACK o Orco está enviando
                if(bEsperandoACK && input_state(ORCO_ENVIANDO)){    // DEBUG
                    output_high(LED_ALPP);
                }
                i32BaseContadorSimetria=TIEMPO_SINCRONIA_CORTO;     // Inicializo la base del contador a un tiempo más corto para que vuelva a intentarlo 
            }
        }
    
        if(var_tiempo2>3000){                                       // Si han pasado 3 segundos
            var_tiempo2=0;                                          // Inicializo la variable de contador de tiempo
            bBloqueoPulsador=0;                                     // Levanto el bloque de pulsador presionado
        }
        
        if(iMenuActual==121 || iMenuActual==131 || iMenuActual==141 || iMenuActual==181 || i8CanalesActivados){     // Si estamos en tratamiento
            i32TiempoComunicaciones++;                                              // Incremento el tiempo de comunicaciones
            
            if(i32TiempoComunicaciones>(6*TIEMPO_REPRESENTACION)){                  // Si ha pasado 6*TIEMPO_REPRESENTACION, hay un error en las comunicacioens
                i32TiempoComunicaciones=0;                                          // Reinicio el contador
                if(!bErrorElectrodoGalvanicaActivado || !bHeDetectadoMovimiento){   // Si no hay error de electrodo en galvánica o no ha saltado el acelerómetro (golpe)
                    bErrorComunicaciones=1;                                         // Indico error de comunicaciones
                    bRefrescoPantalla=1;                                            // Indico que hay que refrescar la pantalla
                }
            }
        }
        
        if((i8CanalesActivados || bTratamientoTBActivado || bTratamientoGalvanicaActivado || bTratamientoTranscranealActivado || bMicrocorrientesEncendido) && bEmpiezaContadorTiempo){       // Si hay un tratamiento activo
            // El valor para 1 segundo debería de ser 1000, pero se ha puesto 993 para cuadrar el tiempo de ejecución y tal y que realmente sea un segundo
            if(bTratamientoGalvanicaActivado || bTratamientoTranscranealActivado){                  // Si estamos en tratamiento galvánica,galv+micro o transcraneal
                if(bMicrocorrientesEncendido){                                                      // Si estamos en microcorrientes
                    i16BaseTiemposGalvanica=996;                                                    // Asigno base de tiempos
                }else{                                                                              // Si estamos en galvánica o transcraneal
                    if(i16Tgalv[bSeleccionGalvanica]<4 && i16Tgalv[bSeleccionGalvanica]!=0){        // Si estamos en los últimos segundos de tratamiento (REVISAR, WHAT?)
                        i16BaseTiemposGalvanica=970;                                                // Asigno base de tiempos
                    }else{                                                                          // Para los otros casos
                        i16BaseTiemposGalvanica=993;                                                // Asigno base de tiempos
                    }
                }
                
                if(var_tiempo>=i16BaseTiemposGalvanica){                                            // Si ha pasado un segundo
                    f_segundo=1;                                                                    // Indico que ha pasado un segundo
                    var_tiempo=0;                                                                   // Reinicio la variable contador de tiempo
                    bRefrescoPantalla=1;                                                            // Indico que hay que refrescar la pantalla
                }
            }else{                                                                                  // Si estamos en cualquier otro tratamiento
                if(var_tiempo>=993){                                                                // Si ha pasado un segundo
                    f_segundo=1;                                                                    // Indico que ha pasado un segundo
                    var_tiempo=0;                                                                   // Reinicio la variable contador de tiempo
                    bRefrescoPantalla=1;                                                            // Indico que hay que refrescar la pantalla
                }
            }
        }
    }
}

// IMPv: Timer 12 - Sistema anti-rebotes del codificador
#INT_TIMER12
void TIMER12_isr(void){

    cuenta++;                                               // Incrementa el contador de cuenta
    if (cuenta<=15){                                        // Si no ha incrementado hasta haber pasado 16 veces
        update_button(&button_history);                     // Actualizo el estado del codificador
        pulsacion=is_button_pressed(&button_history);       // Se comprueba si ha sido girado correctamente o han sido rebotes
        if (pulsacion==1){                                  // Si se ha detectado un giro
            if(bGirDerecha){                                // Si se ha girado a la derecha
                itecla=1;                                   // Indico que se ha girado a la derecha
            }else{                                          // Si se ha girado a la izquierda
                itecla=2;                                   // Indico que se ha girado a la izquierda
            }
            button_history=0xffff;                          // Reinicio el valor del estado del codificador
            disable_interrupts(INT_TIMER12);                // Deshabilito la interrupción del Timer 12
            clear_interrupt(INT_EXT1_H2L);                  // Limpio la interrupción generada por el codificador
            enable_interrupts(INT_EXT1_H2L);                // Habilito la interrupción del codificador
            bModoRulancha=1;
        }
    }else{                                                  // Si ha pasado de 16
        cuenta=0;                                           // Reinicio el valor de cuenta
        button_history=0xffff;                              // Reinicio el valor del estado del codificador
        disable_interrupts(INT_TIMER12);                    // Deshabilito la interrupción del Timer 12
        enable_interrupts(INT_EXT1_H2L);                    // Habilito la interrupción del codificador
    }
}

// Interrupción del pulsador RB0
#INT_EXT
void  EXT_isr(void){

    disable_interrupts(INT_EXT_H2L);                    // Deshabilita la interrupción del botón
    clear_interrupt(INT_EXT_H2L);                       // Limpia el flag de interrupción

    if(iMenuActual==121||iMenuActual==131||iMenuActual==141||iMenuActual==181||iMenuActual==123||iMenuActual==143||iMenuActual==183||i8CanalesActivados!=0){  // Si se ha presionado el botón de apagado durante el tratamiento
        if((i16TGalv[bSeleccionGalvanica]==0 && iMenuActual==121 && bSeleccionGalvanica==0) || (i16Ttrans==0 && iMenuActual==131)){         // Si en alguno de los tratamientos estamos en tiempo infinito
            bPausaTratamiento=0;                        // No indica pausa, indica parada de tratamiento (no existe pausa en tiempo infinito)
        }else{                                          // En cualquier otro caso
            bPausaTratamiento=1;                        // Indica pausa de tratamiento
            bVeniaDePausa=1;
        }

        if(!bBloqueoPulsador){                          // Si el pulsaodr no se encuentra bloqueado
            if(!bEvitaRebotePausa){                     // Si no tengo que evitar "rebotes" del pulsador de pausa (ansia del operador presionando varias veces pausa mientras para)
                itecla=5;                               // Asigan la tecla 5 para apagar el tratamiento
                bEvitaRebotePausa=1;                    // Activo el antirebotes de pausa
            }
        }
    }else{                                              // Si se haya presionado la tecla otro momento
        while(!input_state(ON_OFF)){                    // Mientras el botón de encendido/apagado esté presionado
            if(!bSleepMode){                            // Si no se encuentra dormido
                ControlSonidoSinTimer(1);               // Enciendo el pito
            }
            delay_ms_wdt(1);                            // Delay de 1 ms
            i16TiempoApretado++;                        // Aumenta el ocntador
            
            if(i16TiempoApretado>1000){                 // Si el contador es superior a 1000, es decir, ha pasado 1 segundo (1000 incrementos x 1ms)
                if (bSleepMode){                        // Si se encontraba en modo sleep
                    bSleepMode=0;                       // Pongo el indicador de modo sleep a 0
                    iMenuActual=0;                      // Fijo el menú actual al menú principal
                }else{                                  // Si acaba de entrar al modo sleep
                    bSleepMode=1;                       // Pongo el indicador de modo sleep a 1
                }
                break;                                  // Sale del bucle while
            }else{                                      // Si ha sido presionado una vez
                if(!bSleepMode){                        // Si no estamos durmiendo
                    if(i8CanalesActivados==0){          // Si no hay ningún tratamiento activo mientras configuro otro canal que no está activado
                        iMenuActual=0;                  // Vuelvo al menu principal
                        giPos=Anterior_giPos[0];        // Recupero el valor de giPos guardado
                        Anterior_giPos[0]=0;            // Inicializo el anterior giPos
                        Anterior_giPos[1]=0;            // Inicializo el anterior giPos
                        bAlMenuPrincipal=1;             // Flag que indica la vuelta al menú principal
                        bRefrescoPantalla=1;            // Refresco de pantalla
                    }
                }
            }
        }
        ControlSonidoSinTimer(0);                       // Apago el pito
    }
    
    i16TiempoApretado=0;                                // Reinicia el valor del contador de tiempo apretado
    clear_interrupt(INT_EXT_H2L);                       // Limpia la interrupción del botón 
    enable_interrupts(INT_EXT_H2L);                     // Habilita la interrupcion del botóm
  
}

// Interrupción del codificador rotativo para saber la dirección de giro
#INT_EXT1
void  EXT1_isr(void){

    if(input_state(COD_B)){             // Si se encuentra activo el COD_B
        bGirDerecha=1;                  // Significa que estoy girando a la derecha
        bGirIzquierda=0;                // Anulo giro a la izquierda
    }else{                              // En el caso de que no se encuentre activo
        bGirDerecha=0;                  // Anulo giro a la derecha
        bGirIzquierda=1;                // Significa que estoy girando hacia la izquierda
    }

    cuenta=0;                           // Inicializo valor de cuenta (antirebotes rulancha)

    update_button(&button_history);     // Actualizo el estado del codificador
    disable_interrupts(INT_EXT1_H2L);   // Deshabilito la interrupción
    enable_interrupts(INT_TIMER12);     // Habilito el Timer 12 para el sistema antirebotes
}

// Interrupción al presionar alguna de las teclas del teclado
#INT_EXT3
void  EXT3_isr(void){

    disable_interrupts(INT_EXT3_H2L);           // Deshabilito la interrupción
    clear_interrupt(INT_EXT3_H2L);              // Limpio la interrupción

    i32DebounceTimer=0;                         // Inicializa contadorantirebotes

    set_timer3((int16)0);                       // Inicializa Timer 3
    enable_interrupts(INT_TIMER3);              // Habilita interrupciones del Timer 3

    if(!input_state(MENU_2)){                   // TECLA 3 - Si se presiona la tecla de selección hacia la derecha/config
        i32TiempoComunicaciones=0;              // Reinicio variable timeout comunicaciones
        itecla=3;                               // Selecciona opción 3
    }else if(!input_state(MENU_1)){             // TECLA 4 - Si se presiona la tecla de selección hacia la izquierda/cancelar
        i32TiempoComunicaciones=0;              // Reinicio variable timeout comunicaciones
        itecla=4;                               // Selecciona opción 4
    }else{                                      // Para cualquier otra tecla pulsada
        i32TiempoComunicaciones=0;              // Reinicio variable timeout comunicaciones
    
        if(!input_state(MENU_4)){               // TECLA 1 - Si se presiona la tecla de selección hacia arriba 
            itecla=1;                           // Selecciona opción 1
        }else if(!input_state(MENU_3)){         // TECLA 2 - Si se presiona la tecla de selección hacia abajo     
            itecla=2;                           // Selecciona opción 2    
        }else  if(!input_state(ST_STOP) || !input_state(PEDAL)){        // Si se presiona la tecla de selección start/stop
            if(!bBloqueoPulsador){              // Si no está bloqueado el pulsador de start
                itecla=5;                       // Selecciona opción 5
                var_tiempo2=0;                  // Inicializa variable del temporizador
            }
        }else{                                  // Si no se ha pulsado ninguna tecla (algún rebote o falsa pulsación)
            bUnaPulsacion=0;                    // Inicializa el flag de pulsación
            clear_interrupt(INT_EXT3_H2L);      // Limpia interrupción
            enable_interrupts(INT_EXT3_H2L);    // Deshabilito la interrupción
            disable_interrupts(INT_TIMER3);     // Deshabilito interrupción
            clear_interrupt(INT_TIMER3);        // Limpia interrupción
        }
    }
}

// Interrupción del Timer 3 correspondiente al antirrebotes de los pulsadores
#INT_TIMER3
void TIMER3_isr(){

    set_timer3((int16)0);                       // Inicializa el Timer 3

    i32DebounceTimer++;                         // Incrementa el contador

    if(i32DebounceTimer>=DEBOUNCE_TIMER_3){     // Si ha pasado el tiempo establecido
        bUnaPulsacion=1;                        // Indico que se ha realizado una pulsación
        disable_interrupts(INT_TIMER3);         // Deshabilito Timer 3
        clear_interrupt(INT_TIMER3);            // Limpio flag de interrupción
    }
}

// Interrupción del puerto RB
#INT_RB
void  RB_isr(void){
    
    enable_RB=0;                                                // Deshabilitamos interrupcion cambio RB
    aux=PORTB;                                                  // Leo el puerto B
    clear_RB=0;                                                 // Borramos flag de interrupcion

    if(!(aux&0x40)){                                            // Si NO(!) ha entrado a la interrupción debido a que hay una señal en CTS
        if ((input_state(INT_ACEL)==1)&&(bSleepMode==0)){       // Si hay interrupcion de acelerometro y el dispositivo se encuentra activado
            baceleron=1;                                        // Flag que indica caida del dispositivo
        }else{                                                  // En el caso de que no sea activada la interrupción por el acelerómetro o que se encontrara el dispositivo dormido                                        
            if (input_state(DET_CHG)==0){                       // Si existe interrupcion por cargador
                bcargador=1;                                    // Indico que se ha conectado el cargador
            }else{                                              // Sino, ha sido un ruido el que ha activado la interrupción                           
                enable_RB=1;                                    // Habilitamos interrupcion cambio RB
            }                                                 
        }
    }else{                                                      // Si ha entrado debido a que hay una señal en CTS
        enable_RB=1;                                            // Pasa de la interrupción
    }
}

