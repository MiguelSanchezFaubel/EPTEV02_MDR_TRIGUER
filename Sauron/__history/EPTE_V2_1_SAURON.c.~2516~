/*
*   Función: comprobacionLimitesFrecuencia
*   Descripción: Comprueba los límites de frecuencia para cada canal 
*       cuando hay varios canales activados
*        
*   Input:
*       - 
*   Output:
*       -
*/
void comprobacionLimitesFrecuencia(){
    switch(i8CanalesConfigurados){                          // Dependiendo del núemro de canales activados
        case 0:                                             // Si no hay nada configurado, inicializo los límites
            i16FrecLimSup[CHA_C]=500;                       // Ajusto límite superior
            i16FrecLimInf[CHA_C]=2;                         // Ajusto límite inferior
            i16FrecLimSup[CHB_C]=500;                       // Ajusto límite superior
            i16FrecLimInf[CHB_C]=2;                         // Ajusto límite inferior
            i16FrecLimSup[CHC_C]=500;                       // Ajusto límite superior
            i16FrecLimInf[CHC_C]=2;                         // Ajusto límite inferior
            i16FrecLimSup[POINTER_C]=150;                   // Ajusto límite superior
            i16FrecLimInf[POINTER_C]=2;                     // Ajusto límite inferior
            break;
        case CHA_ACT:                                       // Si está el CHA configurado, ponemos límites B y C
            i16FrecLimSup[CHB_C]=500;                       // Ajusto límite superior
            i16FrecLimInf[CHB_C]=i16FrecElec[CHA_C];        // Ajusto límite inferior
            i16FrecLimSup[CHC_C]=500;                       // Ajusto límite superior         
            i16FrecLimInf[CHC_C]=i16FrecElec[CHA_C];        // Ajusto límite inferior
            break;
        case CHB_ACT:                                       // Si está el CHB configurado, ponemos límites A y C
            i16FrecLimSup[CHA_C]=i16FrecElec[CHB_C];        // Ajusto límite superior
            i16FrecLimInf[CHA_C]=2;                         // Ajusto límite inferior
            i16FrecLimSup[CHC_C]=500;                       // Ajusto límite superior
            i16FrecLimInf[CHC_C]=i16FrecElec[CHB_C];        // Ajusto límite inferior
            i16FrecLimSup[POINTER_C]=i16FrecLimSup[CHA_C];  // Ajusto límite superior
            if(i16FrecLimSup[POINTER_C]>=150){              // Si la frecuencia del límite superior del pointer es mayor a 150 Hz
                i16FrecLimSup[POINTER_C]=150;               // Ajusto límite superior a su máximo
            }   
            i16FrecLimInf[POINTER_C]=2;                     // Ajusto límite inferior
            break;
        case CHC_ACT:                                       // Si está el CHC configurado, ponemos límites A y B
            i16FrecLimSup[CHA_C]=i16FrecElec[CHC_C];        // Ajusto límite superior                                            
            i16FrecLimInf[CHA_C]=2;                         // Ajusto límite inferior                                            
            i16FrecLimSup[CHB_C]=i16FrecElec[CHC_C]; ;      // Ajusto límite superior                                            
            i16FrecLimInf[CHB_C]=2;                         // Ajusto límite inferior                                            
            i16FrecLimSup[POINTER_C]=i16FrecLimSup[CHA_C];  // Ajusto límite superior                                            
            if(i16FrecLimSup[POINTER_C]>=150){              // Si la frecuencia del límite superior del pointer es mayor a 150 Hz
                i16FrecLimSup[POINTER_C]=150;               // Ajusto límite superior a su máximo                                
            }                                                                                                                    
            i16FrecLimInf[POINTER_C]=2;                     // Ajusto límite inferior                                            
            break;
        case POINTER_ACT:                                   // Si está el POINTER configurado, ponemos límites B y C
            i16FrecLimSup[CHB_C]=500;                       // Ajusto límite superior
            i16FrecLimInf[CHB_C]=i16FrecElec[POINTER_C];    // Ajusto límite inferior
            i16FrecLimSup[CHC_C]=500;                       // Ajusto límite superior
            i16FrecLimInf[CHC_C]=i16FrecElec[POINTER_C];    // Ajusto límite inferior
            break;
        case CHA_ACT | CHB_ACT:                             // Si está el CHA y CHB configurado, ponemos límites C
            i16FrecLimSup[CHC_C]=500;                       // Ajusto límite superior
            i16FrecLimInf[CHC_C]=i16FrecElec[CHB_C];        // Ajusto límite inferior
            break;
        case CHB_ACT | CHC_ACT:                             // Si está el CHB y CHC configurado, ponemos límites A
            i16FrecLimSup[CHA_C]=i16FrecElec[CHB_C];        // Ajusto límite superior
            i16FrecLimInf[CHA_C]=2;                         // Ajusto límite inferior
            i16FrecLimSup[POINTER_C]=i16FrecLimSup[CHA_C];  // Ajusto límite superior
            if(i16FrecLimSup[POINTER_C]>=150){              // Si la frecuencia del límite superior del pointer es mayor a 150 Hz
                i16FrecLimSup[POINTER_C]=150;               // Ajusto límite superior a su máximo                                
            }                                                                                                                    
            i16FrecLimInf[POINTER_C]=2;                     // Ajusto límite inferior                                            
            break;
        case CHA_ACT | CHC_ACT:                             // Si está el CHA y CHC configurado, ponemos límites B
            i16FrecLimSup[CHB_C]=i16FrecElec[CHC_C];        // Ajusto límite superior
            i16FrecLimInf[CHB_C]=i16FrecElec[CHA_C];        // Ajusto límite inferior
            break;
        case POINTER_ACT | CHB_ACT:                         // Si está el POINTER y CHB configurado, ponemos límites C
            i16FrecLimSup[CHC_C]=500;                       // Ajusto límite superior
            i16FrecLimInf[CHC_C]=i16FrecElec[CHB_C];        // Ajusto límite inferior
            break;
        case POINTER_ACT | CHC_ACT:                         // Si está el POINTER y CHC configurado, ponemos límites B
            i16FrecLimSup[CHB_C]=i16FrecElec[CHC_C];        // Ajusto límite superior
            i16FrecLimInf[CHB_C]=i16FrecElec[POINTER_C];    // Ajusto límite inferior
            break;
    }
    
    for(int8 i8Cont=0; i8Cont<4; i8Cont++){                     // Recorro todos los canales (3 EESTIM + POINTER)
        if(i16FrecElec[i8Cont]>=i16FrecLimSup[i8Cont]){         // Si la frecuencia de ese canal es superior o igual al límite superior para ese canal
            i16FrecElec[i8Cont]=i16FrecLimSup[i8Cont];          // Ajustamos al límite superior
        }else if(i16FrecElec[i8Cont]<=i16FrecLimInf[i8Cont]){   // Si no, si la frecuencia de ese canal es inferior o igual al límite inferior para ese canal
            i16FrecElec[i8Cont]=i16FrecLimInf[i8Cont];          // Ajustamos al límite inferior
        }
    }
}

