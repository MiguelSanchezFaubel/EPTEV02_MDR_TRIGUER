            i16PW_minusElec[CHB_C]=i16PW_minusElec[CHA_C];                          // Copiamos el PW-
            break;
        case 2:                                                                     // Canales ABC
            if(bTiempo){                                                            // Si queremos copiar los valores de tiempo
                i16TacElec[CHC_C]=i16TacElec[CHB_C]=i16TacElec[CHA_C];              // Copiamos tiempo activo                  
