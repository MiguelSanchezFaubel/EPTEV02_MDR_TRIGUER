/*
*   Función: control_rele
*   Descripción: Controla el estado de los relés
*        
*   Input:
*       - control_rele  - Selecciona 1 (ON) o 0 (OFF)
*       - rele          - rele_GALV/rele_CHA/rele_CHB/rele_CHC/rele_PGM 
*   Output:
*       -
*/
void  control_rele(int1 control,int8 rele){    

    int16 state_rele=0x0100;                                    // Inicializamos el estado del LED (Encendemos uno de ellos)
    int8 DATA_MSB=0;                                            // Dato para MSB
    int8 DATA_LSB=0;                                            // Dato para LSB

    if(rele==rele_PGM){                                         // En el caso de que se trate del relé de programación...(este NO va mediante el expansor)
    
        if(control){                                            // Si se quiere activar
            output_high(C_RL_PGM_S);                            // Activamos relé
        }else{                                                  // Si se quiere desactivar
            output_high(C_RL_PGM_R);                            // Desactivamos relé
        }
        
        pausa_ms(100);                                          // Delay para activar el bobinado del relé
        output_low(C_RL_PGM_S);                                 // Ponemos de nuevo a nivel bajo estas señales
        output_low(C_RL_PGM_R);
        
    }else{                                                      // En el caso de querer  activar uno de los relés conectados al expansor
        DATA_MSB=make8(read_PCA955X(0x00,PCA9555),1);           // Guardo el MSB (es el valor de los LEDs), ya que este no lo quiero modificar
    
        switch(rele){                                       // Dependiendo del rele seleccionado
            case rele_GALV:                                 // Rele galvánica
                if(control){                                // Si activo el relé
                    state_rele=0x04;                        // Activo el relé seleccionado
                }else{                                      // Si desactivo el relé
                    state_rele=0x40;                        // Desactivo el relé seleccionado
                }
                break;
            case rele_CHA:                                  // Rele canal A
                if(control){                                // Si activo el relé
                    state_rele=0x08;                        // Activo el relé seleccionado
                }else{                                      // Si desactivo el relé
                    state_rele=0x20;                        // Desactivo el relé seleccionado
                }
                break;
            case rele_CHB:                                  // Rele canal B
                if(control){                                // Si activo el relé
                    state_rele=0x10;                        // Activo el relé seleccionado 
                }else{                                      // Si desactivo el relé
                    state_rele=0x80;                        // Desactivo el relé seleccionado
                }
                break;
            case rele_CHC:                                  // Rele canal C
                if(control){                                // Si activo el relé
                    state_rele=0x02;                        // Activo el relé seleccionado
                }else{                                      // Si desactivo el relé
                    state_rele=0x01;                        // Desactivo el relé seleccionado
                }
                break;
        }

        DATA_LSB=make8(state_rele,0);                           // Obtengo el byte más significativo
        
        write_PCA955X(DATA_LSB,DATA_MSB, 0x00,PCA9555);         // Escribo los valores al expansor
        pausa_ms(100);                                          // Delay de activacion de bobinado
        
        DATA_LSB=0;                                             // Pongo a cero el byte de control de relés
        write_PCA955X(DATA_LSB,DATA_MSB, 0x00,PCA9555);         // Escribo de nuevo

    }
}

/*
*   Función: ControlSonido
*   Descripción: Enciende o apaga el pito
*        
*   Input:
*       - control   - 1 para encender el pito, 0 para apagarlo
*   Output:
*       -
*/
#separate
void ControlSonido(int1 control){               
    
    if (control){                                           // Si se ha activado el sonido
        if (i16nivel_son!=0){                               // Mientras en nivel de sonido sea distinto de 0
            CCP7CON=0x0C;                                   // Enciendo el modulador
            i32ContadorPitido=0;                            // Inicializo el contador de pitido
            bDeboPitar=1;                                   // Indico que debo pitar
        }                               
    }else{                                                  // En caso de querer apagarlo
        CCP7CON=0x00;                                       // Apagamos modulador
        bDeboPitar=0;                                       // Indico que no debe pitar
        i32ContadorPitido=0;                                // Inicializo el contador de pitido
    }
}

#separate
void ControlSonidoSinTimer(int1 control){   

    int16 i16RawSonido;                                     // Vriable auxiliar cálculo
    
    if (control){                                           // Si se ha activado el sonido
        if (i16nivel_son!=0){                               // Mientras en nivel de sonido sea distinto de 0
            i16RawSonido=i16nivel_son*4.5;                  // Calculo PWM pito
            set_pwm7_duty(i16RawSonido);                    // Fijo el PWM que controla el pito
            CCP7CON=0x0C;                                   // Enciendo el modulador
        }                               
    }else{                                                  // En caso de querer apagarlo
        CCP7CON=0x00;                                       // Apagamos modulador
    }
}

/*
*   Función: ControlSonidoObligatorio
