int32 calculoJulios(int16 i16Volt, int16 i16Current){

   float fRaw=0;
      
   fRaw=((float)i16Volt*i16Current)/1000000.0;
      
   return (int32)fRaw;
}

//#separate
int32 calculoJuliosRampa(int16 i16Volt, int16 i16Current){            // Bloque de calculo en julios para galvanica en rampa
      
   float fRaw=0;

   fRaw=((float)i16Volt*i16Current)/1000000.0;
   fRaw/=2;

   return (int32)fRaw;
}
