#separate
int1 limiteDensidadCorriente(int1 bLimitacion){
    
    int1 bReturn;                                               // Variable de retorno
    int16 i16Operacion=(i16ITrans*50)/i8SuperficieElectrodo;    // Variable cálculo de operaciones
    
    if(i16Operacion >= LIMITE_DENSIDAD_CORRIENTE){              // Si el valor de la operación es superior o iguak al LIMITE_DENSIDAD_CORRIENTE
        if(i16Operacion > LIMITE_DENSIDAD_CORRIENTE){           // Si el valor de la operación es superior al LIMITE_DENSIDAD_CORRIENTE
            if(bLimitacion==LIMIT_CORRIENTE){                   // Si estamos limitando por corriente
                if(i16ITrans>20){                               // Si el valor de corriente seleccionado es superior a 1mA
                    i16ITrans--;                                // Reduzco el valor de corriente en uno (de esta forma se reducen 100uA contando con el siguiente decremento (2*50uA))
                }
                i16ITrans--;                                    // Reduzco el valor de corriente en uno
            }else if(bLimitacion==LIMIT_SUPERFICIE){            // Si estamos limitando por superficie de electrodo
                i8SuperficieElectrodo++;                        // Incremento en uno el valor de superficie
            }
        }
        bReturn=1;                                              // Indico que se ha realizado una limitación
    }else{                                                      // Si no hay que limitar
        bReturn=0;                                              // Indico que no se ha limitado
    }

    return bReturn;                                             // Devuelvo estado
}

