    int8 i8ContadorPosicionesFIFOTiempo=0;                  // Variable auxiliar para el contador de posiciones de la FIFO
    int8 i8CanalParaApagar=0;                               // Variable auxiliar para indicar que canal apagar
    int1 bApagadaoCanalEnPantalla=0;                        // Variable auxiliar para indicar el apagado de canal en pantalla actual (Por ejemplo, electro ABC activados, en pantalla B, quiero apagar B)
    
    if(input_state(SINC_COMMS) == MANDA_SAURON){            // Si es el turno de Sauron para mandar
        for(int8 i8Cont=structFIFO.sti8Inicio; i8Cont<structFIFO.sti8Final; i8Cont++){  // Recorre todo el buffer 
            restart_wdt_hw();                                                   // Inicializamos WDT HW
            bEsperandoACK=1;                                                    // Activo flag de espera de ACK
            if(structFIFO.sti8FIFO[i8Cont]<=MODO_DOS_PAQ){                      // Si estamos en modo de dos paquetes
                if(structFIFO.sti8FIFO[i8Cont]==MODO_START_STOP){               // Si es un paquete de START_STOP (Son especiales popr el tema del tiempo)
                    if(i8EspecialTiempo>0){                                                         // Si hay algun paquete que se ha de enviar porque se apaga o enciende por tiempo
                        if(i8Cont==i8FIFOPosTiempo[i8ContadorPosicionesFIFOTiempo]){                // Si la posicion de la fifo que estamos leyendo coincide con la posición de la fifo en la que se tiene que hacer un apagado o encendido especial
                            i8RawAux=i8ConfigCanal;                                                 // Hago trasvase de variables
                            i8ConfigCanal=i8ConfigCanalTiempo[i8ContadorPosicionesFIFOTiempo];      // Para que le ponga el canal que tiene que apagar 
                            
                            envioDatos(structFIFO.sti8FIFO[i8Cont],structFIFO.sti8FIFO2[i8Cont]);   // Envio los datos con los dos paquetes de información necesarios
                            i8CanalParaApagar=i8ConfigCanal;                                        // Indico el canal que se ha de apagar

                            i8ConfigCanal=i8RawAux;                                                 // Hago de nuevo el trasvase de variable

                            i8ContadorPosicionesFIFOTiempo++;                                       // Incremento contador del indice de posiciones de la fifo
                            
                            bApagadaoCanalEnPantalla=0;                                             // Inicializo flag apagado canal pantalla
                        }else{                                                                      // Si se trata de un apagado o encendido normal
                            envioDatos(structFIFO.sti8FIFO[i8Cont],structFIFO.sti8FIFO2[i8Cont]);   // Envio los datos con los dos paquetes de información necesarios
                            i8CanalParaApagar=i8ConfigCanal;                                        // Indico el canal que se ha de apagar
                            bApagadaoCanalEnPantalla=1;                                             // Activo flag apagado canal pantalla
                        }
                    }else{                                                                          // Si es un apagado o encendido normal
                        envioDatos(structFIFO.sti8FIFO[i8Cont],structFIFO.sti8FIFO2[i8Cont]);       // Envio los datos con los dos paquetes de información necesarios
                        i8CanalParaApagar=i8ConfigCanal;                                            // Indico el canal que se ha de apagar
                        bApagadaoCanalEnPantalla=1;                                                 // Activo flag apagado canal pantalla
                    }

                    if(structFIFO.sti8FIFO2[i8Cont]==COMANDO_STOP || structFIFO.sti8FIFO2[i8Cont]==COMANDO_START_PAUSA){    // Si se ha enviado un paquete de STOP o PAUSA
                        if(bTratamientoTBActivado){                                                // Si se trata de un tratamiento TB
                            apagadoTB();                                                           // Apago canal TB
                            iMenuActual=180;                                                        // Vuelvo al menú de tratamiento configurado no activado
                        }else if(bTratamientoGalvanicaActivado){                                    // Si se trata de un tratamiento galvánica
                            apagadoGalvanica();                                                     // Apago canal galvánica
                            iMenuActual=120;                                                        // Vuelvo al menú de tratamiento configurado no activado
                        }else if(bMicrocorrientesEncendido){                                        // Si se trata de un tratamiento Microcorrientes
                            apagadoMicrocorrientes();                                               // Apago canal Microcorrientes
                            iMenuActual=120;                                                        // Vuelvo al menú de tratamiento configurado no activado
                        }else if(bTratamientoTranscranealActivado){                                 // Si se trata de un tratamiento Transcraneal 
                            apagadoTranscraneal();                                                  // Apago canal Transcraneal 
                            iMenuActual=130;                                                        // Vuelvo al menú de tratamiento configurado no activado 
                        }else{                                                                      // Si se trata de un tratamiento de electroestimulación
                            if(bPausaTratamiento){                                                  // Si intentamos pausar
                                apagadoCHA();                                                       // Apagado canal A
                                apagadoCHB();                                                       // Apagado canal B
                                apagadoCHC();                                                       // Apagado canal C
                                bPausaTratamiento=0;                                                // Inicializo flag pausa
                                iMenuActual=140;                                                    // Vuelvo al menú de tratamiento configurado no activado 
                            }else{                                                                  // Si intentamos apagar un canal
                                switch(i8CanalParaApagar){                                          // Dependiendo del canal elegido
                                    case CHA_C:                                                     // Canal A
                                        apagadoCHA();                                               // Apagado Canal A
                                        break;                                                      
                                    case CHB_C:                                                     // Canal B
                                        apagadoCHB();                                               // Apagado Canal B
                                        break;                                                      
                                    case CHC_C:                                                     // Canal C
                                        apagadoCHC();                                               // Apagado Canal C
                                        break;                                                      
                                    case POINTER_C:                                                 // Pointer
                                        apagadoCHA();                                               // Apagado Pointer
                                        break;                                                      
                                }
                                if(bApagadaoCanalEnPantalla){                                       // Si estamos apgando el canal que se muestra en pantalla
                                    iMenuActual=140;                                                // Vuelvo al menú de tratamiento configurado no activado 
                                }
                            }
                        }
                        bEvitaRebotePausa=0;                                                        // Inicializa flag evita rebotes
                    }
                }else{                                                                              // Si es un paquete normal de dos datos que no sea de encendido o apagado  
                    envioDatos(structFIFO.sti8FIFO[i8Cont],structFIFO.sti8FIFO2[i8Cont]);           // Envio los datos con los dos paquetes de información necesarios
                }
            }else{                                                                                  // Si estamos en modo de dos paquetes
                envioDatos(structFIFO.sti8FIFO[i8Cont]);                                            // Envio el dato con el paquete que toca
            }
            structFIFO.sti8Inicio++;                                                                // Recorro hasta la siguiente posición de la FIFO
        }

        bEsperandoACK=0;                                                                            // Inicializo flag de espera de ACK

        if(structFIFO.sti8Inicio>=structFIFO.sti8Final){                                            // Si ya ha recorrido todo el buffer, limpialo
            initFIFO();                                                                             // Inicializo la FIFO
            i8EspecialTiempo=0;                                                                     // Inicializo flag apagado por tiempo
        }

        if(bHeDetectadoMovimiento){                                                                 // Si el error es por un acelerón
            bHeDetectadoMovimiento=0;                                                               // inicializo flag detectado movimiento
        }
    }
}

