                            enviaPaquete(MODO_ACK,MODO_ERRORES);                                    // Envia ACK paquete ERRORES 
                            result=(*funcArr_menu[iMenuActual])();                                  // Me voy al menú
                            iMenuActual=0;                                                          // Voy al menú principal
                            giPos=0;                                                                // Inicializo variable posición
                            bRefrescoPantalla=1;                                                    // Refresco la pantalla
                            result=(*funcArr_menu[iMenuActual])();                                  // Me voy al menú 
                        }

                    }else{                                                                          // Si ya no hay ningún error...
                        if(TRATAMIENTO_ELECTRO==i8TratamientoSeleccionado){                         // Si el tratamiento seleccionado es el de electroestimulación
                            if(i8CanalesActivados){                                                 // Si el tratamiento se encuentra activado
                                iMenuActual=141;                                                    // Selecciono el menú de tartaiento activo
                                
                                bErrorElectrodo[CHA_C]=0;                                           // Pongo a cero el valor de error de electrodo 
                                bErrorElectrodo[CHB_C]=0;
                                bErrorElectrodo[CHC_C]=0;
                                
                                
                                switch(i8CanalesActivados){                                         // Dependiendo del modo de canales elegido...
                                    case CANALES_A:                                                 // Canal A
                                        enciendeLEDVerde(led_CHA);                                  // Enciendo LED verde
                                        break;
                                    case CANALES_B:                                                 // Canal B
                                        enciendeLEDVerde(led_CHB);                                  // Enciendo LED verde
                                        break;
                                    case CANALES_C:                                                 // Canal C
                                        enciendeLEDVerde(led_CHC);                                  // Enciendo LED verde
                                        break;
                                    case CANALES_AB:                                                // Canal A y B
                                        enciendeLEDVerde(led_CHA);                                  // Enciendo LED verde
                                
                                        enciendeLEDVerde(led_CHB);                                  // Enciendo LED verde
                                        break;
                                    case CANALES_BC:                                                // Canal B y C
                                        enciendeLEDVerde(led_CHB);                                  // Enciendo LED verde
                                
                                        enciendeLEDVerde(led_CHC);                                  // Enciendo LED verde
                                        break;
                                    case CANALES_AC:                                                // Canal A y C
                                        enciendeLEDVerde(led_CHA);                                  // Enciendo LED verde
                                    
                                        enciendeLEDVerde(led_CHC);                                  // Enciendo LED verde
                                        break;
                                    case CANALES_ABC:                                               // Canal A, B y C
                                        enciendeLEDVerde(led_CHA);                                  // Enciendo LED verde
                                
                                        enciendeLEDVerde(led_CHB);                                  // Enciendo LED verde
                                        
                                        enciendeLEDVerde(led_CHC);                                  // Enciendo LED verde
                                        break;
                                    case CANALES_BP:                                                // Canal B y Pointer
                                        enciendeLEDVerde(led_CHB);                                  // Enciendo LED verde
                                        break;
                                    case CANALES_CP:                                                // Canal C y Pointer
                                        enciendeLEDVerde(led_CHC);                                  // Enciendo LED verde
                                        break;
                                    case CANALES_BCP:                                               // Canal B, C y Pointer
                                        enciendeLEDVerde(led_CHB);                                  // Enciendo LED verde
                                        
                                        enciendeLEDVerde(led_CHC);                                  // Enciendo LED verde
                                        break;
                                }   // Cierre switch case canales LEDs
                            }   // Cierreif tratamiento activado
                        }else if((TRATAMIENTO_GALVANICA == i8TratamientoSeleccionado) || (TRATAMIENTO_MICROCORRIENTES == i8TratamientoSeleccionado)){               // Si se encuentra en tratamiento de galvámica/galv+micro
                            iMenuActual=121;                                                // Selecciono el menú de tartamiento activo
                            
                            bErrorElectrodo[CHB_C]=0;                                       // Limpio el flag de error de electrodo
                            
                            enciendeLEDVerde(led_GALV);                                     // Enciendo LED verde
                        }else if(TRATAMIENTO_TB == i8TratamientoSeleccionado){             // Si se encuentra en tratamiento de TB
                            iMenuActual=181;                                                // Selecciono el menú de tartamiento activo
                                                                                                                                               
                            bErrorElectrodo[CHC_C]=0;                                       // Limpio el flag de error de electrodo    
                                                                                                                                               
                            enciendeLEDVerde(led_CHC);                                      // Enciendo LED verde               
                            
                        }else if(TRATAMIENTO_TRANSCRANEAL == i8TratamientoSeleccionado){    // Si se encuentra en tratamiento de galvámica
                            iMenuActual=131;                                                // Selecciono el menú de tratamiento activo
                            
                            bErrorElectrodo[CHB_C]=0;                                       // Limpio el flag de error de electrodo
                            
                            enciendeLEDVerde(led_GALV);                                     // Enciendo LED verde
                        }   // Cierre if-else errores ocurridos
                    }

                    enviaPaquete(MODO_ACK,MODO_ERRORES);                                    // Envia ACK paquete ERRORES

                    break;
                case MODO_CONTROL_TIEMPO:                                                   // Si se ha recibido un paquete de control de tiempo
                    
                    if(!bEmpiezaContadorTiempo){                                            // Si no ha empezado el momento de contar el tiempo
                        var_tiempo=0;                                                       // Inicializo el valor del contador
                        if(iMenuActual==121 || iMenuActual==131 || iMenuActual==181){       // Si estamos en galv/galv+micro/transcraneal/TB activo
                            if(i16TimeRaw[0]!=0){                                           // Mientras el tiempo sea distinto de cero
                                i16TimeRaw[0]--;                                            // Resto un segundo
                            }
                        }else if(iMenuActual==141){                                         // Si estamos en electroestimulación activa
                            i16TimeRaw[i8ConfigCanal]--;                                    // Resto un segundo
                        }
                    }

                    int8 i8RawTest;                                                         // Variable raw struct
                    
                    i8RawTest=structControlTiempo.sbValorAlcanzado[structControlTiempo.si8CanalTiempo];     // Guarda en variable auxiliar
                    bValorAlcanzado[structControlTiempo.si8CanalTiempo]=i8RawTest;                          // Para asignarla luego a variable local (si se hacia directo, da problemas al venir de una struct)
                    
                    bEmpiezaContadorTiempo=structControlTiempo.sbEmpiezaContadorTiempo;     // Copia el valor de la struct a la varibale global del programa

                    if(bValorAlcanzado[structControlTiempo.si8CanalTiempo]){                // Si ha alcanzado el valor de corriente de tratamiento
                        pitidoCorto();                                                      // Realiza un pitido corto
                    }
                    
                    structControlTiempo.sbEmpiezaContadorTiempo=0;                          // Inicializa flag contador tiempo
                    bPrimeraMedida=1;                                                       // Indica que se trata de la primera medida
                    bBloqueoPulsador=0;                                                     // Inicializa bloqueo del pulsador
                    break;
                case MODO_CONEXION_POINTER:                                                 // Si se ha conectado o desconectado el pointer
                    if(bPointerConectado){                                                  // Si se ha conectado
                        control_led(0,rojo,led_CHA);                                        // LED Rojo apagado
                        control_led(1,verde,led_CHA);                                       // LED Verde encendido
                        pitidoPointerConectado();                                           // Realiza un pitido corto
                    }else{                                                                  // Si se ha desconectado
                        control_led(0,verde,led_CHA);                                       // LED Verde Apagado
                        control_led(1,rojo,led_CHA);                                        // LED Rojo Encendido
                        pitidoPointerDesconectado();                                        // Realiza un pitido largo
                    }
                    break;
                case MODO_CHECK_INICIAL:                                                    // Modo check inicial                                          
                    // No hacer nada
                    break;
            }   // Cierre switch tipo paquete
        }   // Cierre if lectura paquete
    }   // Cierre if dato recibido
}

#separate
void deteccionTeclaPulsada(){
    if(bUnaPulsacion){                      // Si se ha detectado una pulsación - Activo por flanco, no por nivel
        bUnaPulsacion=0;                    // Inicializo el valor de pulsaciones

        pitidoTecla();                      // Realiza pitido tecla
        
        restart_wdt_hw();                   // Inicializa WDT HW
        
        if((i8CanalesActivados==0)&&((iMenuActual!=141)&&(iMenuActual!=142)&&(iMenuActual!=181)&&(iMenuActual!=121)&&(iMenuActual!=131)&&(iMenuActual!=200))){      // Si no está realizando ningun tratamiento
            var_tiempo=0;                   // Reinicia la variable tiempo para el autoapagado
        }
        
        if(iMenuActual==200){               // Si estamos en el menú de autoapagado
            if(itecla!=5){                  // Cualquier tecla que no sea la de start/stop, debe de estar deshabilitada
                itecla=0;                   // Desactivo tecla
            }
        }

        clear_interrupt(INT_EXT3_H2L);      // Limpia interrupción pulsadores
        enable_interrupts(INT_EXT3_H2L);    // Habilita interrupción pulsadores
    }
}

#separate
void teclaArribaPulsada(){
    if(itecla==1){                                          // Si se ha presionado la tecla 1
        bRefrescoPantalla=1;                                // Activo flag de refresco de pantalla
        var_puls=1;                                         // Indicamos quen se ha pulsado la tecla 1
        bascendente=1;                                      // Indicamos que se trata de la tecla ascendente activando el flag
        restart_wdt_hw();                                   // Inicializa WDT HW

        if (iMenuActual==141 || iMenuActual==121 || iMenuActual==131){          // Si está en tratamiento de electroestimulacion o galvanica
            if(iMenuActual==121){                                               // Si estamos en tratamiento de galvánica
                bTerapiaLeida=structMedidasGalvanica.sbTerapiaLeida;            // Indica que se ha leido variable de terapia en el secundario
                if((bTerapia==bTerapiaLeida && i16TimeRaw[0]>TIEMPO_BLOQUEO_RULANCHA) || i16TGalv[bSeleccionGalvanica]==0){ // 
                    if(!bTerapia){                                              // Si estamos en galvánica

                        if(bValorAlcanzado[GALVANICA_C]){                       // Si se ha alcanzado el valor de corriente deseado
                             
                            incrementoCorriente();                              // Incrementa la corriente
                            
                            if(bCableBipolarConectado){                         // Si está el accesorio bipolar conectado
                                i16LimiteCorrienteGalvanica=MAXIMA_CORRIENTE_GALVANICA_BIPOLAR; // Limito corriente a MAXIMA_CORRIENTE_GALVANICA_BIPOLAR
                            }else{                                              // Si no...
                                i16LimiteCorrienteGalvanica=MAXIMA_CORRIENTE_GALVANICA;         // Limito corriente a MAXIMA_CORRIENTE_GALVANICA
                            }
                            
                            if ((giPos>=i16LimiteCorrienteGalvanica)){          // Si estamos en terapia de galvanica y llegamos al límite de corriente
                                giPos=i16LimiteCorrienteGalvanica;              // Fijamos el máximo nivel de corriente a (200*50) = 10000uA = 10mA
                                bMAXRulancha[CHB_C]=1;                          // Indico MAX Value
                                f_avisos();                                     // Actualizo avisos
                            }

                            i16IGalv[bSeleccionGalvanica]=giPos;                // Asigno el valor de gipos a la corriente
                            
                            i16DecrementoCargaGalvanica=i16IGalv[bSeleccionGalvanica]*50;   // Asigno nuevo decremento de la carga galvánica
                            
                            if(i16TGalv[bSeleccionGalvanica]!=0){               // Si el tiempo de tratamiento es distinto de 0 (infinito)
                                i16TimeRaw[0]=calc_Tgalv(i32CargaGalvanicaRestante,i16IGalv[bSeleccionGalvanica]);  // Calculo el nuevo tiempo de carga
                            }
                            bCambiado=1;                                        // Indico que se ha modificado el nivel de corriente durante el tratamiento
                        }
                    }else{                                                      // Si estamos en microcorrientes
                        incrementoCorriente();                                  // Incremento corriente

                        if ((giPos>=MAXIMA_CORRIENTE_MICROCORRIENTES)&&(bTerapia==1)){  // Si estamos en terapia de microcorrientes y la coreinte es superior a (100*50) = 5000uA = 5mA
                            giPos=MAXIMA_CORRIENTE_MICROCORRIENTES;             // Fijamos el máximo nivel de corriente a (100*50) = 5000uA = 5mA 
                            bMAXRulancha[CHB_C]=1;                              // Indico MAX Value
                            f_avisos();                                         // Actualizo avisos
                        }
                        
                        i16Imicro=giPos;                                        // Asigno el valor de gipos a la corriente
                        bCambiado=1;                                            // Indico que se ha modificado el nivel de corriente durante el tratamiento
                        bEmpiezaContadorTiempo=1;                               // Pone el contador de tiempo activo (en realidad no hace falta, ya esta activado anteriormente!??)
                    }
                }
            }else if(iMenuActual==131){                                         // Menu transcraneal
                if( (i16TimeRaw[0]>TIEMPO_BLOQUEO_RULANCHA_TRANSCRANEAL) || i16TTrans==0 ){ // Si estamos en tiempo ilimitado o tiempo mayor que TIEMPO_BLOQUEO_RULANCHA_TRANSCRANEAL
                    if(bValorAlcanzado[GALVANICA_C]){                           // Si se ha alcanzado el valor de corriente deseado
                        incrementoCorriente();                                  // Incremento corriente

                        max=(int16)i8SuperficieElectrodo*LIMITE_DENSIDAD_CORRIENTE; // Calculo máximo valor de corriente
                
                        if(max>=1000){                          // Si es superior a 1000uA
                            max/=100;                           // Divide entre 100
                            max*=100;                           // Multiplica por 100 para redondear en pasos de 100
                        }
                        max/=50;                                // Saltos de 50
                        
                        if(max>=MAXIMA_CORRIENTE_TRANSCRANEAL){ // Si la corrente seleccionada es superior a MAXIMA_CORRIENTE_TRANSCRANEAL
                            max=MAXIMA_CORRIENTE_TRANSCRANEAL;  // Asigna MAXIMA_CORRIENTE_TRANSCRANEAL
                        }
                       
                        
                        if (giPos>=max){                        // Si es valor de corriente es superior al máximo fijado
                            giPos=max;                          // Asigno máximo
                            bMAXRulancha[CHB_C]=1;              // Indico flag MAX Value
                            f_avisos();                         // Actualizo avisos
                        }
                        
                        i16ITrans=giPos;                        // Asigno el valor de gipos a la corriente
                        
                        i16DecrementoCargaTranscraneal=i16ITrans*50;    // Asigno nuevo decremento de la carga galvánica
                        
                        if(i16TTrans!=0){                       // Si el tiemp ode tratamiento es distinto de 0 (infinito)
                            i16TimeRaw[0]=calc_Tgalv(i32CargaTranscranealRestante,i16ITrans);   // Calculo el nuevo tiempo de carga
                        }
                        bCambiado=1;                            // Indico que se ha modificado el nivel de corriente durante el tratamiento
                    }
                }
            }else{                                              // Si está en tratamiento de electroestimulacion
                if(bValorAlcanzado[i8ConfigCanal] && i16TimeRaw[i8ConfigCanal]>TIEMPO_BLOQUEO_RULANCHA){ 
                    giPos=i16IElec[i8ConfigCanal];              // Asigno el valor de la corriente a giPos
                    giPos+=2;                                   // Aumento el contador (aumenta corriente e tratamiento activo)
                       
                    if(giPos>=MAXIMA_CORRIENTE_ELECTROESTIMULACION){    // Si estamos en terapia de electroestimulación y la corriente es superior a (290*50) = 14500uA = 14.5mA
                        giPos=MAXIMA_CORRIENTE_ELECTROESTIMULACION;     // Fijamos el máximo nivel de corriente a (290*50) = 14500uA = 14.5mA
                        bMAXRulancha[i8ConfigCanal]=1;          // Indico flag MAX Value
                        f_avisos();                             // Actualizo avisos
                    }
                    
                    i16IElec[i8ConfigCanal]=giPos;              // Asigno el valor de gipos a la corriente
                    bCambiado=1;                                // Indico que se ha modificado el nivel de corriente durante el tratamiento
                }
            }
        }else if (iMenuActual==181){                            // Si estamos entratamiento TB
            giPos++;                                            // Aumento la corriente o pulsos en factor de 1
            
            if (giPos>=MAX_CORRIENTE_TB){                   // Si supera los 14.5mA (290*50)
                giPos=MAX_CORRIENTE_TB;                     // Fija a 14.5 mA
                bMAXRulancha[CHC_C]=1;                          // Indico flag MAX Value
                f_avisos();                                     // Actualizo avisos
            }

            i16CorrienteTB=giPos;                                  // Asigno el valor de corriente
            
            bCambiado=1;                                        // Indica que se ha realizado u cambio en la corriente o pulsos de TB, para poder enviarlo a orco
        }else if(iMenuActual==120 || iMenuActual==130 || iMenuActual==140 || iMenuActual==180){     // Si estamos  en el menú de antes de empezar el tratamiento
            // No hagas nada
        }else{                                                                  // ...si no está en tratamiento
            if ((iMenuActual%10==0)&&(iMenuActual<95)&&(iMenuActual!=50)){      // Si está en un menú principal y es menor que los menús 7x
                if(bModoRulancha && (iMenuActual==20 || iMenuActual==30 || iMenuActual==40 || iMenuActual==80)){   // Si la rulancha ha sido movida y estamos en los menús de configuración de tratamiento 
                    if(!((iMenuActual==20 && giPos==10) || (iMenuActual==30 && giPos==9) || (iMenuActual==40 && giPos==13) || (iMenuActual==80 && giPos==10))){    // Mientras que no estemos encima de la opción de Configurar Tratamiento
                        if(iMenuActual==40 && giPos==6){                        // Si estamos el menú de configuración de corriente
                            giPosRulancha+=2;                                   // Incrementos en pasos de 2 (nivel de corriente aumenta de 100 en 100) 2*50
                        }else{                                                  // Si no...
                            if(iMenuActual==20 && (giPos==1 || giPos==4)){                      // Si estamos en config galvánica/galv+micro y modificando corriente
                                (giPosRulancha<20) ? (giPosRulancha++) : (giPosRulancha+=2);    // Si la corriente es inferior a 1000uA, saltos de 50uA, si no, de 100uA
                            }else if(iMenuActual==30 && giPos==1){                              // Si estamos en config transcraneal modificando corriente
                                (giPosRulancha<20) ? (giPosRulancha++) : (giPosRulancha+=2);    // Si la corriente es inferior a 1000uA, saltos de 50uA, si no, de 100uA
                            }else{                                                              // Para todo los demás...
                                giPosRulancha++;                                                // Aumenta en pasos de uno
                            }
                        }
                    }
                }else{                                                                  // Si no se utiliza la rulancha para modificar el valor...
                    if (giPos==0){                                                      // Si giPos es igual a 0...
                        giPos=0;                                                        // No bajes de ahi
                    }else{                                                              // ...si no es igual a cero
                        giPos--;                                                        // Decrementa giPos
                        switch (iMenuActual){                                           // Dependiendo del menú actual
                            case 20:                                                    // Galvánica + microcorrientes
                                switch(giPos){                                          // Dependiendo del menú sobre en el que estemos
                                    case 1:                                             // Configuracion corriente electrica galvanica  
                                        giPosRulancha=i16IGalv[bSeleccionGalvanica];    // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 2:                                             // Configuracion tiempo galvanica               
                                        giPosRulancha=i16TGalv[bSeleccionGalvanica];    // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 3:                                             // Configuracion Tiempo de rampa galvanica      
                                        giPosRulancha=i8TrampaGalv[bSeleccionGalvanica];// Inicializo la rulancha con el valor del menú
                                        break;
                                    case 4:                                             // Configuracion corriente microcorrientes micro
                                        giPosRulancha=i16Imicro;                        // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 5:                                             // Configuracion Tiempo activo microcorriente   
                                        giPosRulancha=i16Tmicro/5;                      // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 6:                                             // Configuracion de polaridad    
                                        giPosRulancha=(bPolaridadMicro<<1)|(bMonopolarPosNeg);  // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 7:                                             // Configuracion ancho de pulso microcorrientes 
                                        giPosRulancha=i16PWmicro/25;                    // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 8:                                             // Configuracion frecuencia microcorrientes    
                                        if(!bSeleccionGalvanica){                               // Si estamos en galvánica
                                            giPosRulancha=i8TrampaGalv[bSeleccionGalvanica];    // Inicializo la rulancha con el valor del menú
                                        }else{                                                  // Si estamos en microcorrientes
                                            giPosRulancha=i16frecmicro;                         // Inicializo la rulancha con el valor del menú
                                            i16FrecuenciaAnterior=i16frecmicro;                 // Inicializo la frecuencia con el valor anterior (cambio de frecuencia/saltos en menú)
                                        }
                                        break;
                                }
                                break;
                            case 30:                                            // Transcraneal
                                switch(giPos){                                          // Dependiendo del menú sobre en el que estemos
                                    case 1:                                             // Configuracion corriente electrica trans  
                                        giPosRulancha=i16Itrans;                        // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 2:                                             // Configuracion tiempo trans               
                                        giPosRulancha=i16Ttrans/SALTOS_TIEMPO_TRANSCRANEAL; // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 3:                                             // Configuracion Tiempo de rampa trans      
                                        giPosRulancha=i8Trampatrans;                    // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 4:                                             // Configuracion Superficie Electrodo 
                                        giPosRulancha=i8SuperficieElectrodo;            // Inicializo la rulancha con el valor del menú
                                        break;
                                }
                                break;
                            case 40:                                            // Electroestimulación + Pointer
                                switch(giPos){                                          // Dependiendo del menú sobre en el que estemos
                                    case 2:                                             // Configuracion tiempo activo              
                                        giPosRulancha=i16TacElec[i8ConfigCanal]/5;      // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 3:                                             // Configuracion tiempo descanso            
                                        giPosRulancha=i16TdElec[i8ConfigCanal]/5;       // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 4:                                             // Configuracion tiempo rampa               
                                        giPosRulancha=i8TrElec[i8ConfigCanal];          // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 5:                                             // Configuracion número de repeticiones   
                                        if(i16TdElec[i8ConfigCanal]!=0){                // Si hay tiempo de descanso (es decir, hay repeticiones configuradas)
                                            giPosRulancha=i8Nrep[i8ConfigCanal];        // Inicializo la rulancha con el valor del menú
                                        }else{                                          // Si no hay tiempo de descanso definido...
                                            giPosRulancha=i8TrElec[i8ConfigCanal];      // Inicializo la rulancha con el valor del menú
                                        }
                                        break;
                                    case 6:                                             // Configuracion de corriente de tratamiente
                                        giPosRulancha=i16IElec[i8ConfigCanal];          // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 7:                                             // Configuracion de frecuencia        
                                        
                                        giPosRulancha=i16frecElec[i8ConfigCanal]/gF;    // Inicializo la rulancha con el valor del menú
                                        i16FrecuenciaAnterior=i16frecElec[i8ConfigCanal];   // Inicializo la frecuencia con el valor anterior (cambio de frecuencia/saltos en menú)
                                        break;
                                    case 8:                                             // Configuracion de polaridad 
                                        giPosRulancha=bpolaridadElec[i8ConfigCanal];    // Inicializo la rulancha con el valor del menú
                                        break;
                                    case 9:                                                     // Configuracion de simetria  
                                        if(i8ConfigCanal==POINTER_C){                           // Si estamos configurando el pointer
                                            giPosRulancha=i16frecElec[i8ConfigCanal]/gF;        // Inicializo la rulancha con el valor del menú
                                            i16FrecuenciaAnterior=i16frecElec[i8ConfigCanal];   // Inicializo la frecuencia con el valor anterior (cambio de frecuencia/saltos en menú)
                                            giPos=7;                                            // Salta hasta el menú de frecuencia
                                        }else{                                                  // Si no...            
                                            if(bpolaridadElec[i8ConfigCanal]){                  // Si al señal es bipolar
                                                giPosRulancha=bsimetriaElec[i8ConfigCanal];     // Inicializo la rulancha con el valor del menú
                                            }else{                                              // Si es monopolar
                                                giPosRulancha=bpolaridadElec[i8ConfigCanal];    // Inicializo la rulancha con el valor del menú
                                            }
                                        }
                                        break;
                                    case 10:                                            // Configuracion del PW +         
                                        giPosRulancha=i16PW_plusElec[i8ConfigCanal]/25; // Inicializo la rulancha con el valor del menú
