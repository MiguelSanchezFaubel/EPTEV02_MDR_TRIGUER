    output_low(PWM_PITO);
    
    output_low(PGM_D_1);
    output_low(SINC_RDA);
    output_low(SINC_TIMER);
    
    output_low(TX_ORCO_SAURON);
    output_low(TX_TEST_1);
    output_low(RX_TEST_1);
    
    restart_wdt();                                      // Reinicio contador WDT

    bcargador=1;                                        // Indica que el cargador se encuentra conectado

    output_high(LED_CHG_R);                             // Enchufo el LED de carga

    iMenuActual=204;                                    // Selecciono el menú de carga
    result=(*funcArr_menu[iMenuActual])();              // Me voy al menú de carga   
