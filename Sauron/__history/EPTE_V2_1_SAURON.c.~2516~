/*
*   Función: calculoTiempoDesfase
*   Descripción: Calcula el tiempo de desfase. Siempre da el mínimo desfase permitido
*        
*   Input:
*       - 
*   Output:
*       -
*/
void calculoTiempoDesfase(){
    int8 i8Multiplicador=1;                                                                                 // Definición de la variable multiplicador (por si la señal es bipolar)
    
    if ( (i8CanalesActivados==CANALES_AB) || (i8CanalesActivados==CANALES_AC) ||  (i8CanalesActivados==CANALES_ABC) ){      // Si estamos en un modo donde el primer canal es el A (Cálculo primer desfase)
        if(bPolaridadElec[CHA_C]){                                                                          // Si la señal es bipolar
            i8Multiplicador=2;                                                                              // Ponemos el multiplicador a dos
        }
        i16TfElec12=i16PW_plusElec[CHA_C]+i16PW_minusElec[CHA_C]+i8Multiplicador*BANDA_GUARDA;              // Se asigan el valor mínimo
    }else if (i8CanalesActivados==CANALES_BC){                                                              // Si estamos en un modo donde el primer canal es B
        if(bPolaridadElec[CHB_C]){                                                                          // Si la señal es bipolar                                   
            i8Multiplicador=2;                                                                              // Ponemos el multiplicador a dos                        
        }                                                                                                                                                               
        i16TfElec12=i16PW_plusElec[CHB_C]+i16PW_minusElec[CHB_C]+i8Multiplicador*BANDA_GUARDA;              // Se asigan el valor mínimo         
    }
    
    if(i8CanalesActivados==CANALES_ABC){                                                                    // Si estamos en el modo de tres canales (Cálculo segundo desfase)
        if(bPolaridadElec[CHB_C]){                                                                          // Si la señal es bipolar                                   
            i8Multiplicador=2;                                                                              // Ponemos el multiplicador a dos                                                  
        }                                                                                                                                                               
        i16TfElec23=i16PW_plusElec[CHB_C]+i16PW_minusElec[CHB_C]+i8Multiplicador*BANDA_GUARDA;              // Se asigan el valor mínimo 
    }
}

/*
*   Función: delay_ms_wdt
*   Descripción: Función utilizada para hacer un delay sin que el WDG externo reinicie el microcontrolador,
*       debido a que si se usa un delay que supera el tiempo de refresco del WDG, se podria reiniciar
*        
*   Input:
*       - i16DelayWDT   - Valor en milisegundos (ms) del delay 
*   Output:
*       -
*/
void delay_ms_wdt(int16 i16DelayWDT){
    output_low(W_DOG);                                              // No hace falta poner nigún tipo de delay debido a que así es suficiente para que detyecte el pulso, solo necesita unos pocos ns de pulso
    output_high(W_DOG);
    
    for(int16 i16ContWDT=1; i16ContWDT<=i16DelayWDT; i16ContWDT++){ // En caso de que lo supere, hace delays de un milisegundo hasta alcanzar el valor deseado
        delay_ms(1);                                                
        output_low(W_DOG);                                          // No hace falta poner nigún tipo de delay debido a que así es suficiente para que detyecte el pulso, solo necesita unos pocos ns de pulso
        output_high(W_DOG);
    }
    
}

