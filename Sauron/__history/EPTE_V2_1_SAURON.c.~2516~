            i16FrecElec[CHC_C]=i16FrecElec[CHB_C]=i16FrecElec[CHA_C];               // Copiamos el valor de frecuencia         
                                                                                                                               
            bSimetriaElec[CHC_C]=bSimetriaElec[CHB_C]=bSimetriaElec[CHA_C];         // Copiamos la simetria de señal           
            bPolaridadElec[CHC_C]=bPolaridadElec[CHB_C]=bPolaridadElec[CHA_C];      // Copiamos la polaridad de señal          
            i16PW_plusElec[CHC_C]=i16PW_plusElec[CHB_C]=i16PW_plusElec[CHA_C];      // Copiamos el PW+                         
