#separate
int1 tensionCargadorCorrecta(){

    int1 bReturn=0;                                 // Crea variable de retorno
    int32 i32TensionCargador=0;                     // Variable auxiliar tensión de cargador

    set_adc_channel(ADC_CARGADOR);                  // Fijo canal ADC del cargador
    while(!adc_done());                             // Espero a que el ADC este listo

    i32TensionCargador=read_adc();                  // Leo tensión del cargador
    while(!adc_done());                             // Espero a que el ADC esté listo
    
    i32TensionCargador=0;                           // Inicializo lectura (la lectura anterior es para que despierte el ADC)
    
    for(int8 i8Cont=0; i8Cont<25; i8Cont++){        // Bucle de medidas
        set_adc_channel(ADC_CARGADOR);              // Fijo canal ADC
        while(!adc_done());                         // Espero a que el ADC esté listo

        i32TensionCargador+=read_adc();             // Leo tensión del cargador
        while(!adc_done());                         // Espero a que el ADC esté listo
    }
    
    i32TensionCargador/=25;                         // Obtengo el valor edio de las medias
    
    i32TensionCargador*=(i16ValueRef/4096.0);       // Escalo el valor de las medidas
    
    i32TensionCargador*=2;                          // Multiplico por dos (viene de un divisor de tensión)
    
    if(i32TensionCargador<RANGO_INFERIOR_CARGADOR || i32TensionCargador>RANGO_SUPERIOR_CARGADOR){   // Si la tensión del cargador no es correcta
        bReturn=0;                                  // Devuelvo error en la alimentación
    }else{                                          // Si la tensión es correcta
        bReturn=1;                                  // Devuelvo tensión OK
    }

    return bReturn;                                 // Devuelvo estado
}

