#define EEPROM_GALVMICRO_MICRO_TIEMPO_ACTIVO        EEPROM_GALVMICRO_MICRO_CORRIENTE + OFFSET_INT16     // Dirección Memoria Galvánica + Microcorrientes - Tiempo Activo - 16 bits
#define EEPROM_GALVMICRO_MICRO_POLARIDAD            EEPROM_GALVMICRO_MICRO_TIEMPO_ACTIVO + OFFSET_INT16 // Dirección Memoria Galvánica + Microcorrientes - Polaridad - 8 bits
