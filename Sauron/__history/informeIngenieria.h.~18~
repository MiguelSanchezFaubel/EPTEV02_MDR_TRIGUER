    REG_TIEMPO_CHA=REG_TRAT_SMP+2,              // Registro tiempo de tratamiento electrónica canal A 
    REG_TIEMPO_CHB=REG_TIEMPO_CHA+4,            // Registro tiempo de tratamiento electrónica canal B
    REG_TIEMPO_CHC=REG_TIEMPO_CHB+4,            // Registro tiempo de tratamiento electrónica canal C
    REG_CONT_MAX=REG_TIEMPO_CHC+4,              // Define el final de contadores 
