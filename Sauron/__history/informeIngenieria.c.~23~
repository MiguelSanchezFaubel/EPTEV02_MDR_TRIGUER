void refreshRegError(){
    for(int8 i8Registro=0; i8Registro<REG_ERROR_MAX; i8Registro++){
        write_eeprom(i8Registro,read_eeprom(i8Registro));    // Lee el valor del registro y incrementa el valor, luego lo vuelve a guardar
        pausa_ms(DELAY_ESCRITURA_EEPROM);
        write_eeprom(i8Registro+i8OffsetErrorParcial,read_eeprom(i8Registro+i8OffsetErrorParcial));
        pausa_ms(DELAY_ESCRITURA_EEPROM);
    }
}

void refreshRegCont(){
    for(int8 i8Registro=REG_TRAT_CHA; i8Registro<REG_CONT_MAX; i8Registro++){
        write_eeprom(i8Registro,read_eeprom(i8Registro));    // Lee el valor del registro y incrementa el valor, luego lo vuelve a guardar
        pausa_ms(DELAY_ESCRITURA_EEPROM);
        write_eeprom(i8Registro+i8OffsetContParcial,read_eeprom(i8Registro+i8OffsetContParcial));
        pausa_ms(DELAY_ESCRITURA_EEPROM);
    }
}

void informeIngenieria(){
    muestraRegCont();
    muestraRegError();
}
