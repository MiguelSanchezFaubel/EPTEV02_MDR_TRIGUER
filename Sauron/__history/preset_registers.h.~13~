            i16TGalv[bSeleccionGalvanica]=readEEPROM_16bits(i16DirEEPROM+EEPROM_GALVMICRO_GALV_TIEMPO_ACTIVO);                       // Carga en variable Galvánica + Microcorrientes - Tiempo Activo Galvánica - 16 bits    
            i8TrampaGalv[SELECCIONA_MICRO]=readEEPROM_8bits(i16DirEEPROM+EEPROM_GALVMICRO_GALV_TIEMPO_RAMPA);                     // Carga en variable Galvánica + Microcorrientes - Tiempo Rampa Galvánica - 8 bits
            i16Imicro=readEEPROM_16bits(i16DirEEPROM+EEPROM_GALVMICRO_MICRO_CORRIENTE);                         // Carga en variable Galvánica + Microcorrientes - Corriente - 16 bits
            i16Tmicro=readEEPROM_16bits(i16DirEEPROM+EEPROM_GALVMICRO_MICRO_TIEMPO_ACTIVO);                     // Carga en variable Galvánica + Microcorrientes - Tiempo Activo - 16 bits    
            bPolaridadMicro=readEEPROM_8bits(i16DirEEPROM+EEPROM_GALVMICRO_MICRO_POLARIDAD);                    // Carga en variable Galvánica + Microcorrientes - Polaridad - 8 bits
            i16PWmicro=readEEPROM_16bits(i16DirEEPROM+EEPROM_GALVMICRO_MICRO_ANCHO_PULSO);                      // Carga en variable Galvánica + Microcorrientes - Ancho Pulso - 16 bits    
            i16frecmicro=readEEPROM_16bits(i16DirEEPROM+EEPROM_GALVMICRO_MICRO_FRECUENCIA);                     // Carga en variable Galvánica + Microcorrientes - Frecuencia - 16 bits
            iMenuActual=20;
            bSeleccionGalvanica=1;
            Anterior_giPos[0]=2;
            Anterior_giPos[1]=0;
            giPos=0;
            break;
        case PRESET_TRANSCRANEAL:                                                                       // Variables Transcraneal a memoria
            i16Itrans=readEEPROM_16bits(i16DirEEPROM+EEPROM_TRANSC_CORRIENTE);                                  // Carga en variable Transcraneal - Corriente - 16 bits
            i16TTrans=readEEPROM_16bits(i16DirEEPROM+EEPROM_TRANSC_TIEMPO_ACTIVO);                              // Carga en variable Transcraneal - Tiempo Activo - 16 bits    
            i8TrampaTrans=readEEPROM_8bits(i16DirEEPROM+EEPROM_TRANSC_TIEMPO_RAMPA);                            // Carga en variable Transcraneal - Tiempo Rampa - 8 bits    
            i8SuperficieElectrodo=readEEPROM_8bits(i16DirEEPROM+EEPROM_TRANSC_TAM_ELECTRODO);                   // Carga en variable Transcraneal - Superficie Electrodo - 8 bits
            iMenuActual=30;
            Anterior_giPos[0]=3;
            Anterior_giPos[1]=0;
            giPos=0;
            break;
        case PRESET_SMP:                                                                                // Variables SMP a memoria
            i16TacSMP=readEEPROM_16bits(i16DirEEPROM+EEPROM_SMP_TIEMPO_ACTIVO);                                 // Carga en variable SMP - Tiempo Activo - 16 bits    
            i32TDesfaseSMP=readEEPROM_32bits(i16DirEEPROM+EEPROM_SMP_DESFASE_PULSOS);                           // Carga en variable SMP - Desfase entre pulsos - 32 bits    
            i16FrecSMP=readEEPROM_16bits(i16DirEEPROM+EEPROM_SMP_FRECUENCIA);                                   // Carga en variable SMP - Frecuencia - 16 bits
            i16PWSMP=readEEPROM_16bits(i16DirEEPROM+EEPROM_SMP_ANCHO_PULSO);                                    // Carga en variable SMP - Ancho de pulso - 16 bits    
            iMenuActual=80;
            Anterior_giPos[0]=5;
            Anterior_giPos[1]=0;
            giPos=0;
            break;
    }

    return i8Return;                                                                                    // Devuelve el valor
}

