.................... #separate 
.................... void representarTextoUART(int8 i8PosEnum){ 
....................  
....................     int8 iIndex=0;              // Variable para indicar index 
....................     char sText[65];             // String par alamacenar texto 
....................  
....................     int32 i32Dir=PRIMERA_POS_FAT+i32OffsetDireccionIdioma+(int32)i8PosEnum*TAM_DIR_BYTES;   // Calcula la primera posici�n en la FAT del texto a representar 
....................  
....................     int32 i32Init=lecturaDirFAT(i32Dir);                    // Busca la primera posici�n en la FAT del texto a representar 
....................  
....................     int32 i32Final=lecturaDirFAT(i32Dir+TAM_DIR_BYTES);     // Busca la �ltima posici�n en la FAT del texto a representar 
....................  
....................     for(int32 i32Pos=i32Init; i32Pos<i32Final; i32Pos++){   // Recorre todas las posiciones del texto a representar 
....................         sText[iIndex++]=M25AA1024_read(i32Pos);             // Guarda el texto en la string auxiliar 
....................     } 
....................     sText[iIndex]='\0';                                     // Termina la string con el caracter de terminaci�n 
....................     iIndex=0;                                               // Inicializa variable index 
....................  
....................     fprintf(DEBUG_UART,"%s",sText);                         // Muestra texto por pantalla 
.................... } 
