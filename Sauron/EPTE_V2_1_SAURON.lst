.................... #define COD_B           PIN_B2                      // Pulsos B del codificador rotativo 
.................... #define INT_TECLADO     PIN_B3                      // Interrupci�n en caso de apretar alguno de los pulsadores del equipo 
.................... #define INT_ACEL        PIN_B4                      // Interrupci�n del aceler�metro 
