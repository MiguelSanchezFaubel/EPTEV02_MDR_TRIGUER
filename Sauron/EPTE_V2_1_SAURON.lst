.................... *   Output: 
.................... *         -  
.................... */ 
.................... void ST7529_wakeUp(){ 
....................    SSP2CON1=0xB0; 
....................    SSP2STAT&=~0xC0;  
....................    ST7529_send(COMMAND,SLPOUT); 
....................    ST7529_send(COMMAND,DISON);      // Display On 
.................... } 
