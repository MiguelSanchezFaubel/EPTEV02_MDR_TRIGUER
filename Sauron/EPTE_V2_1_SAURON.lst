....................  
.................... #include "M25AA1024.h" 
.................... /* 
.................... *   File: M25AA1024.h 
.................... *    
.................... *   Descripci�n: Header file del driver para la memoria SPI 25AA1024 de 1Mbit 
.................... *    
.................... *   Versi�n: 2.0 
.................... * 
.................... *   Ionclinics & Deionics SL 
.................... */ 
....................  
.................... /* Definciones */ 
.................... #ifndef   HIGH                  // Si no se ha definido el nivel alto 
....................    #define HIGH   1             // Define nivel alto 
.................... #endif 
....................  
.................... #ifndef   LOW                   // Si no se ha definido el nivel bajo 
....................    #define LOW   0              // Defino nivel bajo 
.................... #endif 
....................  
.................... /* Registros */ 
.................... #define READ      0x03          // Read data from memory array beginning at selected address 
.................... #define WRITE     0x02          // Write data to memory array beginning at selected address 
.................... #define WREN      0x06          // Set the write enable latch (enable write operations) 
.................... #define WRDI      0x04          // Reset the write enable latch (disable write operations) 
.................... #define RDSR      0x05          // Read STATUS register 
.................... #define WRSR      0x01          // Write STATUS register 
.................... #define PEE        0x42          // Page Erase – erase one page in memory array 
.................... #define SE        0xD8          // Sector Erase – erase one sector in memory array 
.................... #define CE        0xC7          // Chip Erase – erase all sectors in memory array 
.................... #define RDID      0xAB          // Release from Deep Power-down and Read Electronic Signature 
.................... #define DPD       0xB9          // Deep Power-Down mode 
....................  
.................... #define MAX_MEM_BYTES 131072 // 1024 Kbit/8 ->KB * 1024 -> Bytes 
....................  
.................... /* Prototipo de funciones */ 
....................  
.................... /* 
.................... *   Funci�n: Inicializaci�n 
.................... *   Descripci�n: Inicializa el SPI y la memoria 
.................... * 
.................... *   Input: 
.................... *         -  
.................... *   Output: 
.................... *         - 
.................... */ 
.................... void M25AA1024_init(); 
....................  
.................... /* 
.................... *   Funci�n: Envio de direcci�n de memoria 
.................... *   Descripci�n: Env�a por SPI la dirección de memoria seleccionada. 
.................... *      Se hace uso de esta funci�n debido a que la direcci�n tiene  
.................... *      un tama�o de 24 bits y la funci�n spi_write solo permite 8bits 
.................... *    
.................... *   Dirección  
.................... * 
.................... *   31                 23                  15                    7                  0    
.................... *    _______________________________________________________________________________ 
.................... *   |   NO USADO        |      MSB          |      MidSB         |      LSB         | 
.................... *   |___________________|___________________|____________________|__________________| 
.................... * 
.................... *   Input: 
.................... *         - iAddress 
.................... *   Output: 
.................... *         - 
.................... */ 
.................... void M25AA1024_sendAddress(int32); 
....................  
.................... /* 
.................... *   Funci�n: Lectura datos 
.................... *   Descripci�n: Lee el dato guardado en la direcci�n seleccionada 
.................... * 
.................... *   Input: 
.................... *         - iAddress - Direcci�n de memoria 
.................... *   Output: 
.................... *         - iData    - Dato leido 
.................... */ 
.................... int8 M25AA1024_read(int32); 
....................  
.................... /* 
.................... *   Funci�n: Envio datos 
.................... *   Descripci�n: Env�a el dato seleccionado a la direcci�n seleccionada 
.................... * 
.................... *   Input: 
.................... *       - iAddress   - Direcci�n de memoria 
.................... *         - iData      - Dato a enviar 
.................... *   Output: 
.................... *         - 
.................... */ 
.................... void M25AA1024_write(int32,int8); 
....................  
.................... /* 
.................... *   Funci�n: Lectura estado 
.................... *   Descripci�n: Lee el estado de la memoria 
.................... * 
.................... *   Input: 
.................... *      - 
.................... *   Output: 
.................... *         - iResult      - Lectura de la memoria 
.................... */ 
.................... int8 M25AA1024_status(); 
....................  
.................... int32 lecturaDirFAT(int32 i32FAT); 
....................  
....................  
....................  
.................... void M25AA1024_init(){ 
....................     // Se sigue el procedimiento de incio indicado en el datasheet 
....................     output_low(CS_MEM);             // Habilito memoria 
*
0144E:  MOVLW  20
01450:  MOVWF  F95
01452:  BCF    F8C.7
....................     output_high(HOLD_MEM);          // Permito escritura 
01454:  MOVWF  F95
01456:  BSF    F8C.3
....................     output_high(CS_MEM);            // Deshabilito memoria 
01458:  MOVWF  F95
0145A:  BSF    F8C.7
0145C:  GOTO   1DCFA (RETURN)
.................... } 
....................  
.................... void M25AA1024_sendAddress(int32 i32Address){               
....................     spi_write2((i32Address>>16)&0xFF);          // Se desplaza hacia la derecha 16 bits los 8 bits más significativos de la dirección 
01460:  MOVFF  968,96B
01464:  MOVLB  9
01466:  CLRF   x6D
01468:  CLRF   x6E
0146A:  CLRF   x6C
0146C:  CLRF   x6D
0146E:  CLRF   x6E
01470:  MOVF   F6A,W
01472:  MOVFF  968,F6A
01476:  RRCF   F68,W
01478:  BNC   1476
....................                                                 // de memoria de 24 bits (MSB) 
....................     spi_write2((i32Address>>8)&0xFF);           // Mismo procedimiento pero desplazando solo 8 bits (MidSB) 
0147A:  MOVFF  967,96B
0147E:  CLRF   x6E
01480:  CLRF   x6C
01482:  CLRF   x6D
01484:  CLRF   x6E
01486:  MOVF   F6A,W
01488:  MOVFF  967,F6A
0148C:  RRCF   F68,W
0148E:  BNC   148C
....................     spi_write2((i32Address)&0xFF);              // (LSB) 
01490:  MOVFF  966,96A
01494:  CLRF   x6B
01496:  CLRF   x6C
01498:  CLRF   x6D
0149A:  MOVF   F6A,W
0149C:  MOVFF  966,F6A
014A0:  RRCF   F68,W
014A2:  BNC   14A0
014A4:  MOVLB  0
014A6:  GOTO   14D2 (RETURN)
.................... } 
....................  
.................... int8 M25AA1024_read(int32 i32Address){ 
....................    int8 i8Data;                          // Variable para guardar el dato leido 
....................     
....................    // Configuro SPI para funcionar en el modo correcto 
....................    SSP2CON1=0xA2;                       // Input data is sampled at the middle of data output time           
014AA:  MOVLW  A2
014AC:  MOVWF  F67
....................    SSP2STAT|=0x40;                      // Transmit occurs on the transition from active to Idle clock state 
014AE:  BSF    F68.6
....................                                          
....................    output_low(CS_MEM);                  // Activa la memoria 
014B0:  MOVLW  20
014B2:  MOVWF  F95
014B4:  BCF    F8C.7
....................    spi_write2(READ);                    // Envía comando de lectura 
014B6:  MOVF   F6A,W
014B8:  MOVLW  03
014BA:  MOVWF  F6A
014BC:  RRCF   F68,W
014BE:  BNC   14BC
....................    M25AA1024_sendAddress(i32Address);   // Envía dirección de memoria a leer 
014C0:  MOVFF  964,969
014C4:  MOVFF  963,968
014C8:  MOVFF  962,967
014CC:  MOVFF  961,966
014D0:  BRA    1460
....................    i8Data=spi_read2(0);                 // Lee el dato 
014D2:  MOVF   F6A,W
014D4:  CLRF   F6A
014D6:  RRCF   F68,W
014D8:  BNC   14D6
014DA:  MOVFF  F6A,965
....................    output_high(CS_MEM);                 // Desactiva la memoria 
014DE:  MOVLW  20
014E0:  MOVWF  F95
014E2:  BSF    F8C.7
....................     
....................    return i8Data;                       // Retorna el dato leido 
014E4:  MOVLB  9
014E6:  MOVFF  965,01
014EA:  MOVLB  0
014EC:  RETURN 0
.................... } 
....................  
.................... void M25AA1024_write(int32 i32Address,int8 i8Data){ 
....................    // Configuro SPI para funcionar en el modo correcto 
....................    SSP2CON1=0xA2;                       // Input data is sampled at the middle of data output time           
....................    SSP2STAT|=0x40;                      // Transmit occurs on the transition from active to Idle clock state 
....................     
....................    do{ 
....................        output_low(CS_MEM);                  // Activa la memoria 
....................        spi_write2(WREN);                    // Habilita escritura 
....................        output_high(CS_MEM);                 // Desactiva la memoria        
....................        output_low(CS_MEM);                  // Activa la memoria 
....................        spi_write2(WRITE);                   // Envia comando de escritura 
....................        M25AA1024_sendAddress(i32Address);   // Envia dirección de memoria a escribir 
....................        spi_write2(i8Data);                  // Escribe el dato 
....................        output_high(CS_MEM);                 // Desactiva la memoria 
....................        #ifdef SAURON 
....................        delay_ms_wdt(8); 
....................        restart_wdt_hw(); 
....................        #else 
....................        delay_ms(8); 
....................        #endif 
....................    }while(M25AA1024_read(i32Address)!=i8Data); 
.................... } 
....................  
.................... int8 M25AA1024_status(){ 
....................    int8 i8Result;                       // Variable auxiliar donde se guarda el resultado de la memoria 
....................     
....................    output_low(CS_MEM);                  // Activa la memoria 
....................    i8Result=spi_read2(RDSR);            // Lee estado 
....................    output_high(CS_MEM);                 // Desactiva la memoria 
....................         
....................    return i8Result;                     // Devuelvo el estado de la memoria 
.................... } 
