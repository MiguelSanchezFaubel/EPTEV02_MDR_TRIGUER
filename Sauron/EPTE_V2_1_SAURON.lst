.................... #define MODO_TRAT_GALV_ACTIVO       7           // 7 - Identifica un paquete del tipo de tratamiento galv�nico en activo 
.................... #define MODO_TRAT_ELECT             8           // 8 - Identifica un paquete del tipo de configuraci�n del tratamiento en electroestimulaci�n 
.................... #define MODO_TRAT_ELECT_ACTIVO      9           // 9 - Identifica un paquete del tipo de tratamiento de electroestimulaci�n en activo 
