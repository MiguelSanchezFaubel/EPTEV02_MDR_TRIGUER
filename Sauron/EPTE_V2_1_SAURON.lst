....................                     i16PW_minusElec[i8ConfigCanal]=i16PW_plusElec[i8ConfigCanal];   // Asigna a PW- el mismo valor (simetría) 
....................                     i8RepVal2=sPW_LEYENDA;                          // Asigan texto leyenda 
