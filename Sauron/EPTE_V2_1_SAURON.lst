....................         writeEEPROM_8bits(direccion_aux+EEPROM_TB_SEPARACION_PULSOS,PRESET_PICA_SEP_PULSOS); 
....................         writeEEPROM_8bits(direccion_aux+EEPROM_TB_NUMERO_BURST,PRESET_PICA_N_BURST); 
