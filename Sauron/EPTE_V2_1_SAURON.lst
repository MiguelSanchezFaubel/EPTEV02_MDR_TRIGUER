.................... // Comandos de funcionamiento 
.................... #define COMANDO_START               0xAA        // Comando de START 
.................... #define COMANDO_STOP                0xBB        // Comando de STOP 
.................... #define COMANDO_START_REPOSO        0xDD        // Comando de start reposo         
.................... #define COMANDO_STOP_REPOSO         0xEE        // Comando de stop reposo       
