....................  
.................... #define S_   0         // Small 
.................... #define M_   1         // Medium 
.................... #define L_   2         // Large 
.................... #define XL_   3         // XLarge 
....................  
.................... #define DATA      1      // Definici�n de instrucci�n DATA 
.................... #define COMMAND   0      // Definici�n de instrucci�n COMMAND 
....................  
.................... #define MINLINE   0x10    // Primera limnea del display 
.................... #define MAXLINE   0x9F    // �ltima l�nea del display 
.................... #define MINCOL    0x05    // Primera columna del display 
.................... #define MAXCOL    0x54    // �ltima columna del display 
....................  
.................... #ifndef   HIGH 
....................    #define HIGH   1 
.................... #endif 
....................  
