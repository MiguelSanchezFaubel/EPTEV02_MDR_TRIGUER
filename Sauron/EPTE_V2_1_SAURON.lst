.................... #define OFFSET_EEPROM_PRESET_2_EXT                      OFFSET_ENTRE_PRESETS_EXT + OFFSET_EEPROM_PRESET_1_EXT      // Indica la posici�n inicial del preset 2 - Pos: 149+120*i8SeleccionTerapia*i8DobleElectro 
