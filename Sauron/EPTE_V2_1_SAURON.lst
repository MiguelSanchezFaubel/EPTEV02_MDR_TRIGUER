....................     #include "../Drivers/M25AA1024.c"           // Libreria de la memoria SPI 
.................... /* 
.................... *   File: M25AA1024.c 
.................... *    
.................... *   Descripci�n: Driver para la memoria SPI 25AA1024 de 1Mbit 
.................... *    
.................... *   Versi�n: 2.0 
.................... * 
.................... *   Ionclinics & Deionics SL 
.................... */ 
....................  
.................... #include "M25AA1024.h" 
.................... /* 
.................... *   File: M25AA1024.h 
.................... *    
.................... *   Descripci�n: Header file del driver para la memoria SPI 25AA1024 de 1Mbit 
.................... *    
.................... *   Versi�n: 2.0 
.................... * 
.................... *   Ionclinics & Deionics SL 
.................... */ 
....................  
.................... /* Definciones */ 
.................... #ifndef   HIGH                  // Si no se ha definido el nivel alto 
....................    #define HIGH   1             // Define nivel alto 
.................... #endif 
....................  
.................... #ifndef   LOW                   // Si no se ha definido el nivel bajo 
....................    #define LOW   0              // Defino nivel bajo 
.................... #endif 
....................  
.................... /* Registros */ 
.................... #define READ      0x03          // Read data from memory array beginning at selected address 
.................... #define WRITE     0x02          // Write data to memory array beginning at selected address 
.................... #define WREN      0x06          // Set the write enable latch (enable write operations) 
.................... #define WRDI      0x04          // Reset the write enable latch (disable write operations) 
.................... #define RDSR      0x05          // Read STATUS register 
.................... #define WRSR      0x01          // Write STATUS register 
.................... #define PEE        0x42          // Page Erase – erase one page in memory array 
.................... #define SE        0xD8          // Sector Erase – erase one sector in memory array 
.................... #define CE        0xC7          // Chip Erase – erase all sectors in memory array 
.................... #define RDID      0xAB          // Release from Deep Power-down and Read Electronic Signature 
.................... #define DPD       0xB9          // Deep Power-Down mode 
....................  
.................... #define MAX_MEM_BYTES 131072 // 1024 Kbit/8 ->KB * 1024 -> Bytes 
....................  
.................... /* Prototipo de funciones */ 
....................  
.................... /* 
.................... *   Funci�n: Inicializaci�n 
.................... *   Descripci�n: Inicializa el SPI y la memoria 
.................... * 
.................... *   Input: 
.................... *         -  
.................... *   Output: 
.................... *         - 
.................... */ 
.................... void M25AA1024_init(); 
....................  
.................... /* 
.................... *   Funci�n: Envio de direcci�n de memoria 
.................... *   Descripci�n: Env�a por SPI la dirección de memoria seleccionada. 
.................... *      Se hace uso de esta funci�n debido a que la direcci�n tiene  
.................... *      un tama�o de 24 bits y la funci�n spi_write solo permite 8bits 
.................... *    
.................... *   Dirección  
.................... * 
.................... *   31                 23                  15                    7                  0    
.................... *    _______________________________________________________________________________ 
.................... *   |   NO USADO        |      MSB          |      MidSB         |      LSB         | 
.................... *   |___________________|___________________|____________________|__________________| 
