.................... /******************************** Definicion de constantes/variables *****************************************/ 
.................... // Identificaci�n de paquetes 
.................... // Envia un identificador y un paquete 
.................... #define MODO_CHECK_ALIVE            1           // 1 - Identifica un paquete del tipo check alive 
.................... #define MODO_FUNCION                2           // 2 - Identifica un paquete de tipo funci�n (utilizado para comandos varios) 
.................... #define MODO_CONEXION_POINTER       3           // 3 - Identifica un paquete de conexi�n del pointer 
.................... #define MODO_START_STOP             4           // 4 - Identifica un paquete del tipo START/STOP 
.................... #define MODO_ACK                    5           // 5 - Identifica un paquete del tipo ACK 
....................  
.................... // Envia un identificador y varios paquetes 
.................... #define MODO_TRAT_GALV              6           // 6 - Identifica un paquete del tipo de configuraci�n del tratamiento en galv�nica 
.................... #define MODO_TRAT_GALV_ACTIVO       7           // 7 - Identifica un paquete del tipo de tratamiento galv�nico en activo 
.................... #define MODO_TRAT_ELECT             8           // 8 - Identifica un paquete del tipo de configuraci�n del tratamiento en electroestimulaci�n 
.................... #define MODO_TRAT_ELECT_ACTIVO      9           // 9 - Identifica un paquete del tipo de tratamiento de electroestimulaci�n en activo 
.................... #define MODO_TRAT_TB               10          // 10 - Identifica un paquete del tipo de configuraci�n del tratamiento en electroestimulaci�n 
.................... #define MODO_TRAT_TB_ACTIVO        11          // 11 - Identifica un paquete del tipo de tratamiento de electroestimulaci�n en activo 
.................... #define MODO_MEDIDAS_OBTENIDAS      12          // 12 - Identifica un paquete del tipo de medidas obtenidas para representaci�n (ElectroEstimulaci�n) 
.................... #define MODO_MEDIDAS_THETABURST    13          // 13 - Identifica un paquete del tipo de medidas obtenidas para representaci�n (Sistema Multipulsos) 
.................... #define MODO_MEDIDAS_GALVANICA      14          // 14 - Identifica un paquete del tipo de medidas obtenidas para representaci�n (Galvanica ) 
.................... #define MODO_ERRORES                15          // 15 - Identifica un paquete del tipo de errores                                                                                                                           
.................... #define MODO_CONTROL_TIEMPO         16          // 16 - Identifica un paquete del tipo control de tiempo                                                                                                  
.................... #define MODO_CHECK_INICIAL          17          // 17 - Envia el paquete inicial para comprobar que Orco est� preparado 
.................... #define MODO_PROTOCOLO_TEST         18          // 18 - Identifica el paquete de protocolo de test a realizar          
.................... #define MODO_INFORME                19          // 19 - Envia el paquete para habilitar o deshabilitar la masa para la UART - Muestra informe de ingenieria 
....................  
