.................... #define MODO_DOS_PAQ                MODO_ACK    // Define el numero de paquetes que tiene dos datos de entrada para usar la otra funci�n 
....................  
.................... // Comandos de funcionamiento 
.................... #define COMANDO_START               0xAA        // Comando de START 
.................... #define COMANDO_STOP                0xBB        // Comando de STOP 
.................... #define COMANDO_START_REPOSO        0xDD        // Comando de start reposo         
.................... #define COMANDO_STOP_REPOSO         0xEE        // Comando de stop reposo       
.................... #define COMANDO_START_PAUSA         0xAF        // Comando de start pausa 
.................... #define COMANDO_STOP_PAUSA          0xBE        // Comando de stop pausa 
.................... #define COMANDO_CHECK_ALIVE         0xCA        // Comando Check Alive 
.................... #define COMANDO_ACK                 0xCC        // Comando identificador del ACK 
....................  
.................... #define INFORME_ACTIVADO            0xAB        // Indica que se va a mostrar el informe de ingenieria 
.................... #define INFORME_DESACTIVADO         0xCD        // Indica que se va a parar el informe de ingenieria 
....................  
.................... // Tipos de errores 
.................... #define NO_ERROR                0x0000          // Indica que no hay errores/se han solucionado todos los errores 
.................... #define ERROR_ELECTRODO_CHA     0x0001          // Indica que hay un error de electrodo en el canal A                
.................... #define ERROR_ELECTRODO_CHB     0x0002          // Indica que hay un error de electrodo en el canal B            
.................... #define ERROR_ELECTRODO_CHC     0x0004          // Indica que hay un error de electrodo en el canal C            
.................... #define ERROR_RESERVADO         0x0008          // Error reservado (libre) 
.................... #define ERROR_RESERVADO         0x0010          // Error reservado (libre) 
.................... #define ERROR_RESERVADO         0x0020          // Error reservado (libre) 
.................... #define ERROR_CALIBRADO_CHA     0x0040          // Indica que hay un error de calibrado en el canal A 
