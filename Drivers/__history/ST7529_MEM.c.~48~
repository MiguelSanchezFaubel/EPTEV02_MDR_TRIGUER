/*
*   Función: Fuente
*   Descripción: Configuración de la fuente a usar
*
*   Input:
*         - iFont      - Fuente seleccionada, se selecciona con los defines definidos
*               - S_  - Tamaño pequeño
*               - M_  - Tamaño Mediano
*               - L_  - Tamaño Grande
*               - XL_ - Tamaño Muu grande
*                 
*   Output:
*         - 
*/
void ST7529_selectFont(int8 iFont){
       SSP2CON1=0xB0;
   SSP2STAT&=~0xC0; 
   iAddressFont=0;
   switch(iFont){
      case S_:
         iAddressFont=make32(M25AA1024_read(FAT_S),M25AA1024_read(FAT_S+1),M25AA1024_read(FAT_S+2));
         iNumBytes=8;
         iRowStep=8;
         iColumnStep=2;
         break;
      case M_:
         iAddressFont=make32(M25AA1024_read(FAT_M),M25AA1024_read(FAT_M+1),M25AA1024_read(FAT_M+2));
         iNumBytes=8;
         iRowStep=8;
         iColumnStep=2;
         break;
      case L_:
         iAddressFont=make32(M25AA1024_read(FAT_L),M25AA1024_read(FAT_L+1),M25AA1024_read(FAT_L+2));
         iNumBytes=16;
         iRowStep=16;
         iColumnStep=2;
         break;
      case XL_:
         iAddressFont=make32(M25AA1024_read(FAT_XL),M25AA1024_read(FAT_XL+1),M25AA1024_read(FAT_XL+2));
         iNumBytes=75;
         iRowStep=24;
         iColumnStep=7;
         break;
      default:
         iAddressFont=make32(M25AA1024_read(FAT_S),M25AA1024_read(FAT_S+1),M25AA1024_read(FAT_S+2));
         iNumBytes=8;
         iRowStep=8;
         iColumnStep=2;
         break;
   }
}
