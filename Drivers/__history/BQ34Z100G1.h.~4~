void reset_bq(){
    i2c_start();                                                     // Start condition
    i2c_write(BQ34Z100);                                             // Device address
    i2c_write(0x00);
    i2c_write(0x41);
    i2c_write(0x00);
    i2c_stop();                                                      // Stop condition
    i2c_start();                                                     // Start condition
    i2c_write(BQ34Z100);                                             // Device address
    i2c_write(0x00);
    i2c_start(); 
    i2c_write(BQ34Z100+1);                                           // Device address
    long temp =i2c_read(false);
    i2c_stop();                                                      // Stop condition
    return;
}
