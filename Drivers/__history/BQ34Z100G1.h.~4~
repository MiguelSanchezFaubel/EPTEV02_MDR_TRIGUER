   byte vMidLoByte = (byte)(X >> 8);
   byte vLSByte = (byte)X;
   // Get the sign, its in the 0x00 80 00 00 bit
   if ((vMidHiByte & 128) == 0)
      bIsPositive = true;

   // Get the exponent, it's 2^(MSbyte - 0x80)
   fExponent = pow(2, (vMSByte - 128));
   // Or in 0x80 to the MidHiByte
