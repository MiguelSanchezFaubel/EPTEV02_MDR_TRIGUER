....................     int32 si16PW_plusElec;              // Indica el ancho de pulso positivo configurado para cada uno de los canales 
....................     int32 si16PW_minusElec;             // Indica el ancho de pulso negativo configurado para cada uno de los canales 
....................     int16 si16FrecInicialMod; 
....................     int16 si16FrecFinalMod; 
