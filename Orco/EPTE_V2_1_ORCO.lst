.................... void funcion_dormir(){ 
....................      
....................     disable_interrupts(INT_TIMER0);              // Deshabilita interrupciones 
....................     disable_interrupts(INT_TIMER1);              // Deshabilita interrupciones 
....................     disable_interrupts(INT_TIMER3);              // Deshabilita interrupciones 
....................     disable_interrupts(INT_TIMER4);              // Deshabilita interrupciones 
....................     disable_interrupts(INT_TIMER5);              // Deshabilita interrupciones 
....................     disable_interrupts(INT_TIMER6);              // Deshabilita interrupciones 
....................     disable_interrupts(INT_TIMER7);              // Deshabilita interrupciones 
....................     disable_interrupts(INT_TIMER8);              // Deshabilita interrupciones 
....................      
....................     clear_interrupt(INT_TIMER0);                 // Limpia flags interrupciones 
....................     clear_interrupt(INT_TIMER1);                 // Limpia flags interrupciones 
....................     clear_interrupt(INT_TIMER3);                 // Limpia flags interrupciones 
....................     clear_interrupt(INT_TIMER4);                 // Limpia flags interrupciones 
....................     clear_interrupt(INT_TIMER5);                 // Limpia flags interrupciones    
....................     clear_interrupt(INT_TIMER6);                 // Limpia flags interrupciones 
....................     clear_interrupt(INT_TIMER7);                 // Limpia flags interrupciones 
....................     clear_interrupt(INT_TIMER8);                 // Limpia flags interrupciones 
....................     clear_interrupt(INT_TIMER10);                // Limpia flags interrupciones 
....................      
....................     // Stop Timers 
....................     TIMER0_ON=0; 
....................     TIMER1_ON=0; 
....................     TIMER2_ON=0;    
....................     TIMER3_ON=0; 
....................     TIMER4_ON=0;    
....................     TIMER5_ON=0; 
....................     TIMER6_ON=0; 
....................     TIMER7_ON=0;    
....................     TIMER8_ON=0; 
....................     TIMER10_ON=0;    
....................      
....................     // Nivel bajo se�ales control 
....................     output_low(PULSO_1p_CHA); 
....................     output_low(PULSO_1m_CHA); 
....................     output_low(PULSO_2p_CHA); 
....................     output_low(PULSO_2m_CHA); 
....................     output_low(PULSO_1p_CHB); 
....................     output_low(PULSO_1m_CHB); 
....................     output_low(PULSO_2p_CHB); 
....................     output_low(PULSO_2m_CHB); 
....................     output_low(PULSO_1p_CHC); 
....................     output_low(PULSO_1m_CHC); 
....................     output_low(PULSO_2p_CHC); 
....................     output_low(PULSO_2m_CHC); 
....................      
....................     // Apagado PWN y puesta a nivel bajo 
....................     set_pwm5_duty((int16)0);        
....................     set_pwm6_duty((int16)0);     
....................     set_pwm7_duty((int16)0);        
....................     set_pwm8_duty((int16)0);     
....................     set_pwm9_duty((int16)0);     
....................     set_pwm2_duty((int16)0);        
....................     set_pwm3_duty((int16)0); 
....................     set_pwm4_duty((int16)0);       
....................      
....................     CCP2CON=0x00;                                    // Apagado PWM se�ales de control ENB     
....................     CCP4CON=0x00;                                    // Apagado PWM Amplitud pulso negativo ChA 
....................     CCP5CON=0x00;                                    // Apagado PWM Amplitud pulso positivo ChA 
....................     CCP6CON=0x00;                                    // Apagado PWM Amplitud pulso negativo ChB 
....................     CCP7CON=0x00;                                    // Apagado PWM Amplitud pulso positivo ChB    
....................     CCP8CON=0x00;                                    // Apagado PWM Amplitud pulso negativo ChC 
....................     CCP9CON=0x00;                                    // Apagado PWM Amplitud pulso positivo ChC                            
....................      
....................     AD_ON=0; 
....................      
....................     // Nivel bajo se�ales control 
....................     output_low(PWMp_CHA); 
....................     output_low(PWMm_CHA); 
....................     output_low(PWMp_CHB); 
....................     output_low(PWMm_CHB);      
....................     output_low(PWMp_CHC); 
....................     output_low(PWMm_CHC); 
....................      
....................      
....................     // Apagado VCC de cada canal 
....................     control_DC(0,EN_VCC_CH_A); 
....................     control_DC(0,EN_VCC_CH_B); 
....................     control_DC(0,EN_VCC_CH_C);   
....................      
....................     // Apagado TX  
....................     DEBUG_UART_ON=0; 
....................     output_low(I2C_SCL_ORCO); 
....................     output_low(I2C_SDA_ORCO); 
....................     output_low(TX_AUX_2); 
....................      
....................     // Inicializacion variables...   
....................     bTratamientoInit=0; 
....................     bMedidaCorrienteA=0; 
....................     bMedidaCorrienteB=0; 
....................     bMedidaCorrienteC=0; 
....................      
....................      
....................     // ENVIA CONFIRMACI�N SAURON DE QUE HA IDO OK 
....................     // ESPERA OK SAURON 
....................     // APAGA TX SAURON ORCO 
....................     // HABILITA INT RB0 PARA DESPERTAR 
....................     // NO HACE FALTA!! -> SAURON PONE A RESET ESTE PIC 
....................      
....................     bSleepMode=1;    
.................... } 
