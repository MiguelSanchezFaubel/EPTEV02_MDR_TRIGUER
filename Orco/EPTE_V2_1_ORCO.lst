....................                     case PASO_1:                                                        // Paso 1 - Detecci�n de corriente al iniciar alimentaciones 
....................                         control_DC(1,EN_VCC_CH_C);              // Encendido VCC CHA  
....................                         break; 
....................                     case PASO_2:                                                        // Paso 2 - Tensi�n en la carga con todo a cero 
....................                         // Encendido Positivo 
....................                         set_pwm7_duty(0); 
....................                         setup_ccp7(CCP_PWM); 
