.................... #byte PMD2   = 0xF17 
....................  
.................... #byte T0CON=0xFD5 
....................  
.................... // Timers 4/6/8/10/12 
.................... #byte TMR4     = 0xF6D 
.................... #byte T4CON    = 0xF6B 
.................... #byte PR4      = 0xF6C 
.................... #byte TMR6     = 0xF3B 
.................... #byte T6CON    = 0xF39 
.................... #byte PR6      = 0xF3A 
.................... #byte TMR8     = 0xF38 
.................... #byte T8CON    = 0xF36 
.................... #byte PR8      = 0xF37 
.................... #byte TMR10    = 0xF35 
.................... #byte T10CON   = 0xF33 
.................... #byte PR10     = 0xF34 
