                }
            }
            
            enable_interrupts(INT_TIMER1);                                      // Habilita interrupciones
            
            if(bPolaridadMicro){
                enable_interrupts(INT_TIMER4);                                      // Habilita interrupciones
                enable_interrupts(INT_TIMER6);                                  // Habilita interrupciones
            }else{
                if(bMonopolarPosNeg==MONOPOLAR_POSITIVO){
