                gi16Timer10=i16PW_minusElec[CHC_C]*64/260;                         // Calculo del valor a cargar segun el PW en uSg offset=
                i8DivTimer10=0;
            }else{
                fDivTimer10=(float)i16PW_minusElec[CHC_C]/1275;          // El número de veces que sobrecargamos el timer es igual a el PW dividido entre la cuenta máxima del timer

                if(fDivTimer10-(int8)fDivTimer10==0){
                    i8DivTimer10=(int8)fDivTimer10;
                }else{
                    i8DivTimer10=(int8)fDivTimer10+1;             // Lo redondeo en unidades hacia arriba, y lo asigno a una variable entera       
                }
                fCargaTimer10=fDivTimer10/i8DivTimer10;            // Calculo el porcentaje de carga entre el valor real y el valor redondeado
                gi16Timer10=255*fCargaTimer10;          // Calculo del valor a cargar segun el PW en uSg offset=40
                i8DivTimer10=i8DivTimer10+i8DivTimer10*0.30;
            }
            setup_timer_10(T10_DIV_BY_16,gi16Timer10,5);                         // Configuracion con 8 bits y resolucion de 5uSg
            TIMER10_ON=0;  
            i8ContTimer10=0;
        }
        
        // Activar timers correspondientes
        clear_interrupt(INT_TIMER3);                                        // Limpia flags interrupciones
        clear_interrupt(INT_TIMER8);                                        // Limpia flags interrupciones
        
        if(bPolaridadElec[CHC_C]==1){                                           // Si es bipolar, activamos timer 7
            clear_interrupt(INT_TIMER10);                                    // Limpia flags interrupciones
        }         
        
        enable_interrupts(INT_TIMER3);                                      // Habilita interrupciones
        enable_interrupts(INT_TIMER8);                                      // Habilita interrupciones
        
        if(bPolaridadElec[CHC_C]==1){                                           // Si es bipolar, activamos timer 7
            enable_interrupts(INT_TIMER10);                                  // Habilita interrupciones
        }

        i8Return=RETURN_FUNC_OK;

        i16TiempoPulsoC=i16PW_plusElec[CHC_C]+(i16PW_minusElec[CHC_C]*bPolaridadElec[CHC_C])+BG_MONOPOLAR+BG_MONOPOLAR*bPolaridadElec[CHC_C];
        
        structControlTiempo.sbValorAlcanzado[CHC_C]=0;
        bValorAlcanzado[CHC_C]=0;
        
        initMedidasCHC();
    }
    
    return i8Return;
}

