int16 calculoCorriente(int16 medida){                               // Devuelve la corriente ya procesada

    float fMedRaw;    
    
    fMedRaw=medida*5000.0/4096;                                     // Escalado, resultado en mV
    
    //return (int16)((fMedRaw*5.6/4.990))-0.9638;                      // C�lculo de la corriente, resultado en uA
    //return (int16)(fMedRaw*100/(4.99*5.6));
    return (int16)(fMedRaw*100/(4.99*6.65));
}


