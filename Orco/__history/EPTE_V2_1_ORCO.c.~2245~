        // output_high(RANGO_GALV);            
        control_releB(RELE_SEL_GALV);
        envioDatos(MODO_FUNCION,FUNCION_ENABLE_RELE_GALV); 
        output_low(ORCO_ENVIANDO);

        // Conecta la carga al circuito Ch Galv
        //control_releB(RELE_SEL_GALV);
        //configuraDatos(MODO_FUNCION,FUNCION_ENABLE_RELE_GALV);                               // Envia el comando                                                                         
        
            
        // Configuracion frecuencia ChB--> TMR1
        setup_timer_1(T1_INTERNAL | T1_DIV_BY_8);                         // Configuracion con 16 bits y resolucion de 0.5 uSg
        if(i16frecmicro>31){                                             // Si la frecuencia ChB es mayor 31Hz no es necesario                        
            i8DivTimer1=0;
            i32Operacion=2000000/i16frecmicro;                           // Hace operacion por separado para no desbordar
            gi16Timer1=65536-i32Operacion;                                 // Carga datos al timer
        }else{                                                              // Si desbordamos el timer1 (Valores m�s bajos de 30 Hz)                                                    
            if (i16frecmicro<=1){                                         // Frecuencia de 1Hz                                        
                i8DivTimer1=40;                                           // Numero de interacciones en el Timer1
                i32Operacion=2000000/(i16frecmicro*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                                      
            }else if (i16frecmicro<=3){                                         // Frecuencia entre 2 y 3Hz                                          
                i8DivTimer1=20;                                           // Numero de interacciones en el Timer1
                i32Operacion=2000000/(i16frecmicro*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                                      
            }else if (i16frecmicro<=7){                                    // Frecuencia entre 4 y 7Hz 
                i8DivTimer1=10;                                           // Numero de interacciones en el Timer1
                i32Operacion=2000000/(i16frecmicro*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                  
            }else if (i16frecmicro<=20){                                   // Frecuencia entre 8 y 20Hz 
                i8DivTimer1=5;                                            // Numero de interacciones en el Timer1
                i32Operacion=2000000/(i16frecmicro*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                  
            }else if (i16frecmicro<=30){                                   // Frecuencia entre 21 y 30Hz 
                i8DivTimer1=2;                                            // Numero de interacciones en el Timer1
                i32Operacion=2000000/(i16frecmicro*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                  
            } 
        }
        TIMER1_ON=0;                                                      // Detenemos timer1
        i8ContTimer1=0;
        set_timer1(gi16Timer1);
                    
        
        
        if(bPolaridadMicro){
            // Configuracion PW positivo ChB--> TMR4 
            gi16Timer4=(i16PWmicro*64/(260))-1;                        // Calculo del valor a cargar segun el PW en uSg offset=2 
            setup_timer_4(T4_DIV_BY_16,gi16Timer4,5);                         // Configuracion con 8 bits y resolucion de 5uSg
            TIMER4_ON=0;  
            i8DivTimer4=0;
            i8ContTimer4=0;
        
            gi16Timer6=(i16PWmicro*64/(260))-1;                        // Calculo del valor a cargar segun el PW en uSg offset=2 
            setup_timer_6(T6_DIV_BY_16,gi16Timer6,5);                         // Configuracion con 8 bits y resolucion de 5uSg
            TIMER6_ON=0; 
            i8DivTimer6=0;
            i8ContTimer6=0;
        }else{
            if(bMonopolarPosNeg==MONOPOLAR_POSITIVO){
                // Configuracion PW positivo ChB--> TMR4 
                gi16Timer4=(i16PWmicro*64/(260))-1;                        // Calculo del valor a cargar segun el PW en uSg offset=2 
                setup_timer_4(T4_DIV_BY_16,gi16Timer4,5);                         // Configuracion con 8 bits y resolucion de 5uSg
                TIMER4_ON=0;  
                i8DivTimer4=0;
                i8ContTimer4=0;
            }else{
                gi16Timer6=(i16PWmicro*64/(260))-1;                        // Calculo del valor a cargar segun el PW en uSg offset=2 
                setup_timer_6(T6_DIV_BY_16,gi16Timer6,5);                         // Configuracion con 8 bits y resolucion de 5uSg
                TIMER6_ON=0;
                i8DivTimer6=0;
                i8ContTimer6=0;
            }
        }
        
        // Activar timers correspondientes
        clear_interrupt(INT_TIMER1);                                        // Limpia flags interrupciones
        
        if(bPolaridadMicro){
            clear_interrupt(INT_TIMER4);                                        // Limpia flags interrupciones
            clear_interrupt(INT_TIMER6);                                    // Limpia flags interrupciones
        }else{
            if(bMonopolarPosNeg==MONOPOLAR_POSITIVO){
                clear_interrupt(INT_TIMER4);                                        // Limpia flags interrupciones
            }else{
                clear_interrupt(INT_TIMER6);                                    // Limpia flags interrupciones
            }
        }
        
        enable_interrupts(INT_TIMER1);                                      // Habilita interrupciones
        
        if(bPolaridadMicro){
            enable_interrupts(INT_TIMER4);                                      // Habilita interrupciones
            enable_interrupts(INT_TIMER6);                                  // Habilita interrupciones
        }else{
            if(bMonopolarPosNeg==MONOPOLAR_POSITIVO){
                enable_interrupts(INT_TIMER4);                                        // Limpia flags interrupciones
            }else{
                enable_interrupts(INT_TIMER6);                                  // Habilita interrupciones
            }
        }
        
        i8Return=RETURN_FUNC_OK;
        
        set_adc_channel(ADC_SHUNT_CHB);     // Selecci�n del canal medicion corriente positiva canal B                          
        pausa_us(DELAY_INT_SIG);                         // Delay set ADC  
        i16OffsetCorriente=read_adc_chupi_piruli();           // Leer valor del shunt    
            
        bCanalesInicializados[CHB_C]=1;

        bMicrocorrientesEncendido=1;
        initMedidasGal();
    }
    return i8Return;
}

