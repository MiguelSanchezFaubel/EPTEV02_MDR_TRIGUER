int1 isVrefOK(){
    
    int1 bEstado=0;
    int16 i16Raw;
    int32 i32Raw=0;
    
    setup_adc_ports(sAN3|VSS_VDD);                  //Configuro ADC para lectura de Vref con VDD
    setup_adc(ADC_CLOCK_DIV_32|ADC_TAD_MUL_2);
    
    fMedidaVref=0;
    
    set_adc_channel(ADC_VREF);      // Selecci�n de Vref a medir
    i16Raw=read_adc();//_chupi_piruli();              // Leer valor
    while(!adc_done());
    //delay_ms(100);
    i16Raw=0;
    
    for(int8 i8Cont=0; i8Cont<5; i8Cont++){
        set_adc_channel(ADC_VREF);      // Selecci�n de Vref a medir
        while(!adc_done());
        
        i16Raw=read_adc();//_chupi_piruli();              // Leer valor
      while(!adc_done());
      //fprintf(DEBUG_UART,"Vref-> %f\r\n",i16Raw*5000.0/4095);
        i32Raw+=i16Raw;
    }
    
    i32Raw/=5;
    
    fMedidaVref=(i32Raw*5000.0/4095);
    //fprintf(DEBUG_UART,"Vref-> %f\r\n",fMedidaVref);
    // DEBUG ERROR
    //fMedidaVref=0;
    
    if(fMedidaVref>VREF_MAX_VALUE || fMedidaVref<VREF_MIN_VALUE){   // Si la tensi�n supera el +-1% de tolerancia
        bEstado=0;    
    }else{
        bEstado=1;
    }
    
    setup_adc_ports(sAN1|sAN2|sAN4|sAN5|sAN6|sAN7|sAN8|sAN9|sAN10|sAN11|VSS_VREF);   // Configuraci�n de entradas al conversor A/D
    setup_adc(ADC_CLOCK_DIV_64|ADC_TAD_MUL_4);
    
    return bEstado;
}

int16 prediccionCorriente(int8 i8CanalComprobacion, int16 i16DutyEntrada){
    int16 i16CorrientePredecida=0;

    switch(i8CanalComprobacion){
        case CHA_C:
        case CHC_C:
        case POINTER_C:
        case THETA_BURST_C:
            i16CorrientePredecida=(i16DutyEntrada*18.597)-1000.7;
            break;
        case CHB_C:
        case MICROCORRIENTES_C:
            i16CorrientePredecida=(i16DutyEntrada*18.475)-1023.1;
            break;
        case GALVANICA_C:
            i16CorrientePredecida=((i16DutyEntrada)*12.15)-615.68;
            break;
    }
    
    //i16CorrientePredecida*=50;

    return i16CorrientePredecida;
}


void pausa_ms(int16 delay){
    for(int16 i16Bucle=0; i16Bucle<delay; i16Bucle++){
        for(int16 m=0;m<900;m++){                            // Dependiedo del valor de entrada...
            delay_us(1);                                        // Genera un delay multiplo de 1uS ( Delay total= 1uS*X )
        }
    }
}


int16 potencia(int8 i8X,int8 i8Y){
    int16 i16Return=1;
    //fprintf(DEBUG_UART,"Pot: %u %u\r\n",i8X,i8Y);
    if(i8Y==0){
        i16Return=1;
    }else{
        for(int8 i8Cont=0; i8Cont<i8Y; i8Cont++){
            i16Return*=i8X;
        }
    }
    
    return i16Return;
}

int1 comprobacionTransistores(int8 i8CanalComprobacion){             // Funci�n que comprueba el estado de los transistores de cada canal
    int1 bReturn=0;                                                    // Inicializa la variable de retorno
    
    switch(i8CanalComprobacion){
        case CHA_C:
            output_low(PULSO_1p_CHA);
            output_low(PULSO_2p_CHA);
            output_low(PULSO_1m_CHA);
            output_low(PULSO_2m_CHA);
            
            // Paso 1 - Set corriente de CORRIENTE_PRUEBA_TRANSIST uA en la rama positiva
            i16DutyTransistores=(CORRIENTE_PRUEBA_TRANSIST+1000.7)/18.597;            // Calcula el duty necesario para esa correinte
            set_pwm7_duty(i16DutyTransistores);                                        // Activa la rama positiva
            pausa_ms(DELAY_ERROR_TRANSISTORES);                                                 // Delay set ADC
            
            // Paso 2    - Medir corriente y tension
            obtencionMedidasTransistores(CHA_C,RAMA_POSITIVA);
            
            //fprintf(DEBUG_UART,"Paso 2\r\n");
            //fprintf(DEBUG_UART,"I: %lu\r\n",i16CorrienteTransistores);
            //fprintf(DEBUG_UART,"V: %f\r\n",fTensionTransistores);
            
            if(i16CorrienteTransistores>CORRIENTE_ERROR_TRANSIST_PASO_2 || fTensionTransistores>TENSION_ERROR_TRANSIST_PASO_2){ 
                bReturn=1;                                                            // Indico error         
                //fprintf(DEBUG_UART,"Error paso 2\r\n");
                //fprintf(DEBUG_UART,"I: %lu\r\n",i16CorrienteTransistores);
                //fprintf(DEBUG_UART,"V: %f\r\n",fTensionTransistores);
            }else{                                                                    // Si todo es correcto

                // Paso 3    - Activar pulso 1 positivo
                output_high(PULSO_1p_CHA);                                                 // Activo pulso

                // Paso 4    - Medir corriente
                obtencionMedidasTransistores(CHA_C,RAMA_POSITIVA);
                
                //fprintf(DEBUG_UART,"Paso 4\r\n");
                //fprintf(DEBUG_UART,"I: %lu\r\n",i16CorrienteTransistores);
                //fprintf(DEBUG_UART,"V: %f\r\n",fTensionTransistores); 
                
                if(i16CorrienteTransistores>CORRIENTE_ERROR_TRANSIST_PASO_4 || fTensionTransistores<TENSION_ERROR_TRANSIST_PASO_4){                    // Si la corriente medida es superior a la que indicamos como error
                    bReturn=1;                                                            // Indico error         
                    //fprintf(DEBUG_UART,"Error paso 4\r\n");
                    //fprintf(DEBUG_UART,"I: %lu\r\n",i16CorrienteTransistores);
                    //fprintf(DEBUG_UART,"V: %f\r\n",fTensionTransistores); 
                }else{                                                                     // Si todo es correcto

                    // Paso 5    - Activar pulso 2 negativo 
                    output_high(PULSO_2m_CHA);                                                 // Activo pulso

                    // Paso 6    - Medir corriente
                    obtencionMedidasTransistores(CHA_C,RAMA_POSITIVA);
                    
                    //fprintf(DEBUG_UART,"Paso 6\r\n");
                    //fprintf(DEBUG_UART,"I: %lu\r\n",i16CorrienteTransistores);
                    //fprintf(DEBUG_UART,"V: %f\r\n",fTensionTransistores);
                    
                    if(i16CorrienteTransistores>CORRIENTE_ERROR_TRANSIST_PASO_6 || fTensionTransistores>TENSION_ERROR_TRANSIST_PASO_6){ 
                        bReturn=1;                                                            // Indico error         
                        //fprintf(DEBUG_UART,"Error paso 6\r\n");
                        //fprintf(DEBUG_UART,"I: %lu\r\n",i16CorrienteTransistores);
                        //fprintf(DEBUG_UART,"V: %f\r\n",fTensionTransistores);
                    }else{                                                                     // Si todo es correcto

                        // Paso 7    - Desactivar pulso 1 positivo y pulso 2 negativo, set 0 mA a la rama positiva
