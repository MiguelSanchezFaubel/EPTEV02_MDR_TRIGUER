// Frecuencia del ChA
#INT_TIMER0
void  TIMER0_isr(void){
   
    if(TRATAMIENTO_ELECTRO == i8TratamientoSeleccionado){           // Si estamos en tratamiento de electroestimulaci�n
        set_timer0(gi16Timer0);                                         // Inicializa timer frecuencia canal A
        if((i8CanalesActivados == CANALES_ABC) && (i16frecElec[CHA_C]==i16frecElec[CHB_C])&&(i16frecElec[CHB_C]==i16frecElec[CHC_C])){  // Si estan los 3 canales activados, todos con la misma frecuencia
            bDeboResincronizarB=1;                                  // Indico que debo resincronizar el canal B
        }

        if(bDeboResincronizarB && (i8CanalesActivados&CANALES_B)){  // Si debo de resincronizar el canal B y este se encuentra activado
            TIMER1_ON=0;                                            // Apago timer frecuencia canal B
            set_timer1(TIEMPO_PREPARACION_PULSO);                   // Recargo timer frecuencia canal B con un tiempo muuy corto, para que salte enseguida que se active
            i8ContTimer1=i8DivTimer1;                               // Asigno contador divisor timer frecuencia canal B
        }
        
        if(bDeboResincronizarC && (i8CanalesActivados==CANALES_AC)){    // Si debo de resincronizar el canal C y estamos en el tratamiento con canales AC activados (SOLO A y C)
            TIMER3_ON=0;                                            // Apago timer frecuencia canal C
            set_timer3(TIEMPO_PREPARACION_PULSO);                   // Recargo timer frecuencia canal C con un tiempo muuy corto, para que salte enseguida que se active
            i16ContTimer3=i16DivTimer3;                               // Asigno contador divisor timer frecuencia canal C
        }
        
        // 
        bPulsoA=1;                                                  // Activo flag de que el canal A est� poniendo el pulso

        output_low(PULSO_2m_CHA);                                   // Nivel bajo pulso 2 negativo canal A
                                                                                          
        delay_us(DELAY_INT_SIG);                                    // Peque�o delay paar estabilizar la se�al
        
        output_high(PULSO_2p_CHA);                                  // Nivel alto pulso 2 positivo canal A
        delay_us(DELAY_PULSOS);                                     // Peque�o delay espera
        output_high(PULSO_1p_CHA);                                 // Activo pulso positivo
        
        TIMER5_ON=1;                                                // Habilito Timer 5

        // Added 29/03/2022 Medida de tensión y corriente del canal A de electroestimulación
        if(i16PW_plusElec[CHA_C]>=125){                                 // Si el PW es mayor o igual de 125uS, tomo medida de tensión y de corriente
            delay_us(DELAY_ESPERA_MEDIDA_TENSION);                      // Pequeño delay para estabilizar la se�al
        
            set_adc_channel(ADC_VP_CHA);                                // Selecci�n del canal medicion tension positiva canal A
            delay_us(DELAY_INT_SIG);                                    // Delay set ADC
            // 
            i16VMedRaw_Ap=read_adc_chupi_piruli();                      // Leer valor de la tension de la carga positiva canal A
            // 
            
            delay_us(DELAY_ESPERA_MEDIDA_CORRIENTE);                    // Delay espera medida corriente
            
            set_adc_channel(ADC_SHUNT_CHA);                             // Selecci�n del canal medicion corriente positiva canal A
            delay_us(DELAY_INT_SIG);                                    // Delay set ADC
            // 
            i16IMedRaw_Ap=read_adc_chupi_piruli();                      // Leer valor del shunt  
            // 
        }else{                                                          // Si el PW es menor de 125uS, alterno las medidas
            if(bMedidasCriticasPlus_A){
                delay_us(DELAY_ESPERA_MEDIDA_CRITICA);                  // Delay para estabilizar la señal por debajo de las 125uS

                set_adc_channel(ADC_VP_CHA);                            // Selección del canal medición tensión positiva canal A
                delay_us(DELAY_INT_SIG_CRITICA);                        // Delay set ADC
                // 
                i16VMedRaw_Ap=read_adc_chupi_piruli();                  // Leer valor del shunt
                // 
                bMedidasCriticasPlus_A=0;
            }else{
                delay_us(DELAY_ESPERA_MEDIDA_CRITICA);                  // Delay para estabilizar la señal por debajo de las 125uS

                set_adc_channel(ADC_SHUNT_CHA);                         // Selección del canal medición tensión corriente canal A
                delay_us(DELAY_INT_SIG_CRITICA);                        // Delay set ADC
                // 
                i16IMedRaw_Ap=read_adc_chupi_piruli();                  // Leer valor del shunt
                // 
                bMedidasCriticasPlus_A=1;
            }
        }
        bMedidaActualizada[CHA_C]=1;                                // Indico que hay una medida actualizada del canal A
    }else if(TRATAMIENTO_TB == i8TratamientoSeleccionado){         // Si estamos en un tratamiento TB
        i8ContTimer0++;                             // Incrementa  el contador del timer 0
    
        if (i8DivTimer0>i8ContTimer0){              // Si el contador es inferior al valor que debe de llegar (Si el contador es menor que la ST)
            set_timer0(gi16Timer0);                 // Recarga el timer 0 de nuevo
        }else{                                      // ...en cambio, si ya ha llegado al valor de la cuenta deseada
            if(i8NTrenesRestanteTB>0){
                i8NTrenesRestanteTB--;
            }
            //i8NBurstTrenRestanteTB=i8NBurstTrenTB;
            i8ContTimer0=0;                         // Inicializo contador Timer 0
            
            set_timer0(gi16Timer0);                 // Set valor timer 0
        
            if(i8NTrenesRestanteTB>0){
                output_low(PULSO_2m_CHC);                               // Nivel bajo pulso 2 negativo canal C
                                               
                delay_us(DELAY_INT_SIG);                                // Peque�o delay para estabilizar la se�al
                
                TIMER1_ON=0;                                            // Apago timer pulsos 
                TIMER3_ON=0;                                            // Apago timer pulsos 
                set_timer1(gi16Timer1);                                 // Inicializo timer pulsos
                set_timer3(gi16Timer3);                                 // Inicializo timer pulsos
                i8ContTimer1=0;
                i16ContTimer3=0;
                TIMER1_ON=1;                                            // Inicializo timer pulsos
                TIMER3_ON=1;                                            // Inicializo timer pulsos
                
                
                output_high(PULSO_2p_CHC);                              // Activo pulso 2 positivo canal C
                delay_us(DELAY_PULSOS);                                 // Delay espera
                output_high(PULSO_1p_CHC);                              // Activo pulso 2 negativo canal C
                      
                TIMER8_ON=1;                                            // Habilito Timer 8
                
                delay_us(DELAY_ESPERA_MEDIDA_TENSION);                  // Delay espera medida tensi�n
                
                set_adc_channel(ADC_VP_CHC);                            // Selecci�n del canal medicion tension positiva canal C
                delay_us(DELAY_INT_SIG);                                // Delay set ADC
                i16VMedRaw_Cp=read_adc_chupi_piruli();                               // Leer valor de la tension de la carga positiva canal C
                
                delay_us(DELAY_ESPERA_MEDIDA_CORRIENTE);                // Delay espera medida corriente
                
                set_adc_channel(ADC_SHUNT_CHC);                         // Selecci�n del canal medicion corriente positiva canal C
                delay_us(DELAY_INT_SIG);                                // Delay set ADC
                i16IMedRaw_Cp=read_adc_chupi_piruli();                               // Leer valor del shunt
    
                bMedidaActualizada[CHC_C]=1;                            // Indico que hay una medida actualizada del canal C
            }else{
                TIMER0_ON=0;
                //fprintf(DEBUG_UART,"%d %d %d", i16NPulsosBurstRestanteTB,i8NBurstTrenRestanteTB,i8NTrenesRestanteTB);
                bDeboApagarTratamientoTB=1;
            }       
        }
    }    
}

