void CalculaYCargaValorTimer1(float FrecuenciACArgar){

    
    if(FrecuenciACArgar>31){                                             // Si la frecuencia ChB es mayor 31Hz no es necesario                        
            i8DivTimer1=0;
            i32Operacion=2000000/FrecuenciACArgar;                           // Hace operacion por separado para no desbordar
            gi16Timer1=65536-i32Operacion;                                 // Carga datos al timer
        }else{

            if(FrecuenciACArgar<=2){                                         // Frecuencia de 1Hz                                        
                i8DivTimer1=40;                                           // Numero de interacciones en el Timer1
                i32Operacion=2000000/(FrecuenciACArgar*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                                      
            }else if (FrecuenciACArgar<=4){                                         // Frecuencia entre 2 y 3Hz                                          
                i8DivTimer1=20;                                           // Numero de interacciones en el Timer1
                i32Operacion=2000000/(FrecuenciACArgar*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                                      
            }else if (FrecuenciACArgar<=8){                                    // Frecuencia entre 4 y 7Hz 
                i8DivTimer1=10;                                           // Numero de interacciones en el Timer1
                i32Operacion=2000000/(FrecuenciACArgar*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                  
            }else if (FrecuenciACArgar<=20){                                   // Frecuencia entre 8 y 20Hz 
                i8DivTimer1=5;                                            // Numero de interacciones en el Timer1
                i32Operacion=2000000/(FrecuenciACArgar*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                  
            }else if (FrecuenciACArgar<=31){                                   // Frecuencia entre 21 y 30Hz 
                i8DivTimer1=2;                                            // Numero de interacciones en el Timer1
                i32Operacion=2000000/(FrecuenciACArgar*i8DivTimer1);        // Calculo de la cuenta necesaria           
                gi16Timer1=65536-i32Operacion;                              // Valor a cargar en el Timer1                  
            } 
        }




    set_timer1((int16)gi16Timer1);
}

