 void CargaPWMActual()
 {


    if(i32PWMActual<1275)
    {          
        // gi16Timer4=i16PW_plusElec[CHB_C]*64/320-1;                         // Calculo del valor a cargar segun el PW en uSg offset=
        gi16Timer4=i32PWMActual*64/260;                         // Calculo del valor a cargar segun el PW en uSg offset=
        i8DivTimer4=0;
    }else
    {
        fDivTimer4=(float)i32PWMActual/1275;          // El número de veces que sobrecargamos el timer es igual a el PW dividido entre la cuenta máxima del timer

        if(fDivTimer4-(int8)fDivTimer4==0){
            i8DivTimer4=(int8)fDivTimer4;
        }else{
            i8DivTimer4=(int8)fDivTimer4+1;             // Lo redondeo en unidades hacia arriba, y lo asigno a una variable entera       
        }
        fCargaTimer4=fDivTimer4/i8DivTimer4;            // Calculo el porcentaje de carga entre el valor real y el valor redondeado
        gi16Timer4=255*fCargaTimer4;          // Calculo del valor a cargar segun el PW en uSg offset=40
        // i8DivTimer4=i8DivTimer4+i8DivTimer4*0.26;
        i8DivTimer4=i8DivTimer4+i8DivTimer4*0.30;
    }

    setup_timer_4(T4_DIV_BY_16,gi16Timer4,5);                         // Configuracion con 8 bits y resolucion de 5uSg
    TIMER4_ON=0;  
    i8ContTimer4=0;

    if(bPolaridadElec[CHB_C]==1)
    {                                           // Si es bipolar, activamos timer 6
                // Configuracion PW negativo ChB--> TMR6  
                // gi16Timer6=(i16PW_minusElec[CHB_C]*64/(320))-1;                        // Calculo del valor a cargar segun el PW en uSg offset=2 
                // setup_timer_6(T6_DIV_BY_16,gi16Timer6,5);                         // Configuracion con 8 bits y resolucion de 5uSg
                // TIMER6_ON=0;  

                // Configuracion PW negativo ChB--> TMR6  
                // Added 31/03/2022 Para un PW mayor de 1275uS, es necesario crear una variable que permite disparar los timers varias veces
                // La precisión del canal B es menor que la del canal A, ya que trabaja a 8 bits en lugar de 16 bits
                if(i32PWMActual<1275){          
                    gi16Timer6=i32PWMActual*64/260;                         // Calculo del valor a cargar segun el PW en uSg offset=
                    i8DivTimer6=0;
                }else{
                    fDivTimer6=(float)i32PWMActual/1275;          // El número de veces que sobrecargamos el timer es igual a el PW dividido entre la cuenta máxima del timer

                    if(fDivTimer6-(int8)fDivTimer6==0){
                        i8DivTimer6=(int8)fDivTimer6;
                    }else{
                        i8DivTimer6=(int8)fDivTimer6+1;             // Lo redondeo en unidades hacia arriba, y lo asigno a una variable entera       
                    }
                    fCargaTimer6=fDivTimer6/i8DivTimer6;            // Calculo el porcentaje de carga entre el valor real y el valor redondeado
                    gi16Timer6=255*fCargaTimer6;          // Calculo del valor a cargar segun el PW en uSg offset=40
                    i8DivTimer6=i8DivTimer6+i8DivTimer6*0.30;
                }
                setup_timer_6(T4_DIV_BY_16,gi16Timer6,5);                         // Configuracion con 8 bits y resolucion de 5uSg
                TIMER6_ON=0;  
                i8ContTimer6=0;
    }

        
 }
