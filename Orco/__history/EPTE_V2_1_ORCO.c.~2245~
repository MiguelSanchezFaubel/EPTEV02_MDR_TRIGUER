float calculoTension(int16 medida, int1 rang_V){     // C�lculo de la tensi�n a partir de la medida en crudo

    float fMedRaw;
    
    fMedRaw=medida*5.0/4096;

    if(rang_V==1){
        fMedRaw=fMedRaw*11;                       // Escalado, resultado en V, teniendo en cuenta el divisor 
    }
    
    return (fMedRaw);   
}

