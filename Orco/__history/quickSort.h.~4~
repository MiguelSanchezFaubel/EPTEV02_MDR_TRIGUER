
// A utility function to swap two elements 
void swap(int16* a, int16* b){ 
    int16 t = *a; 
    *a = *b; 
    *b = t; 
} 

/* This function is same in both iterative and recursive*/
int8 partition(int16 *arr, int8 l, int8 h){ 
    int16 x = arr[h]; 
    int16 i = (l - 1); 

    for (int8 j = l; j <= h - 1; j++) { 
        if (arr[j] <= x) { 
            i++; 
            swap(&arr[i], &arr[j]); 
        } 
    } 
    swap(&arr[i + 1], &arr[h]);

    return (i + 1); 
} 
