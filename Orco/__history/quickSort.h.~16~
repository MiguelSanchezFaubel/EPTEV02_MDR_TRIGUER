
void Array_sort(int16 *array , int16 n){ 
    // declare some local variables
    int16 i=0 , j=0 , temp=0;

    for(i=0 ; i<n ; i++){
        for(j=0 ; j<n-1 ; j++){
            if(array[j]>array[j+1]){
                temp        = array[j];
                array[j]    = array[j+1];
                array[j+1]  = temp;
            }
        }
    }
}
