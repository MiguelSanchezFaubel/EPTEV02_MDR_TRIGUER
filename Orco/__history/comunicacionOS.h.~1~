// enum eERRORES: Indica el tipo de error que hay en ese momento
enum eERRORES{				
	NO_ERROR=0,				// 0: Sin error
	ERROR_ELECTRODO,		// 1: Error de electrodo
	ERROR_SIMETRIA,			// 2: Error de simetría
