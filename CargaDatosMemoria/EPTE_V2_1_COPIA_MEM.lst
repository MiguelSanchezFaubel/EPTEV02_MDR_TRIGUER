....................  
.................... void M25AA1024_init(){ 
....................     // Se sigue el procedimiento de incio indicado en el datasheet 
....................     output_low(CS_MEM);             // Habilito memoria 
*
02B9A:  MOVLW  20
02B9C:  MOVWF  F95
02B9E:  BCF    F8C.7
....................     output_high(HOLD_MEM);          // Permito escritura 
02BA0:  MOVWF  F95
02BA2:  BSF    F8C.3
....................     output_high(CS_MEM);            // Deshabilito memoria 
02BA4:  MOVWF  F95
02BA6:  BSF    F8C.7
02BA8:  GOTO   49F2 (RETURN)
.................... } 
....................  
.................... void M25AA1024_sendAddress(int32 i32Address){               
....................     spi_write2((i32Address>>16)&0xFF);          // Se desplaza hacia la derecha 16 bits los 8 bits más significativos de la dirección 
*
030EE:  MOVFF  EE,F1
030F2:  CLRF   xF3
030F4:  CLRF   xF4
030F6:  CLRF   xF2
030F8:  CLRF   xF3
030FA:  CLRF   xF4
030FC:  MOVF   F6A,W
030FE:  MOVFF  EE,F6A
03102:  RRCF   F68,W
03104:  BNC   3102
....................                                                 // de memoria de 24 bits (MSB) 
....................     spi_write2((i32Address>>8)&0xFF);           // Mismo procedimiento pero desplazando solo 8 bits (MidSB) 
03106:  MOVFF  ED,F1
0310A:  CLRF   xF4
0310C:  CLRF   xF2
0310E:  CLRF   xF3
03110:  CLRF   xF4
03112:  MOVF   F6A,W
03114:  MOVFF  ED,F6A
03118:  RRCF   F68,W
0311A:  BNC   3118
....................     spi_write2((i32Address)&0xFF);              // (LSB) 
0311C:  MOVFF  EC,F0
03120:  CLRF   xF1
03122:  CLRF   xF2
03124:  CLRF   xF3
03126:  MOVF   F6A,W
03128:  MOVFF  EC,F6A
0312C:  RRCF   F68,W
0312E:  BNC   312C
03130:  RETURN 0
.................... } 
....................  
.................... int8 M25AA1024_read(int32 i32Address){ 
....................    int8 i8Data;                          // Variable para guardar el dato leido 
....................     
....................    // Configuro SPI para funcionar en el modo correcto 
....................    SSP2CON1=0xA2;                       // Input data is sampled at the middle of data output time           
03132:  MOVLW  A2
03134:  MOVWF  F67
....................    SSP2STAT|=0x40;                      // Transmit occurs on the transition from active to Idle clock state 
03136:  BSF    F68.6
....................                                          
....................    output_low(CS_MEM);                  // Activa la memoria 
03138:  MOVLW  20
0313A:  MOVWF  F95
0313C:  BCF    F8C.7
....................    spi_write2(READ);                    // Envía comando de lectura 
0313E:  MOVF   F6A,W
03140:  MOVLW  03
03142:  MOVWF  F6A
03144:  RRCF   F68,W
03146:  BNC   3144
....................    M25AA1024_sendAddress(i32Address);   // Envía dirección de memoria a leer 
03148:  MOVFF  EA,EF
0314C:  MOVFF  E9,EE
03150:  MOVFF  E8,ED
03154:  MOVFF  E7,EC
03158:  RCALL  30EE
....................    i8Data=spi_read2(0);                 // Lee el dato 
0315A:  MOVF   F6A,W
0315C:  CLRF   F6A
0315E:  RRCF   F68,W
03160:  BNC   315E
03162:  MOVFF  F6A,EB
....................    output_high(CS_MEM);                 // Desactiva la memoria 
03166:  MOVLW  20
03168:  MOVWF  F95
0316A:  BSF    F8C.7
....................     
....................    return i8Data;                       // Retorna el dato leido 
0316C:  MOVFF  EB,01
03170:  GOTO   31DA (RETURN)
.................... } 
....................  
.................... void M25AA1024_write(int32 i32Address,int8 i8Data){ 
....................    // Configuro SPI para funcionar en el modo correcto 
....................    SSP2CON1=0xA2;                       // Input data is sampled at the middle of data output time           
03174:  MOVLW  A2
03176:  MOVWF  F67
....................    SSP2STAT|=0x40;                      // Transmit occurs on the transition from active to Idle clock state 
03178:  BSF    F68.6
....................     
....................    do{ 
....................        output_low(CS_MEM);                  // Activa la memoria 
0317A:  MOVLW  20
0317C:  MOVWF  F95
0317E:  BCF    F8C.7
....................        spi_write2(WREN);                    // Habilita escritura 
03180:  MOVF   F6A,W
03182:  MOVLW  06
03184:  MOVWF  F6A
03186:  RRCF   F68,W
03188:  BNC   3186
....................        output_high(CS_MEM);                 // Desactiva la memoria        
0318A:  MOVLW  20
0318C:  MOVWF  F95
0318E:  BSF    F8C.7
....................        output_low(CS_MEM);                  // Activa la memoria 
03190:  MOVWF  F95
03192:  BCF    F8C.7
....................        spi_write2(WRITE);                   // Envia comando de escritura 
03194:  MOVF   F6A,W
03196:  MOVLW  02
03198:  MOVWF  F6A
0319A:  RRCF   F68,W
0319C:  BNC   319A
....................        M25AA1024_sendAddress(i32Address);   // Envia dirección de memoria a escribir 
0319E:  MOVFF  E5,EF
031A2:  MOVFF  E4,EE
031A6:  MOVFF  E3,ED
031AA:  MOVFF  E2,EC
031AE:  RCALL  30EE
....................        spi_write2(i8Data);                  // Escribe el dato 
031B0:  MOVF   F6A,W
031B2:  MOVFF  E6,F6A
031B6:  RRCF   F68,W
031B8:  BNC   31B6
....................        output_high(CS_MEM);                 // Desactiva la memoria 
031BA:  MOVLW  20
031BC:  MOVWF  F95
031BE:  BSF    F8C.7
....................        #ifdef SAURON 
....................        delay_ms_wdt(8); 
....................        restart_wdt_hw(); 
....................        #else 
....................        delay_ms(8); 
031C0:  MOVLW  08
031C2:  MOVWF  xE8
031C4:  CALL   2676
....................        #endif 
....................    }while(M25AA1024_read(i32Address)!=i8Data); 
031C8:  MOVFF  E5,EA
031CC:  MOVFF  E4,E9
031D0:  MOVFF  E3,E8
031D4:  MOVFF  E2,E7
031D8:  BRA    3132
031DA:  MOVF   xE6,W
031DC:  SUBWF  01,W
031DE:  BNZ   317A
031E0:  RETURN 0
.................... } 
....................  
.................... int8 M25AA1024_status(){ 
....................    int8 i8Result;                       // Variable auxiliar donde se guarda el resultado de la memoria 
....................     
....................    output_low(CS_MEM);                  // Activa la memoria 
....................    i8Result=spi_read2(RDSR);            // Lee estado 
....................    output_high(CS_MEM);                 // Desactiva la memoria 
....................         
....................    return i8Result;                     // Devuelvo el estado de la memoria 
.................... } 
....................  
.................... int32 lecturaDirFAT(int32 i32FAT){ 
....................      
....................     int32 i32Direcc; 
....................     int8 i8MSB, i8MedSB, i8LSB; 
....................  
....................     i8MSB=M25AA1024_read(i32FAT); 
....................     i8MedSB=M25AA1024_read(i32FAT+1); 
....................     i8LSB=M25AA1024_read(i32FAT+2); 
....................  
....................     i32Direcc=make32(i8MSB,i8MedSB,i8LSB); 
....................  
....................     return i32Direcc; 
.................... } 
