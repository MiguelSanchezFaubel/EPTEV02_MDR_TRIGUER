.................... #define EEPROM_ELECTRO_TIEMPO_DESCANSO              EEPROM_ELECTRO_TIEMPO_ACTIVO + OFFSET_INT16         // Direcci�n Memoria Electroestimulaci�n - Tiempo Descanso - 16 bits 
