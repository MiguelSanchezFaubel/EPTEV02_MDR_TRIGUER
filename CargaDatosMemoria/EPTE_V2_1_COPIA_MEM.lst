.................... #define EEPROM_LOC_ILUMINACION              0x3ED       // Iluminaci�n es de 1 byte 
.................... #define EEPROM_LOC_CONTRASTE                0x3EE       // Contraste es de 1 byte     
.................... #define EEPROM_LOC_SONIDO                   0x3EF       // Sonido es de 2 bytes               
