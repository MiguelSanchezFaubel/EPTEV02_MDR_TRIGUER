....................  
.................... #include "fat.c" 
.................... // Se guardan dos bytes para la dirección 
.................... // La FAT_XXX contiene la direccion de memoria donde se encuentra la dirección de los datos 
.................... // Es mas que nada por tener un orden en texto i no en numericos 
....................  
.................... // Idiomas 
.................... #define NUM_IDIOMAS 2 
.................... #define SPANISH 0 
.................... #define ENGLISH 1 
....................  
.................... #define TAM_DIR_BYTES       3    
....................  
.................... #define MAX_LINEAS          350         // Permito ubn m�ximo de 300 l�neas de texto (hay aprox 250) 
.................... #define OFFSET_DIR_SPANISH  0           // offset spanish 
.................... #define OFFSET_DIR_ENGLISH  TAM_DIR_BYTES*MAX_LINEAS  //      
....................  
.................... #define OFFSET_FAT           TAM_DIR_BYTES*MAX_LINEAS 
....................  
.................... #define NUM_TOTAL_TEXTOS 261-1 // Actualizar manualmente 
....................  
.................... int32 i32OffsetDireccionIdioma=OFFSET_DIR_SPANISH; 
....................  
.................... // Direcciones 
....................  
.................... #define FAT_S                           0 
.................... #define FAT_M                           FAT_S+TAM_DIR_BYTES 
.................... #define FAT_L                           FAT_M+TAM_DIR_BYTES 
.................... #define FAT_XL                          FAT_L+TAM_DIR_BYTES 
.................... #define FAT_ICON                        FAT_XL+TAM_DIR_BYTES 
.................... #define FAT_IMAGEN                      FAT_ICON+TAM_DIR_BYTES 
.................... // Si se a�aden im�genes o algo m�s que no sea texto, debe ser de aqui hacia arriba 
.................... // OJO: SI se �adaden cosas, cambiar �ndice de FAT_Co_ELECTRICA 
.................... #define PRIMERA_POS_FAT                 TAM_DIR_BYTES+FAT_IMAGEN 
....................  
.................... #define FAT_FUENTES                     PRIMERA_POS_FAT 
....................  
.................... #define TAM_FAT_TOTAL                   TAM_DIR_BYTES*MAX_LINEAS*NUM_IDIOMAS+OFFSET_FAT+FAT_FUENTES 
