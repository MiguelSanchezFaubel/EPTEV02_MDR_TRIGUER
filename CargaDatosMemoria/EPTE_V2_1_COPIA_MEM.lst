.................... #define OSCOFF  0xd2 
.................... #define PWRCTRL 0x20 
.................... #define VOLCTRL 0x81 
.................... #define VOLUP   0xd6 
.................... #define VOLDOWN 0xd7 
.................... #define EPSRRD1 0x7c 
.................... #define EPSRRD2 0x7d 
.................... #define NOP     0x25 
.................... #define EPINT   0x07 
