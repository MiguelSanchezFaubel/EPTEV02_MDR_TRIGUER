.................... #define EEPROM_TB_POLARIDAD                         0                                                   // Direccion Memoria TB - Polaridad                 - 8 bits 
.................... #define EEPROM_TB_ANCHO_PULSO                       EEPROM_TB_POLARIDAD + OFFSET_INT8                   // Direccion Memoria TB - Ancho de pulso            - 16 bits 
