int8 enviaComando(int8 i8Mode){

   int8 i8Return;

   switch (i8Mode){
      case CHECK_ALIVE:               // Comprueba si la comunicaci贸n entre PICs sigue viva
         i8Return=enviaCheckAlive();      
         break;
      case START:                     // Comando START
         i8Return=enviaStart();         // Envia el comando START para empezar el tratamiento
         break;
      case STOP:                     // Comando STOP
         i8Return=enviaStop();         // Envia el comando STOP para parar el tratamiento
         break;         
      case CONFIG_TRAT:               // Configuraci贸n del tratamiento
         putc(COMANDO_CONFIG_TRAT);      // Envia que se va a configurar un tratamiento
         i8Return=getc();            // TODO: Secuencia de tratamiento 
         break;
      case CONFIG_TRAT_ACT:            // Configuraci贸n el tratamiento en activo
         putc(COMANDO_CONFIG_TRAT_ACT);   // Env韆 que se va a configurar un tratamiento en activo
         i8Return=getc();            // TODO: Secuencia de tratamiento en activo
         break;
      default:                     // En caso de que se introduzca un valor no permitido
         i8Return=ERROR_DESCONOCIDO;      // Devuelvo el valor de ERROR_DESCONOCIDO
   }

   return i8Return;
}

int8 enviaConfiguracionCanal(   int8 i8Canal, int16 i16TiempoActivo, int8 i8TiempoReposo, int8 i8TiempoRampa, 
                        int8 i8Repeticiones, int16 i16Corriente, int16 i16Frecuencia, int1 bSimetria, 
                        int1 bPolaridad, int16 i16PWP, int16 i16PWN, int1 bSimetriaCanales){

   int8 i8Return;
   int16 i16Envio;            // Variable utilizada para juntar los bytes sin que de problemas de desbordamiento
                        // No tendr韆 que darlos, pero por si acaso
   #ifdef CHECKSUM
   gi8CheckSum=0;
   #endif
   // Envia primer paquete (8bits) (Simetr韆 entre canales | Simetr韆 | Polaridad | Canal)
   i16Envio=(bSimetriaCanales<<MASK_SIMETRIA_CANALES) | (bSimetria<<MASK_SIMETRIA)   |
            (bPolaridad<<MASK_POLARIDAD) | i8Canal;

   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // Env韆 el segundo paquete (16 bits) (TiempoActivo)
   // MSB
   i16Envio=(i16TiempoActivo & MSB) >> 8;
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // LSB
   i16Envio=(i16TiempoActivo & LSB);
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // Env韆 el tercer paquete (8 bits) (TiempoReposo)
   i16Envio=i8TiempoReposo;
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // Env韆 el cuarto paquete (8 bits) (TiempoRampa)
   i16Envio=i8TiempoRampa;
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // Env韆 el quinto paquete (8 bits) (Repeticiones)
   i16Envio=i8Repeticiones;
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // Env韆 el sexto paquete (16 bits) (Corriente)
   // MSB
   i16Envio=(i16Corriente & MSB) >> 8;
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // LSB
   i16Envio=(i16Corriente & LSB);
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // Env韆 el s茅ptimo paquete (16 bits) (Frecuencia)
   // MSB
   i16Envio=(i16Frecuencia & MSB) >> 8;
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // LSB
   i16Envio=(i16Frecuencia & LSB);
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // Env韆 el octavo paquete (16 bits) (PW+)
   // MSB
   i16Envio=(i16PWP & MSB) >> 8;
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // LSB
   i16Envio=(i16PWP & LSB);
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // Env韆 el noveno paquete (16 bits) (PW-)
   // MSB
   i16Envio=(i16PWN & MSB) >> 8;
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);
   #endif

   // LSB
   i16Envio=(i16PWN & LSB);
   putc(i16Envio);

   #ifdef CHECKSUM
   gi8CheckSum+=(i16Envio & LSB);   // Hago la suma de los valores
   gi8CheckSum=calculaChecksum();   // Calcula el checksum con los valores recibidos
   putc(gi8CheckSum);            // ENvio el checksum
   #endif

   // TODO: Debe recibir ACK al final o cada vez que se env韊 un dato???
   // Espera recepci贸n del ACK - TODO: Timeout?
   i8Return=getc();

   #ifdef CHECKSUM
   if(COMANDO_CHECKSUM == i8Return){         // Si el cheksum es correcto
      i8Return=NO_ERROR;                  // Devuelve NO_ERROR
   }else{                              // Si no fuera correcto
   #endif

      if(COMANDO_ACK == i8Return){         // Si la respuesta coincide con el comando      
         i8Return=NO_ERROR;               // Devuelve NO_ERROR
      }else{                           // Si no existe respuesta o es erronea      
         i8Return=ERROR_NOACK;            // Devuelve ERROR_NOACK   
      }

   #ifdef CHECKSUM
   }
   #endif

   return i8Return;
}

