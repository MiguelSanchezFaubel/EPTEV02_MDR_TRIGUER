        case CANALES_A:            // Canal A
            apagadoCHA();
            break;
        case CANALES_B:            // Canal B
            apagadoCHB();
            break;
        case CANALES_C:            // Canal C
            apagadoCHC();
            break;
        case CANALES_AB:            // Canal A y B
            apagadoCHA();
            apagadoCHB();
            break;
        case CANALES_BC:            // Canal B y C
            apagadoCHB();
            apagadoCHC();
            break;
        case CANALES_AC:            // Canal A y C
            apagadoCHA();
            apagadoCHC();
            break;
        case CANALES_ABC:            // Canal A, B y C
            apagadoCHA();
            apagadoCHB();
            apagadoCHC();
            break;   
        case CANALES_P:            // Canal P
            apagadoCHA();
            break;
        case CANALES_BP:            // Canal B y C
            apagadoCHB();
            apagadoCHA();
            break;
        case CANALES_CP:            // Canal A y C
            apagadoCHA();
            apagadoCHC();
            break;
        case CANALES_BCP:            // Canal A, B y C
            apagadoCHA();
            apagadoCHB();
            apagadoCHC();
            break;   
    }
    i8CanalesActivados=0;
    i8ReposoActivados=0;
}

void relesReposo(int1 bSelec){

