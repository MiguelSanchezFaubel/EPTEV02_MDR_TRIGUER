void copiarDatosSimetria(int1 bTiempo){
//!    bTiempo
//!        1 - Copia los valores de tiempo
//!        0 - No copia los valores de tiempo
    switch(i8SimetriaCanales){
        case 1:             // Canales AB
            if(bTiempo){
                i16TacElec[CHB_C]=i16TacElec[CHA_C];
                i16TdElec[CHB_C]=i16TdElec[CHA_C];
                i8TrElec[CHB_C]=i8TrElec[CHA_C];
                i8Nrep[CHB_C]=i8Nrep[CHA_C];
            }
            
            i16FrecElec[CHB_C]=i16FrecElec[CHA_C];

            bSimetriaElec[CHB_C]=bSimetriaElec[CHA_C];
            bPolaridadElec[CHB_C]=bPolaridadElec[CHA_C]; 
            i16PW_plusElec[CHB_C]=i16PW_plusElec[CHA_C]; 
            i16PW_minusElec[CHB_C]=i16PW_minusElec[CHA_C];
            break;
        case 2:             // Canales ABC
            if(bTiempo){
                i16TacElec[CHC_C]=i16TacElec[CHB_C]=i16TacElec[CHA_C];
                i16TdElec[CHC_C]=i16TdElec[CHB_C]=i16TdElec[CHA_C];
                i8TrElec[CHC_C]=i8TrElec[CHB_C]=i8TrElec[CHA_C];
                i8Nrep[CHC_C]=i8Nrep[CHB_C]=i8Nrep[CHA_C];
            }
            
            i16FrecElec[CHC_C]=i16FrecElec[CHB_C]=i16FrecElec[CHA_C];
            
            bSimetriaElec[CHC_C]=bSimetriaElec[CHB_C]=bSimetriaElec[CHA_C];
            bPolaridadElec[CHC_C]=bPolaridadElec[CHB_C]=bPolaridadElec[CHA_C]; 
            i16PW_plusElec[CHC_C]=i16PW_plusElec[CHB_C]=i16PW_plusElec[CHA_C]; 
            i16PW_minusElec[CHC_C]=i16PW_minusElec[CHB_C]=i16PW_minusElec[CHA_C];
            break;
    }

}

void comprobacionLimitesFrecuencia(){
    
    switch(i8CanalesConfigurados){
        case 0:     // Si no hay nada configurado, inicializo los límites
            i16FrecLimSup[CHA_C]=1000;
            i16FrecLimInf[CHA_C]=2;   
            i16FrecLimSup[CHB_C]=1000;
            i16FrecLimInf[CHB_C]=2;   
            i16FrecLimSup[CHC_C]=1000;
            i16FrecLimInf[CHC_C]=2;   
            i16FrecLimSup[POINTER_C]=150;
            i16FrecLimInf[POINTER_C]=2;  
            break;
        case CHA_ACT:           //  Si está el CHA configurado, ponemos límites B y C
            i16FrecLimSup[CHB_C]=1000;
            i16FrecLimInf[CHB_C]=i16FrecElec[CHA_C];   
            i16FrecLimSup[CHC_C]=1000;
            i16FrecLimInf[CHC_C]=i16FrecElec[CHA_C];
            break;
        case CHB_ACT:           //  Si está el CHB configurado, ponemos límites A y C
            i16FrecLimSup[CHA_C]=i16FrecElec[CHB_C];
            i16FrecLimInf[CHA_C]=2;  
            i16FrecLimSup[CHC_C]=1000;
            i16FrecLimInf[CHC_C]=i16FrecElec[CHB_C];
            i16FrecLimSup[POINTER_C]=i16FrecLimSup[CHA_C];
            if(i16FrecLimSup[POINTER_C]>=150){
                i16FrecLimSup[POINTER_C]=150;
            }
            i16FrecLimInf[POINTER_C]=2;  
            break;
        case CHC_ACT:           //  Si está el CHC configurado, ponemos límites A y B
            i16FrecLimSup[CHA_C]=i16FrecElec[CHC_C];
            i16FrecLimInf[CHA_C]=2;
            i16FrecLimSup[CHB_C]=i16FrecElec[CHC_C]; ;
            i16FrecLimInf[CHB_C]=2;
            i16FrecLimSup[POINTER_C]=i16FrecLimSup[CHA_C];
            if(i16FrecLimSup[POINTER_C]>=150){
                i16FrecLimSup[POINTER_C]=150;
            }
            i16FrecLimInf[POINTER_C]=2; 
            break;
        case POINTER_ACT:       //  Si está el POINTER configurado, ponemos límites B y C
            i16FrecLimSup[CHB_C]=1000;
            i16FrecLimInf[CHB_C]=i16FrecElec[POINTER_C];   
            i16FrecLimSup[CHC_C]=1000;
            i16FrecLimInf[CHC_C]=i16FrecElec[POINTER_C];
            break;
        case CHA_ACT | CHB_ACT: //  Si está el CHA y CHB configurado, ponemos límites C
            i16FrecLimSup[CHC_C]=1000;
            i16FrecLimInf[CHC_C]=i16FrecElec[CHB_C];
            break;
        case CHB_ACT | CHC_ACT: //  Si está el CHB y CHC configurado, ponemos límites A
            i16FrecLimSup[CHA_C]=i16FrecElec[CHB_C];
            i16FrecLimInf[CHA_C]=2;
            i16FrecLimSup[POINTER_C]=i16FrecLimSup[CHA_C];
            if(i16FrecLimSup[POINTER_C]>=150){
                i16FrecLimSup[POINTER_C]=150;
            }
            i16FrecLimInf[POINTER_C]=2; 
            break;
        case CHA_ACT | CHC_ACT: //  Si está el CHA y CHC configurado, ponemos límites B
            i16FrecLimSup[CHB_C]=i16FrecElec[CHC_C];
            i16FrecLimInf[CHB_C]=i16FrecElec[CHA_C];
            break;
        case POINTER_ACT | CHB_ACT: //  Si está el POINTER y CHB configurado, ponemos límites C
            i16FrecLimSup[CHC_C]=1000;
            i16FrecLimInf[CHC_C]=i16FrecElec[CHB_C];
            break;
        case POINTER_ACT | CHC_ACT: //  Si está el POINTER y CHC configurado, ponemos límites B
            i16FrecLimSup[CHB_C]=i16FrecElec[CHC_C];
            i16FrecLimInf[CHB_C]=i16FrecElec[POINTER_C];
            break;
        default:
            // No hagas nada
    }
    
    for(int8 i8Cont=0; i8Cont<4; i8Cont++){
        if(i16FrecElec[i8Cont]>=i16FrecLimSup[i8Cont]){
            i16FrecElec[i8Cont]=i16FrecLimSup[i8Cont];
        }else if(i16FrecElec[i8Cont]<=i16FrecLimInf[i8Cont]){
            i16FrecElec[i8Cont]=i16FrecLimInf[i8Cont];
        }
    }
}

