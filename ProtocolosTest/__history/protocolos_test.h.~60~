int8 obtencionProtocoloSeleccionado(){
    int8 i8ReturnProtocolo=0;
    
    i8ReturnProtocolo=(10*(i8BufferEntradaTest[POSICION_DATO_PROTO]-'0'));
    i8ReturnProtocolo+=(i8BufferEntradaTest[POSICION_DATO_PROTO+1]-'0');
    
    return i8ReturnProtocolo;
}

int8 obtencionPasoSeleccionado(){
    int8 i8ReturnPaso=0;
    
    i8ReturnPaso=(10*(i8BufferEntradaTest[POSICION_DATO_PASO]-'0'));
    i8ReturnPaso+=(i8BufferEntradaTest[POSICION_DATO_PASO+1]-'0');
    
    return i8ReturnPaso;
}

int8 obtencionRamaSeleccionada(){
    int8 i8ReturnRama=0;
    
    i8ReturnRama=(i8BufferEntradaTest[POSICION_DATO_RAMA]-'0');
    
    return i8ReturnRama;
}

int16 obtencionDutySeleccionado(){
    int16 i16ReturnDuty=0;                                                  // Variable de retorno del duty
    
    i16ReturnDuty=1000*(i8BufferEntradaTest[POSICION_DATO_DUTY]-'0');       // Cambio de ASCII a decimal
    i16ReturnDuty+=(100*(i8BufferEntradaTest[POSICION_DATO_DUTY+1]-'0'));   // Cambio de ASCII a decimal
    i16ReturnDuty+=(10*(i8BufferEntradaTest[POSICION_DATO_DUTY+2]-'0'));    // Cambio de ASCII a decimal
    i16ReturnDuty+=(i8BufferEntradaTest[POSICION_DATO_DUTY+3]-'0');         // Cambio de ASCII a decimal
    
    return i16ReturnDuty;                                                   // Devuelvo el duty
}

