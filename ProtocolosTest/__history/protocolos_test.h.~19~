// ---------------------------- Definiciones ----------------------------
#define PACKET_SAURON       0       // Define que el paquete de test es para Sauron
#define PACKET_ORCO         1       // Define que el paquete de test es para Orco

// Protocolos
#define PROTOCOLO_CANAL_A   0       // Asigna el valor del protocolo del canal A
#define PROTOCOLO_CANAL_B   1       // Asigna el valor del protocolo del canal B
#define PROTOCOLO_CANAL_C   2       // Asigna el valor del protocolo del canal C
#define PROTOCOLO_xxxxx     3       // Asigna el valor del protocolo a xxxxx

// Pasos
#define PASO_1              1       // Asigna el valor del paso 1
#define PASO_2              2       // Asigna el valor del paso 2
#define PASO_3              3       // Asigna el valor del paso 3
#define PASO_4              4       // Asigna el valor del paso 4
#define PASO_5              5       // Asigna el valor del paso 5

// Ramas
#define RAMA_POSITIVA       0       // Asigna el valor del test de rama positiva
#define RAMA_NEGATIVA       1       // Asigna el valor del test de rama negativa

#define BUFFER_TEST_LENGTH  30      // Define el tamaño del buffer de entrada para el test

#define POSICION_DATO_CANAL 6       // Asigna la posición del dato del canal
#define POSICION_DATO_PASO  8       // Asigna la posición del dato del paso
#define POSICION_DATO_RAMA  10      // Asigna la posición del dato de la rama
#define POSICION_DATO_DUTY  12      // Asigna la posición del dato del duty

// ---------------------------- Prototipo de funciones ----------------------------
int8 lecturaPaqueteTest();

// ---------------------------- Variables Globales ----------------------------
char i8BufferEntradaTest[BUFFER_TEST_LENGTH];   // Define el buffer de entrada de datos del test
char i8BufferCopiaTest[BUFFER_TEST_LENGTH];     // Define el buffer de entrada de datos del test
int8 i8BufferIndexTest=0;                       // Determina la longitud del paquete recibido
int8 i8DatoRecibidoTest=0;                      // Dato recibido en el buffer 
int1 bCasiRecibidoTest=0;                       // Flag que indica que casi se ha recibido el fin de trama, dependerá del siguiente dato recibido
int1 bDatoRecibidoTest=0;                       // Flag que indica que se ha recibido el paquete correctamente
int1 bModoTestActivado=0;                       // 
int8 i8ProtocoloSeleccionado=0;
int8 i8PasoSeleccionado=0;
int8 i8RamaSeleccionada=0;
int8 i16DutySeleccionado=0;

// ---------------------------- Códigos ----------------------------
int8 i8LengthHeader=6;                          // La cabezera se compone de 6 caracteres
const char START_TEST[] =   "$ST_TS";           // Cabezera START TEST
const char STOP_TEST[] =    "$SP_TS";           // Cabezera STOP TEST
const char PROTO_TEST[] =   "$PROTO";           // Cabezera PROTO - Usar con sprintf y enviar string resultante

// ---------------------------- Código para Sauron ----------------------------
#ifdef SAURON
int8 lecturaPaqueteTest(){
    
    int8 i8Return=0;
    
    if(strncmp(START_TEST,i8BufferEntradaTest,i8LengthHeader)==0){          // Si recibimos el comando de conexión
        fprintf(DEBUG_UART,"Modo test EPTE 2 habilitado\r\n");              // Muestro mensaje de conexión por UART
        bModoTestActivado=1;                                                // Activo el modo de test
        ST7529_clear();                                                     // Limpia la pantaalla
        ST7529_printf("MODO",30,40,L_,NORMAL);                              // Muestra por pantalla el indicativo de que se encuentra en modo test
        ST7529_printf("TEST",30,60,L_,NORMAL);
    }else if(strncmp(STOP_TEST,i8BufferEntradaTest,i8LengthHeader)==0){     // Si recibimos el comando de desconexión
        fprintf(DEBUG_UART,"Modo test EPTE 2 deshabilitado\r\n");           // Muestro mensaje de desconexión por UART
        bModoTestActivado=0;                                                // Desactivo el modo de test
        bAlMenuPrincipal=1;                                                 // Indico que vaya al menú principal
    }else if(strncmp(PROTO_TEST,i8BufferEntradaTest,i8LengthHeader)==0){    // Si recibimos el comando de un protocolo a testear
        if(bModotestActivado){                                              // Si estamos en modo test
            i8ProtocoloSeleccionado=i8BufferEntradaTest[POSICION_DATO_CANAL]-'0';           // Cambio de ASCII a decimal
            switch(i8ProtocoloSeleccionado){                                                // Dependiendo del número del protocolo
                case PROTOCOLO_CANAL_A:                                                     // Canal A
                case PROTOCOLO_CANAL_B:                                                     // Canal B
                case PROTOCOLO_CANAL_C:                                                     // Canal C
                    fprintf(DEBUG_UART,"Protocolo Canal %u\r\n",i8ProtocoloSeleccionado);   // Muestra mensaje del protocolo a ejecutar
                    
                    i8PasoSeleccionado=i8BufferEntradaTest[POSICION_DATO_PASO]-'0';         // Cambio de ASCII a decimal
                    i8RamaSeleccionada=i8BufferEntradaTest[POSICION_DATO_RAMA]-'0';         // Cambio de ASCII a decimal
                    if(RAMA_POSITIVA==i8RamaSeleccionada){                                  // Si vamos a comprobar la rama positiva
                        switch(i8PasoSeleccionado){                                             // Dependiendo del paso seleccionado
                            case PASO_1:                                                        // Paso 1 -                                   
                        
                                break;
                            case PASO_2:                                                        // Paso 2 - 
                        
                                break;
                            case PASO_3:                                                        // Paso 3 - 
                        
                                break;
                            case PASO_4:                                                        // Paso 4 - 
                        
                                break;
                            case PASO_5:                                                        // Paso 5 - 
                        
                                break;    
                        }
                    }else if(RAMA_NEGATIVA==i8RamaSeleccionada){                            // S vamos a comprobar la rama negativa
                        switch(i8PasoSeleccionado){                                             // Dependiendo del paso seleccionado
                            case PASO_1:                                                        // Paso 1 -                                                        
                        
                                break;
                            case PASO_2:                                                        // Paso 2 - 
                        
                                break;
                            case PASO_3:                                                        // Paso 3 - 
                        
                                break;
                            case PASO_4:                                                        // Paso 4 - 
                        
                                break;
                            case PASO_5:                                                        // Paso 5 - 
                        
                                break;    
                        }
                    }
                    break;
                case '3':
                    break;
                case '4':
                    break;
                case '5':
                    break;
                case '6':
                    break;
            }
        }else{                                                              // ...si el modo test no se encuentra habilitado
            fprintf(DEBUG_UART,"ERROR: Modo test deshabilitado\r\n");       // Informamos del error al operario
        }
    }else{                                                                  // Si recibimos un comando desconocido
        fprintf(DEBUG_UART,"ERROR: Comando desconocido\r\n");               // Informamos del error al operario
    }
    
    return i8Return;
}


#endif

